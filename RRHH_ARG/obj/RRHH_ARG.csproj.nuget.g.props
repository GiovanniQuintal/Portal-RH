    <Content Include="$(NuGetPackageRoot)blazorfluentui.corecomponents\8.0.0\contentFiles\any\net8.0\Icon\FluentSystemIcons-Regular.json" Condition="Exists('$(NuGetPackageRoot)blazorfluentui.corecomponents\8.0.0\contentFiles\any\net8.0\Icon\FluentSystemIcons-Regular.json')">
      <NuGetPackageId>BlazorFluentUI.CoreComponents</NuGetPackageId>
      <NuGetPackageVersion>8.0.0</NuGetPackageVersion>
      <NuGetItemType>Content</NuGetItemType>
      <Pack>false</Pack>
      <Private>False</Private>
      <Link>Icon\FluentSystemIcons-Regular.json</Link>
    </Content>
  </ItemGroup>
