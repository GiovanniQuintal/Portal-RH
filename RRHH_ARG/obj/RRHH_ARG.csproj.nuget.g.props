    <Import Project="$(NuGetPackageRoot)blazorfluentui.listcomponents\8.0.0\buildTransitive\BlazorFluentUI.ListComponents.props" Condition="Exists('$(NuGetPackageRoot)blazorfluentui.listcomponents\8.0.0\buildTransitive\BlazorFluentUI.ListComponents.props')" />
