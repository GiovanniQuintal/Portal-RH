<form action="Account/Logout" method="post" id="logoutForm" style="display:none">
    <AntiforgeryToken />
    <input type="hidden" name="returnUrl" value="Account/Login" />
</form>

<script>
    function submitLogoutForm() {
        document.getElementById('logoutForm').submit();
    }
</script>

@if (mostrarModal)
{
    <div class="modal-backdrop fade show" style="z-index: 9999;"></div>

    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true" style="z-index: 9999;">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content text-dark">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmar Salida</h5>
                    <button type="button" class="btn-close" @onclick="CerrarModal"></button>
                </div>
                <div class="modal-body">
                    <p>¿Estás seguro que deseas cerrar sesión?</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CerrarModal">Cancelar</button>
                    <button type="button" class="btn btn-danger" @onclick="EjecutarSalidaReal">Sí, Salir</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool collapseNavMenu = true;
    private string? NavMenuCssClass => collapseNavMenu ? "nav-slider" : "nav-slider responsive-open";
    private void ToggleNavMenu() => collapseNavMenu = !collapseNavMenu;
    private string? currentUrl;
    private bool mostrarModal = false;
    private bool expandSubMenu;

    // --- NUEVA VARIABLE ---
    private EmpleadoViewModel? empleadoActual;

    private void MostrarConfirmacion() { mostrarModal = true; }
    private void CerrarModal() { mostrarModal = false; }
    private async Task EjecutarSalidaReal()
    {
        mostrarModal = false;
        await JSRuntime.InvokeVoidAsync("submitLogoutForm");
    }

    // --- CAMBIAMOS A OnInitializedAsync ---
    protected override async Task OnInitializedAsync()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;

        // Consultamos los datos del usuario al cargar el menú
        await CargarDatosEmpleado();
    }

    // --- LÓGICA PARA BUSCAR AL EMPLEADO ---
    private async Task CargarDatosEmpleado()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            var userId = user.FindFirst(c => c.Type.Contains("nameidentifier"))?.Value;

            if (!string.IsNullOrEmpty(userId))
            {
                int empId = await EmpleadoService.GetEmpleadoIdByUserIdAsync(userId);
                if (empId > 0)
                {
                    empleadoActual = await EmpleadoService.GetEmpleadoByIdAsync(empId);
                }
            }
        }
        catch
        {
            // Si hay un error (ej. base de datos caída o usuario sin empleado),
            // empleadoActual quedará en null y Blazor usará la vista por defecto.
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }

    private void CloseNavMenu()
    {
        if (!collapseNavMenu)
        {
            collapseNavMenu = true;
        }
    }
}

<style>
    /* 1. ESTILO BASE (ESCRITORIO) */
    .sidebar-container {
        height: 100vh;
        background-color: #033750;
        overflow: hidden;
    }

    /* Clase principal del menú */
    .nav-slider {
        /* Color de fondo PROPIO del menú (para que tape al abrirse) */
        background-color: #033750;
        height: 100%;
        width: 250px;
        display: flex;
        flex-direction: column;
        transition: transform 0.3s ease-in-out;
    }

    /* Links */
    .nav-link {
        color: #d7d7d7;
        padding: 0.8rem 1rem;
        border-radius: 4px;
        display: flex;
        align-items: center;
        text-decoration: none;
    }

        .nav-link:hover {
            background-color: rgba(255,255,255,0.1);
            color: white;
        }

        .nav-link.active {
            background-color: #1b6ec2;
            color: white;
        }

    /*.custom-scroll::-webkit-scrollbar {
        display: none;
    } */

    /* Ocultar scrollbar para Chrome, Safari y Opera */
    .hide-scrollbar::-webkit-scrollbar {
        display: none;
    }

    /* Ocultar scrollbar para Firefox, IE y Edge */
    .hide-scrollbar {
        -ms-overflow-style: none; /* IE y Edge */
        scrollbar-width: none; /* Firefox */
    }

    /* Ocultar lengüeta en PC */
    .mobile-toggle-tab {
        display: none;
    }


    /* 2. ESTILO MÓVIL Y TABLET (MENOR A 992px) */
    /* Coincide con el breakpoint del MainLayout */
    @@media (max-width: 991.98px) {

        .sidebar-container {
            width: 0;
            overflow: visible !important;
        }

        .nav-slider {
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            width: 260px; /* Un poco más ancho para cubrir bordes */
            z-index: 9999;
            /* Escondido a la izquierda */
            transform: translateX(-100%);
            overflow: visible !important;
            box-shadow: 4px 0 15px rgba(0,0,0,0.5);
        }
            /* Clase para mostrar el menú */
            .nav-slider.responsive-open {
                transform: translateX(0);
            }
        /* LENGÜETA VISIBLE */
        .mobile-toggle-tab {
            display: flex;
            align-items: center;
            justify-content: center;
            position: absolute;
            top: 80px;
            right: -45px; /* Sale hacia la derecha */

            width: 45px;
            height: 45px;
            background-color: #1b6ec2;
            color: white;
            border-top-right-radius: 8px;
            border-bottom-right-radius: 8px;
            cursor: pointer;
            box-shadow: 2px 2px 5px rgba(0,0,0,0.3);
            z-index: 10000;
        }
    }
</style>
