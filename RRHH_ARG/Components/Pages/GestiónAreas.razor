@page "/gestion-areas"
@using RRHH_ARG.Models
@using RRHH_ARG.Data
@using Microsoft.AspNetCore.Components.Forms
@using System.IO
@using System.Threading
@inject EmpleadoService EmpleadoService
@inject IJSRuntime JS
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "RH, HSE")]

<div class="container-fluid py-3">
    <div class="row mb-3">
        <div class="col">
            <h3 class="text-primary fw-bold"><i class="bi bi-diagram-3-fill me-2"></i>Estructura Organizacional</h3>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert"
             style="position: fixed; top: 20px; right: 20px; z-index: 2000; min-width: 300px;">
            <i class="bi bi-check-circle-fill me-2"></i>@successMessage
            <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }

    <div class="row g-4">

        <div class="col-md-5 col-lg-4">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-header bg-dark text-white py-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 card-title"><i class="bi bi-buildings me-2"></i>Áreas</h5>
                    <span class="badge bg-secondary rounded-pill">@areasList.Count</span>
                </div>

                <div class="card-body bg-light">
                    <div class="input-group mb-3 shadow-sm">
                        <input type="text" class="form-control border-0" placeholder="Nueva área..." @bind="nuevaAreaNombre" />
                        <button class="btn btn-success" @onclick="AgregarArea" disabled="@string.IsNullOrWhiteSpace(nuevaAreaNombre)">
                            <i class="bi bi-plus-lg"></i>
                        </button>
                    </div>

                    <div class="list-group shadow-sm" style="max-height: 600px; overflow-y: auto;">
                        @foreach (var area in areasList)
                        {
                            bool isActive = areaSeleccionadaId == area.AreId;

                            <div class="list-group-item list-group-item-action d-flex align-items-center p-2 @(isActive ? "active bg-primary border-primary" : "")"
                                 @onclick="() => SeleccionarArea(area.AreId)"
                                 style="cursor: pointer; transition: all 0.2s;">

                                <div class="flex-grow-1 text-truncate me-2 fw-medium" title="@area.AreNombre">
                                    @area.AreNombre
                                </div>

                                <div class="flex-shrink-0 btn-group">
                                    <button class="btn btn-sm @(isActive ? "btn-outline-light" : "btn-outline-secondary") border-0"
                                            @onclick="() => AbrirModalEditarArea(area)"
                                            @onclick:stopPropagation="true" title="Renombrar">
                                        <i class="bi bi-pencil-square"></i>
                                    </button>

                                    <button class="btn btn-sm @(isActive ? "btn-outline-light" : "btn-outline-danger") border-0"
                                            @onclick="@(() => SolicitarConfirmacion(
                                            $"¿Desea eliminar el departamento '{area.AreNombre}'?",
                                                                                            async () => await EliminarArea(area.AreId),
                                                                                            "Sí, Eliminar",
                                                                                            true
                                                                                        ))"
                                        @onclick:stopPropagation="true" title="Eliminar">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </div>
                                                }
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-7 col-lg-8">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-header bg-white py-3 border-bottom">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0 text-primary">
                            @if (areaSeleccionadaId != 0)
                            {
                                <span class="text-truncate"><i class="bi bi-folder2-open me-2"></i>Puestos: <strong>@areasList.FirstOrDefault(a => a.AreId == areaSeleccionadaId)?.AreNombre</strong></span>
                            }
                            else
                            {
                                <span><i class="bi bi-list-ul me-2"></i>Detalle de Puestos</span>
                            }
                        </h5>

                        @if (areaSeleccionadaId != 0)
                        {
                            <div class="input-group w-50">
                                <input type="text" class="form-control" placeholder="Nuevo puesto..." @bind="nuevoPuestoNombre" />
                                <button class="btn btn-primary" @onclick="AgregarPuesto" disabled="@string.IsNullOrWhiteSpace(nuevoPuestoNombre)">
                                    <i class="bi bi-plus-circle"></i>
                                </button>
                            </div>
                        }
                    </div>
                </div>

                <div class="card-body p-0">
                    @if (areaSeleccionadaId == 0)
                    {
                        <div class="d-flex flex-column align-items-center justify-content-center py-5 text-muted opacity-50" style="min-height: 400px;">
                            <i class="bi bi-arrow-left-square display-3 mb-3"></i>
                            <h4>Selecciona un Área</h4>
                        </div>
                    }
                    else if (puestosList.Count == 0)
                    {
                        <div class="text-center py-5 text-muted" style="min-height: 400px;">
                            <i class="bi bi-inbox display-4 opacity-25"></i>
                            <p class="mt-2">No hay puestos registrados aquí.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="ps-4">Puesto</th>
                                        <th class="text-center" style="width: 80px;">Desc.</th>
                                        <th class="text-center" style="width: 80px;">Doc.</th>
                                        <th class="text-end pe-4" style="width: 120px;">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var puesto in puestosList)
                                    {
                                        <tr>
                                            <td class="ps-4 fw-bold text-dark text-truncate" style="max-width: 250px;" title="@puesto.PepNombre">
                                                @puesto.PepNombre
                                            </td>

                                            <td class="text-center">
                                                @if (!string.IsNullOrEmpty(puesto.PepDescripcion))
                                                {
                                                    <i class="bi bi-card-text text-primary fs-5" title="Tiene descripción"></i>
                                                }
                                                else
                                                {

                                                    <i class="bi bi-dash-lg text-muted opacity-25"></i>
                                                }
                                            </td>

                                            <td class="text-center">
                                                @if (puesto.PepArchivo != null && puesto.PepArchivo.Length > 0)
                                                {
                                                    <i class="bi bi-file-earmark-pdf-fill text-danger fs-5" title="Archivo disponible"></i>
                                                }
                                                else
                                                {

                                                    <i class="bi bi-dash-lg text-muted opacity-25"></i>
                                                }
                                            </td>

                                            <td class="text-end pe-4">
                                                <div class="btn-group">
                                                    <button class="btn btn-outline-primary btn-sm" @onclick="() => AbrirModalEditar(puesto)" title="Editar">
                                                        <i class="bi bi-pencil"></i>
                                                    </button>
                                                    <button class="btn btn-outline-danger btn-sm"
                                                            @onclick="@(() => SolicitarConfirmacion(
                                                            $"¿Desea eliminar el puesto '{puesto.PepNombre}'?",
                                                                                                                    async () => await EliminarPuesto(puesto.PepId),
                                                                                                                    "Sí, Eliminar",
                                                                                                                    true // true = Color Rojo (Peligro)
                                                                                                                ))"
                                                    title="Eliminar">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                                                                }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@if (mostrarModalEdicion)
{
    <div class="modal d-block" style="background-color: rgba(0,0,0,0.6); z-index: 1050;">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content shadow-lg border-0">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title"><i class="bi bi-pencil-square me-2"></i>Editar Puesto</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CerrarModal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label fw-bold">Nombre del Puesto</label>
                            <input type="text" class="form-control" @bind="puestoEnEdicion.PepNombre" />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold">Descripción / Perfil</label>
                            <textarea class="form-control" rows="5" @bind="puestoEnEdicion.PepDescripcion" placeholder="Responsabilidades..."></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold">Documento Adjunto</label>
                            <div class="card bg-light border-0 p-3">
                                @if (puestoEnEdicion.PepArchivo != null && puestoEnEdicion.PepArchivo.Length > 0)
                                {
                                    <div class="d-flex align-items-center mb-3 text-success">
                                        <i class="bi bi-check-circle-fill me-2 fs-4"></i>
                                        <div class="flex-grow-1">
                                            <strong>Archivo cargado.</strong>
                                        </div>

                                        @* --- CAMBIO REALIZADO AQUÍ --- *@
                                        @* Usamos <a> en vez de <button> para abrir en otra pestaña (target="_blank") *@
                                        <a href="api/Archivo/Puesto/@puestoEnEdicion.PepId" target="_blank" class="btn btn-outline-primary btn-sm">
                                            <i class="bi bi-eye me-1"></i> Visualizar
                                        </a>
                                        @* ----------------------------- *@

                                    </div>
                                }
                                @*<InputFile OnChange="HandleFileSelected" class="form-control" />*@
                                <InputFile OnChange="HandleFileSelected" class="form-control" accept=".pdf,application/pdf" />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" @onclick="CerrarModal">Cancelar</button>

                    <button type="button" class="btn btn-success px-4" @onclick="PrevioGuardarEdicionPuesto">
                        Guardar Cambios
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (mostrarModalArea)
{
    <div class="modal d-block" style="background-color: rgba(0,0,0,0.6); z-index: 1050;">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content shadow border-0">
                <div class="modal-header bg-dark text-white py-2">
                    <h6 class="modal-title m-0">Renombrar Área</h6>
                    <button type="button" class="btn-close btn-close-white btn-sm" @onclick="() => mostrarModalArea = false"></button>
                </div>
                <div class="modal-body">
                    <input type="text" class="form-control" @bind="areaEnEdicion.AreNombre" />
                </div>
                <div class="modal-footer p-1 bg-light justify-content-center">
                    <button class="btn btn-sm btn-success w-100" @onclick="PrevioGuardarEdicionArea">Actualizar</button>
                </div>
            </div>
        </div>
    </div>
}

@if (mostrarModalConfirmacion)
{
    <div class="modal d-block" style="background-color: rgba(0,0,0,0.5); z-index: 1060;">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content shadow border-0">
                <div class="modal-header @claseColorConfirmacion text-white py-2">
                    <h6 class="modal-title m-0"><i class="bi bi-exclamation-triangle-fill me-2"></i>Confirmar</h6>
                    <button type="button" class="btn-close btn-close-white btn-sm" @onclick="CerrarConfirmacion"></button>
                </div>
                <div class="modal-body text-center p-4">
                    <p class="mb-0 fw-medium">@mensajeConfirmacion</p>
                    @if (claseColorConfirmacion.Contains("danger"))
                    {
                        <small class="text-muted d-block mt-2">Esta acción no se puede deshacer.</small>
                    }
                </div>
                <div class="modal-footer p-2 bg-light justify-content-center">
                    <button class="btn btn-sm btn-secondary px-3"
                            @onclick="CerrarConfirmacion"
                            disabled="@isProcessing">
                        Cancelar
                    </button>

                    <button class="btn btn-sm @(claseColorConfirmacion.Replace("bg-", "btn-")) px-3"
                            @onclick="EjecutarAccionConfirmada"
                            disabled="@isProcessing">
                        @textoBotonConfirmacion
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    // --- VARIABLES DE DATOS ---
    private List<Area> areasList = new();
    private List<PerfilPuesto> puestosList = new();
    private int areaSeleccionadaId = 0;
    private string nuevaAreaNombre = "";
    private string nuevoPuestoNombre = "";
    private string? errorMessage;

    // --- VARIABLES DE CONTROL UI (NUEVAS) ---
    private bool isProcessing = false; // <--- ESTA FALTABA
    private string? successMessage;
    private CancellationTokenSource? _cts; // Para manejar el tiempo del mensaje

    // --- VARIABLES DE MODALES ---
    private bool mostrarModalArea = false;
    private Area areaEnEdicion = new();

    private bool mostrarModalEdicion = false;
    private PerfilPuesto puestoEnEdicion = new();
    private IBrowserFile? archivoSeleccionado;

    // --- VARIABLES DE CONFIRMACIÓN ---
    private bool mostrarModalConfirmacion = false;
    private string mensajeConfirmacion = "";
    private string textoBotonConfirmacion = "Confirmar";
    private string claseColorConfirmacion = "bg-primary";
    private Func<Task>? accionPendiente;

    // --- CICLO DE VIDA ---
    protected override async Task OnInitializedAsync() => await CargarAreas();

    // --- MÉTODOS DE CARGA ---
    private async Task CargarAreas() { try { areasList = await EmpleadoService.GetAreasAsync(); } catch (Exception ex) { errorMessage = ex.Message; } }

    private async Task SeleccionarArea(int id) { areaSeleccionadaId = id; await CargarPuestos(); }

    private async Task CargarPuestos()
    {
        if (areaSeleccionadaId == 0) return;
        try { var all = await EmpleadoService.GetPerfilesPuestoAsync(); puestosList = all.Where(p => p.AreId == areaSeleccionadaId).ToList(); }
        catch (Exception ex) { errorMessage = ex.Message; }
    }

    // --- MÉTODOS DE ÁREAS ---
    private async Task AgregarArea()
    {
        if (isProcessing) return;
        try
        {
            isProcessing = true; StateHasChanged();
            await EmpleadoService.AddAreaAsync(nuevaAreaNombre);
            nuevaAreaNombre = "";
            await CargarAreas();
            await MostrarMensajeExito("Área creada correctamente.");
        }
        catch (Exception ex) { errorMessage = ex.Message; }
        finally { isProcessing = false; StateHasChanged(); }
    }

    private async Task EliminarArea(int id)
    {
        try
        {
            await EmpleadoService.DeleteAreaAsync(id);
            if (areaSeleccionadaId == id) { areaSeleccionadaId = 0; puestosList.Clear(); }
            await CargarAreas();
            await MostrarMensajeExito("Área eliminada correctamente.");
        }
        catch (Exception ex) { errorMessage = ex.Message; }
    }

    private void AbrirModalEditarArea(Area a) { areaEnEdicion = new Area { AreId = a.AreId, AreNombre = a.AreNombre }; mostrarModalArea = true; }

    // Interceptor para Área (Modal Azul)
    private void PrevioGuardarEdicionArea()
    {
        var areaOriginal = areasList.FirstOrDefault(a => a.AreId == areaEnEdicion.AreId);
        string nombreViejo = areaOriginal?.AreNombre ?? "Desconocido";
        string nombreNuevo = areaEnEdicion.AreNombre;

        string mensaje = $"¿Seguro que quieres cambiar el nombre del departamento '{nombreViejo}' a '{nombreNuevo}'?";

        SolicitarConfirmacion(mensaje, async () => await EjecutarGuardadoArea(), "Sí, Cambiar", false);
    }

    private async Task EjecutarGuardadoArea()
    {
        try
        {
            await EmpleadoService.UpdateAreaAsync(areaEnEdicion);
            mostrarModalArea = false;
            await CargarAreas();
            await MostrarMensajeExito("Nombre actualizado correctamente.");
        }
        catch (Exception ex) { errorMessage = ex.Message; }
    }

    // --- MÉTODOS DE PUESTOS ---
    private async Task AgregarPuesto()
    {
        if (areaSeleccionadaId == 0 || isProcessing) return;
        try
        {
            isProcessing = true; StateHasChanged();
            await EmpleadoService.AddPuestoAsync(areaSeleccionadaId, nuevoPuestoNombre);
            nuevoPuestoNombre = "";
            await CargarPuestos();
            await MostrarMensajeExito("Puesto agregado correctamente.");
        }
        catch (Exception ex) { errorMessage = ex.Message; }
        finally { isProcessing = false; StateHasChanged(); }
    }

    private async Task EliminarPuesto(int id)
    {
        try
        {
            await EmpleadoService.DeletePuestoAsync(id);
            await CargarPuestos();
            await MostrarMensajeExito("Puesto eliminado correctamente.");
        }
        catch (Exception ex) { errorMessage = ex.Message; }
    }

    // --- MÉTODOS DE EDICIÓN AVANZADA (PUESTOS) ---
    private void AbrirModalEditar(PerfilPuesto p)
    {
        puestoEnEdicion = new PerfilPuesto { PepId = p.PepId, PepNombre = p.PepNombre, PepDescripcion = p.PepDescripcion, PepArchivo = p.PepArchivo, AreId = p.AreId };
        archivoSeleccionado = null; mostrarModalEdicion = true;
    }
    private void CerrarModal() => mostrarModalEdicion = false;
    private void HandleFileSelected(InputFileChangeEventArgs e) => archivoSeleccionado = e.File;

    // Interceptor para Puesto (Modal Azul)
    private void PrevioGuardarEdicionPuesto()
    {
        var puestoOriginal = puestosList.FirstOrDefault(p => p.PepId == puestoEnEdicion.PepId);
        string nombreViejo = puestoOriginal?.PepNombre ?? "Desconocido";
        string nombreNuevo = puestoEnEdicion.PepNombre;

        string mensaje = (nombreViejo != nombreNuevo)
            ? $"¿Seguro que quieres cambiar el nombre del puesto '{nombreViejo}' a '{nombreNuevo}'?"
            : $"¿Seguro que quieres actualizar los datos del puesto '{nombreViejo}'?";

        SolicitarConfirmacion(mensaje, async () => await EjecutarGuardadoPuesto(), "Sí, Guardar", false);
    }

    private async Task EjecutarGuardadoPuesto()
    {
        try
        {
            Stream? s = null;
            if (archivoSeleccionado != null) s = archivoSeleccionado.OpenReadStream(5 * 1024 * 1024);

            await EmpleadoService.UpdatePuestoAsync(puestoEnEdicion, s);
            mostrarModalEdicion = false;
            await CargarPuestos();
            await MostrarMensajeExito("Puesto actualizado correctamente.");
        }
        catch (Exception ex) { errorMessage = ex.Message; }
    }

    private async Task DescargarArchivoActual()
    {
        if (puestoEnEdicion.PepArchivo != null)
        {
            var b64 = Convert.ToBase64String(puestoEnEdicion.PepArchivo);
            await JS.InvokeVoidAsync("downloadBase64File", "perfil.pdf", "application/octet-stream", b64);
        }
    }

    // --- MÉTODOS DE CONFIRMACIÓN ---

    // Sobrecarga principal
    private void SolicitarConfirmacion(string mensaje, Func<Task> accion, string textoBtn = "Confirmar", bool esPeligroso = true)
    {
        mensajeConfirmacion = mensaje;
        accionPendiente = accion;
        textoBotonConfirmacion = textoBtn;
        claseColorConfirmacion = esPeligroso ? "bg-danger" : "bg-primary";
        mostrarModalConfirmacion = true;
    }

    private void CerrarConfirmacion()
    {
        mostrarModalConfirmacion = false;
        accionPendiente = null;
    }

    private async Task EjecutarAccionConfirmada()
    {
        if (accionPendiente != null && !isProcessing)
        {
            var accionAEjecutar = accionPendiente;
            isProcessing = true;

            // 1. Cierra modal visualmente inmediato
            mostrarModalConfirmacion = false;
            StateHasChanged();

            try
            {
                // 2. Ejecuta acción (BD + Mensaje Exito)
                await accionAEjecutar.Invoke();
            }
            catch (Exception ex)
            {
                errorMessage = ex.Message;
            }
            finally
            {
                accionPendiente = null;
                isProcessing = false;
                StateHasChanged();
            }
        }
    }

    // --- MÉTODO DE NOTIFICACIÓN OPTIMIZADO (1.5s) ---
    private async Task MostrarMensajeExito(string mensaje)
    {
        // Cancelamos el timer anterior si existe
        _cts?.Cancel();
        _cts = new CancellationTokenSource();
        var token = _cts.Token;

        errorMessage = null;
        successMessage = mensaje;
        StateHasChanged();

        try
        {
            // Solo espera 1.5 segundos
            await Task.Delay(2500, token);

            if (!token.IsCancellationRequested)
            {
                successMessage = null;
                StateHasChanged();
            }
        }
        catch (TaskCanceledException) { /* Ignorar cancelación */ }
    }


}