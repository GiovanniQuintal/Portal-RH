    private void CerrarModal()
    {
        showModal = false;
        empleadoSeleccionado = null;
        desgloseRecibo = null;
    }

    private async Task GuardarModal()
    {
        if (isLocked) return;
        isModalBusy = true;
        try
        {
            await PayrollService.GuardarReciboAsync(empleadoSeleccionado.NomId, empleadoSeleccionado.DiasPagados, empleadoSeleccionado.PagoAplicado, desgloseRecibo, estadoEditado);
            CerrarModal();
            await CargarNomina();
            await MostrarAvisoExitoAsync();
        }
        finally { isModalBusy = false; }
    }

    private async Task GuardarYSiguienteModal()
    {
        if (isLocked) return;
        isModalBusy = true;
        try
        {
            await PayrollService.GuardarReciboAsync(empleadoSeleccionado.NomId, empleadoSeleccionado.DiasPagados, empleadoSeleccionado.PagoAplicado, desgloseRecibo, estadoEditado);
            int currentIndex = matrizNomina.FindIndex(m => m.NomId == empleadoSeleccionado.NomId);
            await CargarNomina();

            await MostrarAvisoExitoAsync();

            if (currentIndex >= 0 && currentIndex < matrizNomina.Count - 1)
                await AbrirModalEdicion(matrizNomina[currentIndex + 1]);
            else
                CerrarModal();
        }
        finally { isModalBusy = false; }
    }

    private async Task GuardarYAnteriorModal()
    {
        if (isLocked) return;
        isModalBusy = true;
        try
        {
            await PayrollService.GuardarReciboAsync(empleadoSeleccionado.NomId, empleadoSeleccionado.DiasPagados, empleadoSeleccionado.PagoAplicado, desgloseRecibo, estadoEditado);
            int currentIndex = matrizNomina.FindIndex(m => m.NomId == empleadoSeleccionado.NomId);
            await CargarNomina();

            await MostrarAvisoExitoAsync();

