@code {
    private int selectedAnio;
    private int selectedMes;
    private int selectedQuincena;
    private bool isBusy = false;

    private Nomina periodoActual;
    private bool isLocked = false;

    private List<NominaConceptos> catalogoConceptos;
    private List<NominaConceptos> columnasOrdenadas;
    private List<NominaMatrizDTO> matrizNomina;

    private bool showModal = false;
    private bool showConfirmGenerateModal = false;
    private bool showConfirmRestoreModal = false;
    private bool showConfirmDeleteModal = false;
    private bool showConfirmDeleteSabanaModal = false;
    private bool isModalBusy = false;
    private NominaMatrizDTO empleadoSeleccionado;
    private List<NominaImporteDTO> desgloseRecibo;
    private string estadoEditado = "EN_PROCESO";

    private bool showIncidenciaModal = false;
    private NominaImporteDTO itemComentarioActivo = null;

    private bool showSuccessModal = false;

    // SIMPLIFICACIÓN DEL COMBOBOX
    public class ComboPeriodo { 
        public int Mes { get; set; } 
        public int Quincena { get; set; } 
        public string Nombre { get; set; } 
        public string IdCombo => $"{Mes}|{Quincena}"; 
        public bool EsGenerada { get; set; } = false; // <--- NUEVA PROPIEDAD
    }
    private List<ComboPeriodo> opcionesPeriodos = new();

    // VARIABLES PARA ORDENAMIENTO
    private string sortColumn = "Subsidiaria"; // Por defecto agrupamos por subsidiaria
    private bool isSortAscending = true;

    private void SortByEmpleado()
    {
        if (matrizNomina == null || !matrizNomina.Any()) return;

        if (sortColumn == "Empleado")
            isSortAscending = !isSortAscending; // Invierte de A-Z a Z-A
        else
        {
            sortColumn = "Empleado";
            isSortAscending = true;
        }
        AplicarOrdenamiento();
    }

    private void SortBySubsidiaria()
    {
        if (matrizNomina == null || !matrizNomina.Any()) return;

        if (sortColumn == "Subsidiaria")
            isSortAscending = !isSortAscending; // Invierte de A-Z a Z-A
        else
        {
            sortColumn = "Subsidiaria";
            isSortAscending = true;
        }
        AplicarOrdenamiento();
    }

    private void AplicarOrdenamiento()
    {
        if (matrizNomina == null) return;

        if (sortColumn == "Empleado")
        {
            // Rompe el grupo de subsidiarias y ordena a todos parejo por apellidos
            matrizNomina = isSortAscending 
                ? matrizNomina.OrderBy(m => m.NombreCompleto).ToList() 
                : matrizNomina.OrderByDescending(m => m.NombreCompleto).ToList();
        }
        else if (sortColumn == "Subsidiaria")
        {
            // Agrupa por subsidiaria y luego por apellidos
            matrizNomina = isSortAscending 
                ? matrizNomina.OrderBy(m => m.NombreSubsidiaria).ThenBy(m => m.NombreCompleto).ToList() 
                : matrizNomina.OrderByDescending(m => m.NombreSubsidiaria).ThenBy(m => m.NombreCompleto).ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var hoy = DateTime.Now;
        selectedAnio = hoy.Year;
        selectedMes = hoy.Month;
        selectedQuincena = hoy.Day <= 15 ? 1 : 2;

        catalogoConceptos = await PayrollService.GetConceptosAsync();
        columnasOrdenadas = catalogoConceptos;
        
        await ActualizarEstadoPeriodosAsync(); // <--- LLAMADA AL NUEVO MÉTODO
        await CargarNomina();
    }

    private async Task ActualizarEstadoPeriodosAsync()
    {
        opcionesPeriodos.Clear();

        // 1. Le pedimos al Servicio que nos traiga la lista (¡Sin violar la seguridad!)
        var periodosExistentes = await PayrollService.GetPeriodosGeneradosAsync(selectedAnio);

        // 2. Armamos la lista del 1 al 12
        for (int i = 1; i <= 12; i++)
        {
            string nombreMes = GetNombreMes(i);
            int p1 = ((i - 1) * 2) + 1;
            int p2 = ((i - 1) * 2) + 2;

            opcionesPeriodos.Add(new ComboPeriodo
            {
                Mes = i,
                Quincena = 1,
                Nombre = $"{nombreMes} (P{p1})",
                EsGenerada = periodosExistentes.Contains($"P{p1}")
            });

            opcionesPeriodos.Add(new ComboPeriodo
            {
                Mes = i,
                Quincena = 2,
                Nombre = $"{nombreMes} (P{p2})",
                EsGenerada = periodosExistentes.Contains($"P{p2}")
            });
        }
    }

    // --- NUEVO MÉTODO CUANDO CAMBIA EL AÑO ---
    private async Task OnAnioChanged()
    {
        await ActualizarEstadoPeriodosAsync();
        await CargarNomina();
    }

    private string GetNombreMes(int mes)
    {
        if (mes < 1 || mes > 12) return "";
        return new DateTime(2000, mes, 1).ToString("MMMM", new CultureInfo("es-MX")).ToUpper();
    }

    private void OnPeriodoChanged(ChangeEventArgs e)
    {
        var parts = e.Value.ToString().Split('|');
        selectedMes = int.Parse(parts[0]);
        selectedQuincena = int.Parse(parts[1]);
        matrizNomina = null;
    }

    // BOTÓN "CONSULTAR"
    private async Task CargarNomina()
    {
        isBusy = true;
        try
        {
            periodoActual = await PayrollService.GetPeriodoAsync(selectedAnio, selectedMes, selectedQuincena);

            if (periodoActual == null)
            {
                // NO EXISTE: Preguntamos si quiere crearlo
                matrizNomina = null;
                showConfirmGenerateModal = true;
                isLocked = false;
            }
            else
            {
                // SÍ EXISTE: Lo cargamos y ordenamos columnas
                isLocked = periodoActual.Bloqueado;
                var matriz = await PayrollService.GetMatrizNominaAsync(periodoActual.NominaId);
                matrizNomina = matriz;
                AplicarOrdenamiento();
                OrdenarColumnasDinamicas();
            }
        }
        finally { isBusy = false; }
    }

    // BOTÓN "SÍ, GENERAR / RESTAURAR" DEL MODAL
    private async Task ConfirmarGeneracion()
    {
        isBusy = true;
        try
        {
            periodoActual = await PayrollService.GenerarNuevaNominaAsync(selectedAnio, selectedMes, selectedQuincena);
            var matriz = await PayrollService.GetMatrizNominaAsync(periodoActual.NominaId);
matrizNomina = matriz;
AplicarOrdenamiento();
            OrdenarColumnasDinamicas();
            showConfirmGenerateModal = false;
            showConfirmRestoreModal = false;
            
            await ActualizarEstadoPeriodosAsync(); // <--- Refrescamos el combo
        }
        finally { isBusy = false; }
    }

    private void OrdenarColumnasDinamicas()
    {
        if (matrizNomina == null || !matrizNomina.Any())
        {
            columnasOrdenadas = catalogoConceptos;
            return;
        }

        var conceptosLlenos = catalogoConceptos.Where(c =>
            matrizNomina.Any(m => m.Conceptos.ContainsKey(c.ConceptoId) && m.Conceptos[c.ConceptoId].Total > 0)
        ).ToList();

        var conceptosVacios = catalogoConceptos.Except(conceptosLlenos).ToList();

        columnasOrdenadas = conceptosLlenos.Concat(conceptosVacios).ToList();
    }

    private async Task ToggleLock()
    {
        if (periodoActual != null)
        {
            // Invertimos el estado actual del candado
            isLocked = !isLocked;

            await PayrollService.ToggleBloqueoAsync(periodoActual.NominaId, isLocked);
            periodoActual.Bloqueado = isLocked;
            StateHasChanged();
        }
    }

    private string GetStatusColor(string estado) => estado switch
    {
        "APROBADA" => "status-green",
        "EN_PROCESO" or "EN_REVISION" => "status-orange",
        "RETENIDA" => "status-red",
        _ => "status-gray"
    };

    private void ActivarEdicionCelda(CeldaNominaDTO celda, NominaConceptos concepto)
    {
        if (isLocked) return;
        celda.ValorEditado = concepto.CeldaEditable ? celda.Cantidad : (celda.Total == 0 ? null : celda.Total);
        celda.IsEditing = true;
    }

    private async Task ProcesarCeldaInline(NominaMatrizDTO fila, NominaConceptos concepto, CeldaNominaDTO celda)
    {
        if (isLocked) { celda.IsEditing = false; return; }

        celda.IsEditing = false;
        decimal valorEntrado = celda.ValorEditado ?? 0;
        decimal sdi = fila.SaeSdi;
        decimal salarioDiarioNormal = fila.SaeQuincenalPactado / 15m;

        if (concepto.CeldaEditable)
        {
            celda.Cantidad = valorEntrado;
            string nombreConcepto = concepto.Concepto.ToUpper();

            if (nombreConcepto.Contains("HORAS EXTRAS")) celda.Total = Math.Round(valorEntrado * ((sdi / 8m) * 2m), 2);
            else if (nombreConcepto.Contains("FESTIVO") || nombreConcepto.Contains("DESCANSO")) celda.Total = Math.Round(valorEntrado * (sdi * 3m), 2);
            else if (nombreConcepto.Contains("DOMINICAL")) celda.Total = Math.Round(valorEntrado * (salarioDiarioNormal * 0.25m), 2);
            else if (nombreConcepto.Contains("BAJA") || nombreConcepto.Contains("FALTA")) celda.Total = Math.Round(valorEntrado * sdi, 2);
            else celda.Total = 0;
        }
        else
        {
            celda.Total = valorEntrado;
            celda.Cantidad = null;
        }

        int diasTotalesQ = selectedQuincena == 1 ? 15 : DateTime.DaysInMonth(selectedAnio, selectedMes) - 15;
        decimal customSdSueldo = fila.SaeQuincenalPactado / (decimal)diasTotalesQ;
        decimal sueldoBaseProporcional = Math.Round(customSdSueldo * fila.DiasPagados, 2);

        // Aquí está la corrección:
        fila.TotalPercepciones = sueldoBaseProporcional + catalogoConceptos
            .Where(c => c.Tipo == "P")
            .Sum(c => fila.Conceptos.GetValueOrDefault(c.ConceptoId)?.Total ?? 0);

        fila.TotalDeducciones = catalogoConceptos
            .Where(c => c.Tipo == "D")
            .Sum(c => fila.Conceptos.GetValueOrDefault(c.ConceptoId)?.Total ?? 0);

        // REGLA DE ORO: NETO = P - D
        fila.TotalPagado = fila.TotalPercepciones - fila.TotalDeducciones;

        if (fila.Estado == "NO_REGISTRADO") fila.Estado = "EN_PROCESO";

        var desgloseFalso = new List<NominaImporteDTO>();
        foreach (var kvp in fila.Conceptos)
        {
            var cat = catalogoConceptos.First(c => c.ConceptoId == kvp.Key);
            desgloseFalso.Add(new NominaImporteDTO { ConId = kvp.Key, Tipo = cat.Tipo, Total = kvp.Value.Total, Importe = kvp.Value.Total, Cantidad = kvp.Value.Cantidad });
        }

        var desgloseRealBD = await PayrollService.GetDesgloseParaEdicionAsync(fila.NomId);
        foreach (var itemBD in desgloseRealBD)
        {
            var itemFalso = desgloseFalso.FirstOrDefault(df => df.ConId == itemBD.ConId);
            if (itemFalso != null) itemFalso.NdeId = itemBD.NdeId;
        }

        await PayrollService.GuardarReciboAsync(fila.NomId, fila.DiasPagados, desgloseFalso, fila.Estado);
    }

    private void CalcularLinea(NominaImporteDTO item)
    {
        if (!item.Cantidad.HasValue || empleadoSeleccionado == null)
        {
            item.Total = 0; item.Importe = 0; StateHasChanged(); return;
        }

        decimal sdi = empleadoSeleccionado.SaeSdi;
        decimal salarioDiarioNormal = empleadoSeleccionado.SaeQuincenalPactado / 15m;
        string nombreConcepto = item.NombreConcepto.ToUpper();

        if (nombreConcepto.Contains("HORAS EXTRAS")) item.Total = Math.Round(item.Cantidad.Value * ((sdi / 8m) * 2m), 2);
        else if (nombreConcepto.Contains("FESTIVO") || nombreConcepto.Contains("DESCANSO")) item.Total = Math.Round(item.Cantidad.Value * (sdi * 3m), 2);
        else if (nombreConcepto.Contains("DOMINICAL")) item.Total = Math.Round(item.Cantidad.Value * (salarioDiarioNormal * 0.25m), 2);
        else if (nombreConcepto.Contains("BAJA") || nombreConcepto.Contains("FALTA")) item.Total = Math.Round(item.Cantidad.Value * sdi, 2);

        item.Importe = item.Total;
        StateHasChanged();
    }

    private void SincronizarImporte(NominaImporteDTO item)
    {
        item.Importe = item.Total;
        StateHasChanged();
    }

    private async Task ExportarExcel()
    {
        if (matrizNomina == null || !matrizNomina.Any()) return;

        var sb = new StringBuilder();
        sb.Append("Subsidiaria,Empleado,Sueldo Quincenal,Dias a Pagar,Sueldo Devengado,");
        foreach (var c in columnasOrdenadas) sb.Append($"{QuitarAcentos(c.Concepto)},");
        sb.AppendLine("Total Percepciones,Total Deducciones,Total Pagado");

        foreach (var fila in matrizNomina)
        {
            string nombreLimpio = QuitarAcentos(fila.NombreCompleto);
            string subNombre = QuitarAcentos(fila.NombreSubsidiaria);

            int diasTotalesQ = selectedQuincena == 1 ? 15 : DateTime.DaysInMonth(selectedAnio, selectedMes) - 15;
            decimal customSd = fila.SaeQuincenalPactado / (decimal)diasTotalesQ;
            decimal sueldoDevengado = Math.Round(customSd * fila.DiasPagados, 2);

            sb.Append($"\"{subNombre}\",\"{nombreLimpio}\",{fila.SaeQuincenalPactado},{fila.DiasPagados},{sueldoDevengado},");
            foreach (var c in columnasOrdenadas)
            {
                decimal valor = fila.Conceptos.GetValueOrDefault(c.ConceptoId)?.Total ?? 0;
                sb.Append($"{valor},");
            }
            sb.AppendLine($"{fila.TotalPercepciones},{fila.TotalDeducciones},{fila.TotalPagado}");
        }

        var preamble = Encoding.UTF8.GetPreamble();
        var bytes = Encoding.UTF8.GetBytes(sb.ToString());
        var finalBytes = new byte[preamble.Length + bytes.Length];
        Buffer.BlockCopy(preamble, 0, finalBytes, 0, preamble.Length);
        Buffer.BlockCopy(bytes, 0, finalBytes, preamble.Length, bytes.Length);

        var base64 = Convert.ToBase64String(finalBytes);
        var filename = $"Nomina_{selectedAnio}_M{selectedMes}_Q{selectedQuincena}.csv";

        await JS.InvokeVoidAsync("eval",
            $@"var link = document.createElement('a');
               link.download = '{filename}';
               link.href = 'data:text/csv;charset=utf-8;base64,{base64}';
               document.body.appendChild(link);
               link.click();
               document.body.removeChild(link);");
    }

