    public class ComboPeriodo { 
        public int Mes { get; set; } 
        public int Quincena { get; set; } 
        public string Nombre { get; set; } 
        public string IdCombo => $"{Mes}|{Quincena}"; 
        public bool EsGenerada { get; set; } = false; 
    }
    private List<ComboPeriodo> opcionesPeriodos = new();

    private string sortColumn = "Subsidiaria"; 
    private bool isSortAscending = true;

    private void SortByEmpleado()
    {
        if (matrizNomina == null || !matrizNomina.Any()) return;

        if (sortColumn == "Empleado")
            isSortAscending = !isSortAscending; 
        else
        {
            sortColumn = "Empleado";
            isSortAscending = true;
        }
        AplicarOrdenamiento();
    }

    private void SortBySubsidiaria()
    {
        if (matrizNomina == null || !matrizNomina.Any()) return;

        if (sortColumn == "Subsidiaria")
            isSortAscending = !isSortAscending; 
        else
        {
            sortColumn = "Subsidiaria";
            isSortAscending = true;
        }
        AplicarOrdenamiento();
    }

    private void AplicarOrdenamiento()
    {
        if (matrizNomina == null) return;

        if (sortColumn == "Empleado")
        {
            matrizNomina = isSortAscending 
                ? matrizNomina.OrderBy(m => m.NombreCompleto).ToList() 
                : matrizNomina.OrderByDescending(m => m.NombreCompleto).ToList();
        }
        else if (sortColumn == "Subsidiaria")
        {
            matrizNomina = isSortAscending 
                ? matrizNomina.OrderBy(m => m.NombreSubsidiaria).ThenBy(m => m.NombreCompleto).ToList() 
                : matrizNomina.OrderByDescending(m => m.NombreSubsidiaria).ThenBy(m => m.NombreCompleto).ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var hoy = DateTime.Now;
        selectedAnio = hoy.Year;
        selectedMes = hoy.Month;
        selectedQuincena = hoy.Day <= 15 ? 1 : 2;

        catalogoConceptos = await PayrollService.GetConceptosAsync();

        columnasOrdenadas = catalogoConceptos.Where(c => c.MostrarEnSabana).ToList();

        await ActualizarEstadoPeriodosAsync();
        await CargarNomina();
    }

    private async Task ActualizarEstadoPeriodosAsync()
    {
        opcionesPeriodos.Clear();

        var periodosExistentes = await PayrollService.GetPeriodosGeneradosAsync(selectedAnio);

        for (int i = 1; i <= 12; i++)
        {
            string nombreMes = GetNombreMes(i);
            int p1 = ((i - 1) * 2) + 1;
            int p2 = ((i - 1) * 2) + 2;

            opcionesPeriodos.Add(new ComboPeriodo
            {
                Mes = i,
                Quincena = 1,
                Nombre = $"{nombreMes} (P{p1})",
                EsGenerada = periodosExistentes.Contains($"P{p1}")
            });

            opcionesPeriodos.Add(new ComboPeriodo
            {
                Mes = i,
                Quincena = 2,
                Nombre = $"{nombreMes} (P{p2})",
                EsGenerada = periodosExistentes.Contains($"P{p2}")
            });
        }
    }

    private async Task OnAnioChanged()
    {
        await ActualizarEstadoPeriodosAsync();
        await CargarNomina();
    }

    private string GetNombreMes(int mes)
    {
        if (mes < 1 || mes > 12) return "";
        return new DateTime(2000, mes, 1).ToString("MMMM", new CultureInfo("es-MX")).ToUpper();
    }

    private void OnPeriodoChanged(ChangeEventArgs e)
    {
        var parts = e.Value.ToString().Split('|');
        selectedMes = int.Parse(parts[0]);
        selectedQuincena = int.Parse(parts[1]);
        matrizNomina = null;
    }

    private async Task CargarNomina()
    {
        isBusy = true;
        try
        {
            periodoActual = await PayrollService.GetPeriodoAsync(selectedAnio, selectedMes, selectedQuincena);

            if (periodoActual == null)
            {
                matrizNomina = null;
                showConfirmGenerateModal = true;
                isLocked = false;
            }
            else
            {
                isLocked = periodoActual.Bloqueado;
                var matriz = await PayrollService.GetMatrizNominaAsync(periodoActual.NominaId);
                matrizNomina = matriz;
                AplicarOrdenamiento();
                OrdenarColumnasDinamicas();
            }
        }
        finally { isBusy = false; }
    }

    private async Task ConfirmarGeneracion()
    {
        isBusy = true;
        try
        {
            periodoActual = await PayrollService.GenerarNuevaNominaAsync(selectedAnio, selectedMes, selectedQuincena);
            var matriz = await PayrollService.GetMatrizNominaAsync(periodoActual.NominaId);
            matrizNomina = matriz;
            AplicarOrdenamiento();
            OrdenarColumnasDinamicas();
            showConfirmGenerateModal = false;
            showConfirmRestoreModal = false;
            
            await ActualizarEstadoPeriodosAsync();
        }
        finally { isBusy = false; }
    }

    private void OrdenarColumnasDinamicas()
    {
        if (matrizNomina == null || !matrizNomina.Any())
        {
            columnasOrdenadas = catalogoConceptos.Where(c => c.MostrarEnSabana).ToList();
            return;
        }

        var conceptosLlenos = catalogoConceptos.Where(c =>
            c.MostrarEnSabana &&
            matrizNomina.Any(m => m.Conceptos.ContainsKey(c.ConceptoId) && m.Conceptos[c.ConceptoId].Total > 0)
        ).ToList();

        var conceptosVacios = catalogoConceptos
            .Where(c => c.MostrarEnSabana)
            .Except(conceptosLlenos)
            .ToList();

        columnasOrdenadas = conceptosLlenos.Concat(conceptosVacios).ToList();
    }

    private async Task ToggleLock()
    {
        if (periodoActual != null)
        {
            isLocked = !isLocked;

            await PayrollService.ToggleBloqueoAsync(periodoActual.NominaId, isLocked);
            periodoActual.Bloqueado = isLocked;
            StateHasChanged();
        }
    }

    private string GetStatusColor(string estado) => estado switch
    {
        "APROBADA" => "status-green",
        "EN_PROCESO" or "EN_REVISION" => "status-orange",
        "RETENIDA" => "status-red",
        _ => "status-gray"
    };

    private void ActivarEdicionCelda(CeldaNominaDTO celda, NominaConceptos concepto)
    {
        if (isLocked) return;

        celda.ValorEditado = (concepto.CeldaEditable && !concepto.EsMontoDirecto)
                             ? celda.Cantidad
                             : (celda.Total == 0 ? null : celda.Total);
        celda.IsEditing = true;
    }

    private async Task ProcesarCeldaInline(NominaMatrizDTO fila, NominaConceptos concepto, CeldaNominaDTO celda)
    {
        if (!celda.IsEditing) return;

        // 1. REBOTAR: Si la fila ya está viajando al servidor, ignoramos los clics extra
        if (fila.IsSaving || isLocked) { celda.IsEditing = false; return; }

        celda.IsEditing = false;
        decimal valorEntrado = celda.ValorEditado ?? 0;
        decimal sdi = fila.SaeSdi;
        decimal salarioDiarioNormal = fila.SaeQuincenalPactado / 15m;

        fila.IsSaving = true; // 2. PONER SEGURO
        StateHasChanged();

        try
        {
            if (concepto.CeldaEditable)
            {
                if (concepto.EsMontoDirecto)
                {
                    celda.Cantidad = valorEntrado > 0 ? 1 : null;
                    celda.Total = valorEntrado;
                }
                else
                {
                    celda.Cantidad = valorEntrado;
                    string nombreConcepto = concepto.Concepto.ToUpper();

                    if (nombreConcepto.Contains("HORAS EXTRAS")) celda.Total = Math.Round(valorEntrado * ((sdi / 8m) * 2m), 2);
                    else if (nombreConcepto.Contains("FESTIVO") || nombreConcepto.Contains("DESCANSO")) celda.Total = Math.Round(valorEntrado * (sdi * 3m), 2);
                    else if (nombreConcepto.Contains("DOMINICAL")) celda.Total = Math.Round(valorEntrado * (salarioDiarioNormal * 0.25m), 2);
                    else if (nombreConcepto.Contains("BAJA") || nombreConcepto.Contains("FALTA")) celda.Total = Math.Round(valorEntrado * sdi, 2);
                    else celda.Total = 0;
                }
            }
            else
            {
                celda.Total = valorEntrado;
                celda.Cantidad = null;
            }

            int diasTotalesQ = 15;
            decimal customSdSueldo = fila.SaeQuincenalPactado / (decimal)diasTotalesQ;
            decimal sueldoBaseProporcional = Math.Round(customSdSueldo * fila.DiasPagados, 2);

            fila.TotalPercepciones = sueldoBaseProporcional + catalogoConceptos
                .Where(c => c.Tipo == "P")
                .Sum(c => fila.Conceptos.GetValueOrDefault(c.ConceptoId)?.Total ?? 0);

            fila.TotalDeducciones = catalogoConceptos
                .Where(c => c.Tipo == "D")
                .Sum(c => fila.Conceptos.GetValueOrDefault(c.ConceptoId)?.Total ?? 0);

            // AQUÍ ESTABA EL DETALLE MATEMÁTICO DE LA SÁBANA (Sumar Deuda anterior)
            fila.TotalPagado = (fila.TotalPercepciones - fila.TotalDeducciones) + fila.AdeudoAnterior;

            if (fila.Estado == "NO_REGISTRADO") fila.Estado = "EN_PROCESO";

            // 1. Traemos la lista ORIGINAL para no perder el ID ni la bandera "RequiereCantidad"
            var desgloseRealBD = await PayrollService.GetDesgloseParaEdicionAsync(fila.NomId);

            foreach (var kvp in fila.Conceptos)
            {
                var bdItem = desgloseRealBD.FirstOrDefault(df => df.ConId == kvp.Key);

                if (bdItem != null)
                {
                    // Si el concepto ya existía, solo actualizamos los números tecleados
                    bdItem.Cantidad = kvp.Value.Cantidad;
                    bdItem.Total = kvp.Value.Total;
                    bdItem.Importe = kvp.Value.Total;
                }
                else if (kvp.Value.Total > 0 || kvp.Value.Cantidad > 0)
                {
                    // Si es un concepto totalmente nuevo, lo agregamos prendiendo todas las banderas necesarias
                    var cat = catalogoConceptos.First(c => c.ConceptoId == kvp.Key);
                    desgloseRealBD.Add(new NominaImporteDTO
                    {
                        ConId = kvp.Key,
                        Tipo = cat.Tipo,
                        Total = kvp.Value.Total,
                        Importe = kvp.Value.Total,
                        Cantidad = kvp.Value.Cantidad,
                        RequiereCantidad = cat.CeldaEditable && !cat.EsMontoDirecto, // <--- ESTO ENCIENDE LA INCIDENCIA
                        NombreConcepto = cat.Concepto
                    });
                }
            }

            await PayrollService.GuardarReciboAsync(fila.NomId, fila.DiasPagados, fila.PagoAplicado, desgloseRealBD, fila.Estado);

            // Refrescamos en la pantalla los nuevos IDs generados por el servidor
            var desgloseActualizado = await PayrollService.GetDesgloseParaEdicionAsync(fila.NomId);
            foreach (var itemBD in desgloseActualizado)
            {
                if (fila.Conceptos.ContainsKey(itemBD.ConId))
                {
                    // Solo se usa de forma interna para que al abrir el Modal ya tenga el ID Puesto
                    fila.Conceptos[itemBD.ConId].Total = itemBD.Total;
                }
            }
        }
        finally
        {
            fila.IsSaving = false; // 3. QUITAR SEGURO al terminar
            StateHasChanged();
        }
    }

    private void CalcularLinea(NominaImporteDTO item)
    {
        if (!item.Cantidad.HasValue || empleadoSeleccionado == null)
        {
            item.Total = 0; item.Importe = 0; StateHasChanged(); return;
        }

        var conceptoRegla = catalogoConceptos.FirstOrDefault(c => c.ConceptoId == item.ConId);

        if (conceptoRegla != null && conceptoRegla.EsMontoDirecto)
        {
            item.Total = item.Cantidad.Value;
        }
        else
        {
            decimal sdi = empleadoSeleccionado.SaeSdi;
            decimal salarioDiarioNormal = empleadoSeleccionado.SaeQuincenalPactado / 15m;
            string nombre = item.NombreConcepto.ToUpper();

            if (nombre.Contains("HORAS EXTRAS")) item.Total = Math.Round(item.Cantidad.Value * ((sdi / 8m) * 2m), 2);
            else if (nombre.Contains("FESTIVO") || nombre.Contains("DESCANSO")) item.Total = Math.Round(item.Cantidad.Value * (sdi * 3m), 2);
            else if (nombre.Contains("DOMINICAL")) item.Total = Math.Round(item.Cantidad.Value * (salarioDiarioNormal * 0.25m), 2);
            else item.Total = Math.Round(item.Cantidad.Value * sdi, 2); 
        }

        item.Importe = item.Total;
        StateHasChanged();
    }

    private void SincronizarImporte(NominaImporteDTO item)
    {
        item.Importe = item.Total;
        StateHasChanged();
    }

    private async Task ExportarExcel()
    {
        if (matrizNomina == null || !matrizNomina.Any()) return;

        // 1. Inicializamos el libro de ClosedXML nativo
        using var workbook = new ClosedXML.Excel.XLWorkbook();
        var worksheet = workbook.Worksheets.Add("Sábana Prenómina");

        // Recuperamos el color corporativo Navy Blue de las cabeceras de tu Sábana
        var colorNavy = ClosedXML.Excel.XLColor.FromHtml("#253C60");

        // --- CONSTRUCCIÓN DE CABECERAS ---
        int colIndex = 1;
        worksheet.Cell(1, colIndex++).Value = "Subsidiaria";
        worksheet.Cell(1, colIndex++).Value = "Empleado";
        worksheet.Cell(1, colIndex++).Value = "Banco";
        worksheet.Cell(1, colIndex++).Value = "Sueldo Quincenal";
        worksheet.Cell(1, colIndex++).Value = "Dias a Pagar";
        worksheet.Cell(1, colIndex++).Value = "Sueldo Devengado";

        // Cabeceras de conceptos dinámicos de la quincena
        foreach (var c in columnasOrdenadas)
        {
            worksheet.Cell(1, colIndex++).Value = QuitarAcentos(c.Concepto).ToUpper();
        }

        // Cabeceras de totales finales
        worksheet.Cell(1, colIndex++).Value = "Total Percepciones";
        worksheet.Cell(1, colIndex++).Value = "Total Deducciones";
        worksheet.Cell(1, colIndex++).Value = "Deuda Anterior";
        worksheet.Cell(1, colIndex++).Value = "Total Pagado";
        worksheet.Cell(1, colIndex++).Value = "Pago Aplicado";
        worksheet.Cell(1, colIndex++).Value = "Adeudo";

        // Aplicar estilos profesionales a la fila de cabecera (Negrita, Fondo Navy, Texto Blanco)
        var rangoEncabezado = worksheet.Range(1, 1, 1, colIndex - 1);
        rangoEncabezado.Style.Font.Bold = true;
        rangoEncabezado.Style.Font.FontColor = ClosedXML.Excel.XLColor.White;
        rangoEncabezado.Style.Fill.BackgroundColor = colorNavy;
        rangoEncabezado.Style.Alignment.Horizontal = ClosedXML.Excel.XLAlignmentHorizontalValues.Center;

        // --- ENLACE Y MAPEO DE DATOS ---
        int rowIndex = 2;
        foreach (var fila in matrizNomina)
        {
            colIndex = 1;
            worksheet.Cell(rowIndex, colIndex++).Value = QuitarAcentos(fila.NombreSubsidiaria);
            worksheet.Cell(rowIndex, colIndex++).Value = QuitarAcentos(fila.NombreCompleto);
            worksheet.Cell(rowIndex, colIndex++).Value = QuitarAcentos(fila.Banco ?? "Sin Banco");

            // Sueldo Quincenal Pactado
            var cellSueldo = worksheet.Cell(rowIndex, colIndex++);
            cellSueldo.Value = fila.SaeQuincenalPactado;
            cellSueldo.Style.NumberFormat.Format = "$#,##0.00"; // Formato de moneda real

            // Días a Pagar
            worksheet.Cell(rowIndex, colIndex++).Value = fila.DiasPagados;

            // Sueldo Devengado (Base 15 estándar)
            int diasTotalesQ = 15;
            decimal customSd = fila.SaeQuincenalPactado / (decimal)diasTotalesQ;
            decimal sueldoDevengado = Math.Round(customSd * fila.DiasPagados, 2);

            var cellDevengado = worksheet.Cell(rowIndex, colIndex++);
            cellDevengado.Value = sueldoDevengado;
            cellDevengado.Style.NumberFormat.Format = "$#,##0.00";

            // Iteramos los valores reales de cada concepto dinámico de la quincena
            foreach (var c in columnasOrdenadas)
            {
                decimal valor = fila.Conceptos.GetValueOrDefault(c.ConceptoId)?.Total ?? 0;
                var cellConcepto = worksheet.Cell(rowIndex, colIndex++);
                cellConcepto.Value = valor;
                cellConcepto.Style.NumberFormat.Format = "$#,##0.00";
            }

            // Columnas finales de totales, pagos y adeudos
            decimal[] montosFinales = { fila.TotalPercepciones, fila.TotalDeducciones, fila.AdeudoAnterior, fila.TotalPagado, fila.PagoAplicado, fila.Adeudado };
            foreach (var monto in montosFinales)
            {
                var cellMonto = worksheet.Cell(rowIndex, colIndex++);
                cellMonto.Value = monto;
                cellMonto.Style.NumberFormat.Format = "$#,##0.00";
            }

            rowIndex++;
        }

        // Autoajustamos el ancho de las columnas según su contenido
        worksheet.Columns(1, colIndex - 1).AdjustToContents();

        // 4. Transformamos el libro binario a un flujo de memoria
        using var ms = new System.IO.MemoryStream();
        workbook.SaveAs(ms);
        var bytes = ms.ToArray();

        var base64 = Convert.ToBase64String(bytes);
        var filename = $"Nomina_{selectedAnio}_M{selectedMes}_Q{selectedQuincena}.xlsx";

        // 5. Invocamos la descarga con el Content-Type nativo de las hojas OpenXML de Office
        await JS.InvokeVoidAsync("eval",
            $@"var link = document.createElement('a');
           link.download = '{filename}';
           link.href = 'data:application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;base64,{base64}';
           document.body.appendChild(link);
           link.click();
           document.body.removeChild(link);");
    }

