@page "/nomina/dashboard"
@using RRHH_ARG.Models
@using RRHH_ARG.Data
@using System.Text
@using System.Globalization
@inject PayrollService PayrollService
@inject IJSRuntime JS
@inject NavigationManager Nav
@rendermode InteractiveServer

<div class="payroll-container p-3">
    <div class="top-panel mb-3 d-flex justify-content-between align-items-center">
        <div>
            <h3 class="title text-dark fw-bold m-0"><i class="bi bi-cash-coin"></i> Sábana de Prenómina</h3>
        </div>
        <button class="btn btn-outline-secondary btn-sm shadow-sm" @onclick='() => Nav.NavigateTo("/finanzas/hub")'>
            <i class="bi bi-arrow-left"></i> Volver
        </button>
    </div>

    @* --- PANEL DE FILTROS SIMPLIFICADO --- *@
    <div class="card shadow-sm border-0 mb-4 bg-light">
        <div class="card-body py-2">
            <div class="row g-2 align-items-end">
                <div class="col-auto">
                    <label class="form-label fw-bold small m-0">Año Fiscal</label>
                    <select class="form-select form-select-sm" style="min-width: 100px;" @bind="selectedAnio" @bind:after="OnAnioChanged">
                        @for (int i = DateTime.Now.Year - 1; i <= DateTime.Now.Year + 1; i++)
                        {
                            <option value="@i">@i</option>
                        }
                    </select>
                </div>
                <div class="col-auto">
                    <label class="form-label fw-bold small m-0">Periodo de Pago</label>
                    <select class="form-select form-select-sm" style="min-width: 180px;" @onchange="OnPeriodoChanged">
                        @foreach (var p in opcionesPeriodos)
                        {
                            @* APLICAMOS ESTILO VISUAL SI LA SÁBANA YA EXISTE *@
                            if (p.EsGenerada)
                            {
                                <option value="@p.IdCombo" selected="@(p.Mes == selectedMes && p.Quincena == selectedQuincena)" style="color: #198754; font-weight: bold; background-color: #f0fdf4;">
                                    ✓ @p.Nombre
                                </option>
                            }
                            else
                            {
                                <option value="@p.IdCombo" selected="@(p.Mes == selectedMes && p.Quincena == selectedQuincena)">
                                    @p.Nombre
                                </option>
                            }
                        }
                    </select>
                </div>

                @* BOTONES AGRUPADOS A LA IZQUIERDA *@
                <div class="col-auto d-flex gap-2">
                    <button class="btn btn-sm btn-primary px-4 fw-bold shadow-sm" @onclick="CargarNomina" disabled="@isBusy">
                        @if (isBusy)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        <i class="bi bi-search me-1"></i> Consultar
                    </button>

                    <button class="btn btn-sm btn-outline-success px-3 fw-bold shadow-sm" @onclick="ExportarExcel" disabled="@(matrizNomina == null || !matrizNomina.Any())" title="Exportar a Excel">
                        <i class="bi bi-file-earmark-excel"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

    @* TÍTULO DINÁMICO Y CANDADO DE SEGURIDAD *@
    <div class="d-flex justify-content-between align-items-center mb-2 px-1">
        <h5 class="m-0 fw-bold text-secondary">
            <span class="text-dark">P@(((selectedMes - 1) * 2) + selectedQuincena) @GetNombreMes(selectedMes) @selectedAnio</span>
        </h5>

        @if (periodoActual != null)
        {
            <div class="d-flex gap-2 align-items-center">

                @* NUEVO: BOTÓN ELIMINAR SÁBANA (Solo si no está bloqueada) *@
                @if (!isLocked)
                {
                    <button class="btn btn-outline-danger shadow-sm d-flex justify-content-center align-items-center p-0"
                            style="width: 38px; height: 38px; border-radius: 6px;"
                            @onclick="() => showConfirmDeleteSabanaModal = true"
                            title="Eliminar Sábana Completa">
                        <i class="bi bi-trash3-fill fs-5 m-0"></i>
                    </button>
                }

                @* BOTÓN RESTAURAR EMPLEADO *@
                @if (matrizNomina != null && !isLocked)
                {
                    <button class="btn btn-warning shadow-sm d-flex justify-content-center align-items-center p-0"
                            style="width: 38px; height: 38px; border-radius: 6px;"
                            @onclick="() => showConfirmRestoreModal = true"
                            title="Restaurar empleados excluidos">
                        <i class="bi bi-arrow-counterclockwise fs-5 text-dark m-0"></i>
                    </button>
                }

                @* BOTÓN CANDADO *@
                <button class="btn @(isLocked ? "btn-danger" : "btn-success") shadow-sm d-flex justify-content-center align-items-center p-0"
                        style="width: 38px; height: 38px; border-radius: 6px;"
                        @onclick="ToggleLock"
                        title="@(isLocked ? "Desbloquear Sábana" : "Bloquear Sábana")">
                    <i class="bi @(isLocked ? "bi-lock-fill" : "bi-unlock-fill") fs-5 text-white m-0"></i>
                </button>
            </div>
        }
    </div>

    @* --- MATRIZ PRINCIPAL --- *@
    <div class="table-responsive bg-white shadow-sm border rounded" style="height: 60vh; overflow-y: scroll; overflow-x: auto; position: relative;">
        <table class="table table-hover mb-0 excel-table align-middle text-nowrap" style="font-size: 0.75rem;">
            <thead class="bg-navy">
                <tr>
                    <th class="text-center sticky-header-1" style="min-width: 45px; width: 45px; max-width: 45px;">Est</th>
                    <th class="sticky-header-2 user-select-none" style="min-width: 220px; width: 220px; max-width: 220px; cursor: pointer;" @onclick="SortByEmpleado" title="Clic para ordenar por Apellidos">
    Empleado
    @if (sortColumn == "Empleado")
    {
        <i class="bi @(isSortAscending ? "bi-sort-alpha-down" : "bi-sort-alpha-up") ms-1 text-warning"></i>
    }
</th>
<th class="user-select-none" style="min-width: 140px; cursor: pointer;" @onclick="SortBySubsidiaria" title="Clic para agrupar por Subsidiaria">
    Subsidiaria
    @if (sortColumn == "Subsidiaria")
    {
        <i class="bi @(isSortAscending ? "bi-sort-alpha-down" : "bi-sort-alpha-up") ms-1 text-warning"></i>
    }
</th>
                    <th class="text-end px-1">Qnal Pactado</th>
                    <th class="text-center px-1">Días P.</th>
                    <th class="text-end px-1 text-info fw-bold" style="background-color: #1a2a44;">Sueldo Deveng.</th>

                    @if (columnasOrdenadas != null)
                    {
                        @foreach (var c in columnasOrdenadas)
                        {
                            <th class="text-end px-1">
                                @(c.Concepto.ToUpper().Contains("DOMINICAL") ? "7MO DÍA / PRIMA DOMINICAL" :
                                                c.Concepto.ToUpper().Contains("FESTIVO") ? "DÍA FESTIVO" : c.Concepto)
                                @if (c.CeldaEditable)
                                {
                                    <i class="bi bi-calculator ms-1 opacity-50" title="Calculado Automáticamente"></i>
                                }
                            </th>
                        }
                    }
                    <th class="text-end px-1">T. Percepciones</th>
                    <th class="text-end px-1">T. Deducciones</th>
                    <th class="text-end px-1 fw-bold text-warning">TOTAL A PAGAR</th>
                </tr>
            </thead>
            <tbody>
                @if (matrizNomina == null)
                {
                    <tr>
                        <td colspan="30" class="text-center py-5 text-muted">
                            <i class="bi bi-search display-6 d-block mb-3 opacity-25"></i>
                            Seleccione el periodo y presione "Consultar"
                        </td>
                    </tr>
                }
                else if (!matrizNomina.Any())
                {
                    <tr>
                        <td colspan="30" class="text-center py-5 text-muted">
                            No hay recibos generados para este periodo. Presione "Restaurar Eliminados" si desea regenerarlos.
                        </td>
                    </tr>
                }
                else
                {
                    <Virtualize Items="@matrizNomina" Context="fila" ItemSize="40" OverscanCount="15">
                        <tr class="@(isLocked ? "opacity-75" : "")">
                            <td class="text-center sticky-col-1" style="min-width: 45px; width: 45px; max-width: 45px;">
                                <div class="status-circle @GetStatusColor(fila.Estado)" title="@fila.Estado"></div>
                            </td>
                            <td class="fw-bold text-primary cursor-pointer name-link px-2 sticky-col-2" style="min-width: 220px; width: 220px; max-width: 220px;" @onclick="() => AbrirModalEdicion(fila)">
                                @fila.NombreCompleto
                            </td>

                            <td class="text-muted px-2" style="font-size: 0.7rem;">
                                <i class="bi bi-building me-1"></i>@fila.NombreSubsidiaria
                            </td>

                            <td class="text-end text-muted px-1">@fila.SaeQuincenalPactado.ToString("C2")</td>
                            <td class="text-center fw-bold text-dark px-1 bg-light">@fila.DiasPagados.ToString("0.##")</td>

                            <td class="text-end fw-bold text-primary px-1" style="background-color: #f8fbfb;">
                                @{
                                    int diasTotalesQ = selectedQuincena == 1 ? 15 : DateTime.DaysInMonth(selectedAnio, selectedMes) - 15;
                                    decimal customSd = fila.SaeQuincenalPactado / (decimal)diasTotalesQ;
                                    decimal devengado = Math.Round(customSd * fila.DiasPagados, 2);
                                }
                                @devengado.ToString("C2")
                            </td>

                            @if (columnasOrdenadas != null)
                            {
                                @foreach (var c in columnasOrdenadas)
                                {
                                    if (!fila.Conceptos.ContainsKey(c.ConceptoId)) fila.Conceptos[c.ConceptoId] = new CeldaNominaDTO();
                                    var celda = fila.Conceptos[c.ConceptoId];

                                    <td class="text-end p-0 position-relative" style="min-width: 65px;">
                                        @if (celda.IsEditing && !isLocked)
                                        {
                                            <input type="number" step="0.01" autofocus
                                                   class="excel-input-dashboard fw-bold"
                                                   @bind="celda.ValorEditado"
                                                   @onblur="() => ProcesarCeldaInline(fila, c, celda)"
                                                   @onkeyup="@(e => { if (e.Key == "Enter") ProcesarCeldaInline(fila, c, celda); })" />
                                        }
                                        else
                                        {
                                            <div class="w-100 h-100 d-flex align-items-center justify-content-end px-1 @(isLocked ? "" : "cell-clickable")"
                                                 @ondblclick="() => { if (!isLocked) ActivarEdicionCelda(celda, c); }">
                                                @if (celda.Total > 0)
                                                {
                                                    <span class="@(c.Tipo == "P" ? "pill-success" : "pill-danger") px-1">
                                                        @celda.Total.ToString("N2")
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted opacity-25">-</span>
                                                }
                                            </div>
                                        }
                                    </td>
                                }
                            }
                            <td class="text-end bg-light px-1">
                                <span class="text-success fw-bold">@fila.TotalPercepciones.ToString("C2")</span>
                            </td>
                            <td class="text-end bg-light px-1">
                                <span class="text-danger fw-bold">@fila.TotalDeducciones.ToString("C2")</span>
                            </td>
                            <td class="text-end fw-bold px-1" style="font-size: 0.85rem; background-color: #eef2f7;">
                                @fila.TotalPagado.ToString("C2")
                            </td>
                        </tr>
                    </Virtualize>
                }
            </tbody>

            @* TOTALES GENERALES DE LA SÁBANA *@
            @if (matrizNomina != null && matrizNomina.Any())
            {
                <tfoot style="position: sticky; bottom: 0; z-index: 10; background-color: #eef2f7; border-top: 2px solid #253C60;">
                    <tr>
                        <td class="sticky-col-1" style="background-color: #eef2f7;"></td>
                        <td class="sticky-col-2 text-end fw-bold text-dark pe-3" style="background-color: #eef2f7;">TOTAL:</td>
                        <td colspan="4" style="background-color: #eef2f7;"></td>

                        @if (columnasOrdenadas != null)
                        {
                            @foreach (var c in columnasOrdenadas)
                            {
                                <td class="text-end fw-bold text-muted px-1" style="background-color: #eef2f7;">
                                    @{
                                        decimal sumaColumna = matrizNomina.Sum(f => f.Conceptos.ContainsKey(c.ConceptoId) ? f.Conceptos[c.ConceptoId].Total : 0);
                                    }
                                    @(sumaColumna > 0 ? sumaColumna.ToString("C2") : "-")
                                </td>
                            }
                        }
                        <td class="text-end fw-bold text-success px-1" style="background-color: #eef2f7;">
                            @matrizNomina.Sum(f => f.TotalPercepciones).ToString("C2")
                        </td>
                        <td class="text-end fw-bold text-danger px-1" style="background-color: #eef2f7;">
                            @matrizNomina.Sum(f => f.TotalDeducciones).ToString("C2")
                        </td>
                        <td class="text-end fw-bold text-dark px-1" style="font-size: 0.9rem; background-color: #eef2f7;">
                            @matrizNomina.Sum(f => f.TotalPagado).ToString("C2")
                        </td>
                    </tr>
                </tfoot>
            }
        </table>
    </div>
</div>

@* ========================================================= *@
@* MODAL PARA CONFIRMAR GENERACIÓN (NUEVA SÁBANA)            *@
@* ========================================================= *@
@if (showConfirmGenerateModal)
{
    <div class="modal d-block" style="background-color: rgba(0,0,0,0.6); z-index: 1050;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg border-0">
                <div class="modal-header bg-primary text-white py-2">
                    <h5 class="modal-title fw-bold"><i class="bi bi-magic"></i> Inicializar Periodo</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => showConfirmGenerateModal = false"></button>
                </div>
                <div class="modal-body text-center p-4">
                    <h5 class="fw-bold">No existe sábana para este periodo.</h5>
                    <p class="text-muted">¿Desea inicializar y generar una nueva prenómina para <strong>P@(((selectedMes - 1) * 2) + selectedQuincena) @GetNombreMes(selectedMes) @selectedAnio</strong>?</p>
                    <p class="small text-primary fw-bold"><i class="bi bi-info-circle-fill"></i> El sistema importará automáticamente los beneficios contractuales y las incidencias reportadas en estas fechas.</p>
                </div>
                <div class="modal-footer bg-light justify-content-center">
                    <button class="btn btn-secondary px-4 fw-bold" @onclick="() => showConfirmGenerateModal = false">Cancelar</button>
                    <button class="btn btn-primary px-4 fw-bold shadow-sm" @onclick="ConfirmarGeneracion" disabled="@isBusy">
                        @if (isBusy)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Sí, Generar Nómina
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* ========================================================= *@
@* MODAL PARA CONFIRMAR RESTAURACIÓN                         *@
@* ========================================================= *@
@if (showConfirmRestoreModal)
{
    <div class="modal d-block" style="background-color: rgba(0,0,0,0.6); z-index: 1050;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg border-0">
                <div class="modal-header bg-warning text-dark py-2">
                    <h5 class="modal-title fw-bold"><i class="bi bi-arrow-counterclockwise"></i> Restaurar Recibos</h5>
                    <button type="button" class="btn-close" @onclick="() => showConfirmRestoreModal = false"></button>
                </div>
                <div class="modal-body text-center p-4">
                    <h5 class="fw-bold text-dark">¿Restaurar recibos eliminados?</h5>
                    <p class="text-muted">Si excluyó algún empleado de esta sábana y desea que vuelva a aparecer, el sistema reconstruirá su recibo con los valores por defecto y beneficios actuales.</p>
                    <p class="small text-danger fw-bold"><i class="bi bi-exclamation-triangle-fill"></i> Esta acción no afectará los recibos que ya haya modificado y guardado.</p>
                </div>
                <div class="modal-footer bg-light justify-content-center">
                    <button class="btn btn-secondary px-4 fw-bold" @onclick="() => showConfirmRestoreModal = false">Cancelar</button>
                    <button class="btn btn-warning px-4 fw-bold shadow-sm text-dark" @onclick="ConfirmarGeneracion" disabled="@isBusy">
                        @if (isBusy)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Sí, Restaurar
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* ========================================================= *@
@* MODAL PARA CONFIRMAR EXCLUSIÓN (ELIMINAR RECIBO INDIVIDUAL)*@
@* ========================================================= *@
@if (showConfirmDeleteModal && empleadoSeleccionado != null)
{
    <div class="modal d-block" style="background-color: rgba(0,0,0,0.7); z-index: 1100;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg border-danger border-2">
                <div class="modal-header bg-danger text-white py-2">
                    <h5 class="modal-title fw-bold"><i class="bi bi-person-x-fill"></i> Excluir Empleado</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => showConfirmDeleteModal = false"></button>
                </div>
                <div class="modal-body text-center p-4">
                    <h5 class="fw-bold text-danger">¿Está seguro de excluir a <br />@empleadoSeleccionado.NombreCompleto?</h5>
                    <p class="text-muted mt-3">Se borrará su recibo de este periodo de pago.</p>
                    <div class="alert alert-warning small p-2 mb-0">
                        <i class="bi bi-info-circle-fill"></i> Esta acción <strong>NO</strong> borra al empleado del sistema, solo lo quita de esta quincena. Podrá restaurarlo después si lo necesita.
                    </div>
                </div>
                <div class="modal-footer bg-light justify-content-center">
                    <button class="btn btn-secondary px-4 fw-bold" @onclick="() => showConfirmDeleteModal = false">Cancelar</button>
                    <button class="btn btn-danger px-4 fw-bold shadow-sm" @onclick="EjecutarEliminacionRecibo" disabled="@isModalBusy">
                        @if (isModalBusy)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Sí, Excluir
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* ========================================================= *@
@* NUEVO MODAL: ELIMINAR SÁBANA COMPLETA                     *@
@* ========================================================= *@
@if (showConfirmDeleteSabanaModal && periodoActual != null)
{
    <div class="modal d-block" style="background-color: rgba(0,0,0,0.7); z-index: 1100;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg border-danger border-2">
                <div class="modal-header bg-danger text-white py-2">
                    <h5 class="modal-title fw-bold"><i class="bi bi-trash3-fill"></i> Eliminar Sábana Completa</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => showConfirmDeleteSabanaModal = false"></button>
                </div>
                <div class="modal-body text-center p-4">
                    <h5 class="fw-bold text-danger">¿Está seguro de eliminar toda la sábana de <br />P@(((selectedMes - 1) * 2) + selectedQuincena) @GetNombreMes(selectedMes) @selectedAnio?</h5>
                    <p class="text-muted mt-3">Esta acción borrará todos los recibos y conceptos calculados de esta quincena de la base de datos.</p>
                    <div class="alert alert-warning small p-2 mb-0">
                        <i class="bi bi-exclamation-triangle-fill"></i> Esta acción <strong>NO</strong> se puede deshacer. Tendrá que generar la nómina desde cero nuevamente.
                    </div>
                </div>
                <div class="modal-footer bg-light justify-content-center">
                    <button class="btn btn-secondary px-4 fw-bold" @onclick="() => showConfirmDeleteSabanaModal = false">Cancelar</button>
                    <button class="btn btn-danger px-4 fw-bold shadow-sm" @onclick="EjecutarEliminacionSabana" disabled="@isBusy">
                        @if (isBusy)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Sí, Eliminar Sábana
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* ========================================================= *@
@* MODAL PRINCIPAL DE EDICIÓN DEL RECIBO                     *@
@* ========================================================= *@
@if (showModal)
{
    <div class="modal d-block" style="background-color: rgba(0,0,0,0.6); z-index: 1050;">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content shadow-lg border-0" style="border-radius: 0;">
                <div class="modal-header text-white py-2" style="background-color: #008080; border-radius: 0;">
                    <h5 class="modal-title mb-0" style="font-family: 'Tahoma', sans-serif;">
                        <i class="bi bi-receipt"></i> Detalle de Pre-nómina
                        @if (isLocked)
                        {
                            <span class="badge bg-danger ms-2"><i class="bi bi-lock-fill"></i> BLOQUEADA</span>
                        }
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CerrarModal"></button>
                </div>

                <div class="modal-body bg-white p-4" style="font-family: 'Tahoma', sans-serif;">
                    @if (isModalBusy)
                    {
                        <div class="text-center py-5"><span class="spinner-border text-primary"></span></div>
                    }
                    else if (desgloseRecibo != null && empleadoSeleccionado != null)
                    {
                        // Separación inteligente usando la base de datos (TRES GRUPOS)
                        var conceptosBeneficios = desgloseRecibo.Where(d => d.Clasificacion == "BENEFICIO").ToList();
                        var conceptosDescuentos = desgloseRecibo.Where(d => d.Clasificacion == "DEDUCCIONES").ToList();
                        var conceptosRegulares = desgloseRecibo.Where(d => d.Clasificacion != "BENEFICIO" && d.Clasificacion != "DEDUCCIONES").ToList();

                        var percepciones = conceptosRegulares.Where(c => c.Tipo == "P").ToList();
                        var deducciones = conceptosRegulares.Where(c => c.Tipo == "D").ToList();

                        int totalRows = Math.Max(percepciones.Count + 1, deducciones.Count);

                        // CÁLCULO BASE PROPORCIONAL
                        int diasTotalesQuincena = selectedQuincena == 1 ? 15 : DateTime.DaysInMonth(selectedAnio, selectedMes) - 15;
                        decimal customSdSueldo = empleadoSeleccionado.SaeQuincenalPactado / (decimal)diasTotalesQuincena;
                        decimal sueldoBaseProporcional = Math.Round(customSdSueldo * empleadoSeleccionado.DiasPagados, 2);

                        decimal totalPercepcionesRegulares = sueldoBaseProporcional + percepciones.Sum(p => p.Total);
                        decimal totalDeduccionesRegulares = deducciones.Sum(d => d.Total);
                        decimal netoRegulares = totalPercepcionesRegulares - totalDeduccionesRegulares;

                        @* ENCABEZADO DE INFORMACIÓN *@
                        <div class="aspel-info-box mb-3">
                            <div class="row gx-2 align-items-center mb-1">
                                <div class="col-6"><strong>Empleado:</strong>  @empleadoSeleccionado.NombreCompleto</div>
                            </div>
                            <div class="row gx-2 align-items-center">
                                <div class="col-4"><strong>Sub:</strong> @empleadoSeleccionado.NombreSubsidiaria</div>
