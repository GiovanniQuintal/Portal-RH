    private string QuitarAcentos(string texto)
    {
        if (string.IsNullOrWhiteSpace(texto)) return string.Empty;
        var normalizedString = texto.Normalize(NormalizationForm.FormD);
        var stringBuilder = new StringBuilder();
        foreach (var c in normalizedString)
        {
            var unicodeCategory = CharUnicodeInfo.GetUnicodeCategory(c);
            if (unicodeCategory != UnicodeCategory.NonSpacingMark)
                stringBuilder.Append(c);
        }
        return stringBuilder.ToString().Normalize(NormalizationForm.FormC).Replace("\"", "");
    }

    private async Task MostrarAvisoExitoAsync()
    {
        showSuccessModal = true;
        StateHasChanged();
        await Task.Delay(1500);
        showSuccessModal = false;
        StateHasChanged();
    }

    private void UpdateDiasPagados(ChangeEventArgs e)
    {
        string val = e.Value?.ToString();
        empleadoSeleccionado.DiasPagados = string.IsNullOrWhiteSpace(val) ? 0 : (decimal.TryParse(val, out var result) ? result : 0);
        StateHasChanged();
    }

    private void UpdateCantidad(NominaImporteDTO item, ChangeEventArgs e)
    {
        string val = e.Value?.ToString();
        item.Cantidad = string.IsNullOrWhiteSpace(val) ? null : (decimal.TryParse(val, out var result) ? result : null);
        CalcularLinea(item);
    }

    private void UpdateTotal(NominaImporteDTO item, ChangeEventArgs e)
    {
        string val = e.Value?.ToString();
        item.Total = string.IsNullOrWhiteSpace(val) ? 0 : (decimal.TryParse(val, out var result) ? result : 0);
        SincronizarImporte(item);
    }

    private async Task UpdatePagoAplicadoInline(NominaMatrizDTO fila, ChangeEventArgs e)
    {
        // 1. REBOTAR: Si la fila ya está viajando al servidor, no hacemos caso a más clics
        if (fila.IsSaving || isLocked) return;

        fila.IsSaving = true; // PONER SEGURO
        StateHasChanged();

        try
        {
            string val = e.Value?.ToString();
            fila.PagoAplicado = string.IsNullOrWhiteSpace(val) ? 0 : (decimal.TryParse(val, out var result) ? result : 0);

            fila.Adeudado = fila.TotalPagado - fila.PagoAplicado;

            if (fila.Estado == "NO_REGISTRADO") fila.Estado = "EN_PROCESO";

            // 2. Traemos la lista ORIGINAL de la BD para no perder IDs ni banderas (Adiós lista falsa)
            var desgloseRealBD = await PayrollService.GetDesgloseParaEdicionAsync(fila.NomId);

            foreach (var kvp in fila.Conceptos)
            {
                var bdItem = desgloseRealBD.FirstOrDefault(df => df.ConId == kvp.Key);

                if (bdItem != null)
                {
                    // Si el concepto ya existía, sincronizamos los números de la sábana
                    bdItem.Cantidad = kvp.Value.Cantidad;
                    bdItem.Total = kvp.Value.Total;
                    bdItem.Importe = kvp.Value.Total;
                }
                else if (kvp.Value.Total > 0 || kvp.Value.Cantidad > 0)
                {
                    // Si es un concepto nuevo, lo metemos con sus banderas correctas para las incidencias
                    var cat = catalogoConceptos.First(c => c.ConceptoId == kvp.Key);
                    desgloseRealBD.Add(new NominaImporteDTO
                    {
                        ConId = kvp.Key,
                        Tipo = cat.Tipo,
                        Total = kvp.Value.Total,
                        Importe = kvp.Value.Total,
                        Cantidad = kvp.Value.Cantidad,
                        RequiereCantidad = cat.CeldaEditable && !cat.EsMontoDirecto,
                        NombreConcepto = cat.Concepto
                    });
                }
            }

            // 3. Guardamos pasando la lista íntegra
            await PayrollService.GuardarReciboAsync(fila.NomId, fila.DiasPagados, fila.PagoAplicado, desgloseRealBD, fila.Estado);

            // 4. Refrescamos para que, si se generó un Folio nuevo, la sábana se entere en vivo
            var desgloseActualizado = await PayrollService.GetDesgloseParaEdicionAsync(fila.NomId);
            foreach (var itemBD in desgloseActualizado)
            {
                if (fila.Conceptos.ContainsKey(itemBD.ConId))
                {
                    fila.Conceptos[itemBD.ConId].Total = itemBD.Total;
                }
            }
        }
        finally
        {
            fila.IsSaving = false; // QUITAR SEGURO
            StateHasChanged();
        }
    }
}

