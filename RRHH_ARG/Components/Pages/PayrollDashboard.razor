    {
        empleadoSeleccionado = fila;
        estadoEditado = fila.Estado == "NO_REGISTRADO" ? "EN_PROCESO" : fila.Estado;
        showModal = true;
        isModalBusy = true;
        try
        {
            desgloseRecibo = await PayrollService.GetDesgloseParaEdicionAsync(fila.NomId);
        }
        finally { isModalBusy = false; StateHasChanged(); }
    }

    private void CerrarModal()
    {
        showModal = false;
        empleadoSeleccionado = null;
        desgloseRecibo = null;
    }

    private async Task GuardarModal()
    {
        if (isLocked) return;
        isModalBusy = true;
        try
        {
            await PayrollService.GuardarReciboAsync(empleadoSeleccionado.NomId, empleadoSeleccionado.DiasPagados, desgloseRecibo, estadoEditado);
            CerrarModal();
            await CargarNomina();
            await MostrarAvisoExitoAsync();
        }
        finally { isModalBusy = false; }
    }

    private async Task GuardarYSiguienteModal()
    {
        if (isLocked) return;
        isModalBusy = true;
        try
        {
            await PayrollService.GuardarReciboAsync(empleadoSeleccionado.NomId, empleadoSeleccionado.DiasPagados, desgloseRecibo, estadoEditado);
            int currentIndex = matrizNomina.FindIndex(m => m.NomId == empleadoSeleccionado.NomId);
            await CargarNomina();

            await MostrarAvisoExitoAsync();

            if (currentIndex >= 0 && currentIndex < matrizNomina.Count - 1)
                await AbrirModalEdicion(matrizNomina[currentIndex + 1]);
            else
                CerrarModal();
        }
        finally { isModalBusy = false; }
    }

    private async Task GuardarYAnteriorModal()
    {
        if (isLocked) return;
        isModalBusy = true;
        try
        {
            await PayrollService.GuardarReciboAsync(empleadoSeleccionado.NomId, empleadoSeleccionado.DiasPagados, desgloseRecibo, estadoEditado);
            int currentIndex = matrizNomina.FindIndex(m => m.NomId == empleadoSeleccionado.NomId);
            await CargarNomina();

            await MostrarAvisoExitoAsync();

            if (currentIndex > 0)
                await AbrirModalEdicion(matrizNomina[currentIndex - 1]);
            else
                CerrarModal();
        }
        finally { isModalBusy = false; }
    }

    // BOTÓN DE EXCLUIR EMPLEADO INDIVIDUAL
