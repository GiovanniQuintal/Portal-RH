@page "/admin-prioridades"
@using RRHH_ARG.Models
@using RRHH_ARG.Services
@using RRHH_ARG.Data
@using RRHH_ARG.Components.Pages.Reports

@inject EmpleadoService EmpleadoService
@inject PdService PdService
@inject AuthenticationStateProvider AuthStateProvider
@rendermode InteractiveServer
@inject IJSRuntime JS

@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "RH, HSE")]

@if (!isPrinting)
{
    <div class="container-fluid py-4">
        <div class="row">
            @* PANEL IZQUIERDO: BUSCADOR DE EMPLEADOS *@
            <div class="col-md-3 border-end">
                <h5 class="fw-bold text-dark mb-3">Plantel Global</h5>

                <div class="input-group mb-3 shadow-sm">
                    <input type="text" class="form-control" placeholder="Buscar por nombre..."
                           @bind="searchTerm" @bind:event="oninput" @onkeyup="FilterEmpleados" />
                    <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                </div>

                <div class="list-group overflow-auto shadow-sm" style="max-height: 75vh;">
                    @if (isLoadingList)
                    {
                        <div class="text-center p-4"><div class="spinner-border spinner-border-sm text-primary"></div></div>
                    }
                    else
                    {
                        @foreach (var emp in filteredEmpleados)
                        {
                            <button class="list-group-item list-group-item-action py-3 border-bottom @(selectedEmpId == emp.Id ? "active border-start border-4 border-primary bg-light" : "")"
                                    @onclick="() => SelectEmpleado(emp.Id)">
                                <div class="d-flex align-items-center">
                                    <div class="me-3 flex-shrink-0">
                                        <img src="/api/Archivo/@emp.Id/Foto"
                                             class="rounded-circle border shadow-sm bg-white"
                                             style="width: 45px; height: 45px; object-fit: cover;"
                                             onerror="this.onerror=null; this.src='https://ui-avatars.com/api/?name=@emp.ApellidoPaterno+@emp.Nombre&background=random&color=fff';"
                                             alt="@emp.Nombre" />
                                    </div>
                                    <div class="overflow-hidden text-start">
                                        <h6 class="mb-0 text-truncate fw-bold @(selectedEmpId == emp.Id ? "text-primary" : "text-dark")">@emp.Nombre @emp.ApellidoPaterno</h6>
                                        <small class="text-muted d-block text-truncate">@emp.Empleo</small>
                                    </div>
                                </div>
                            </button>
                        }
                        @if (!filteredEmpleados.Any())
                        {
                            <div class="p-4 text-center text-muted small">No se encontraron empleados.</div>
                        }
                    }
                </div>
            </div>

            @* PANEL DERECHO: GESTIÓN DE PRIORIDADES *@
            <div class="col-md-9 bg-light p-4 rounded-end">
                @if (selectedEmpId == 0)
                {
                    <div class="d-flex flex-column justify-content-center align-items-center h-100 text-muted">
                        <i class="bi bi-person-badge display-1 mb-3 opacity-25"></i>
                        <h3 class="fw-bold">Selecciona un empleado</h3>
                        <p>Como RH tienes permisos globales sobre los objetivos.</p>
                    </div>
                }
                else
                {
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div>
                            <h4 class="fw-bold text-primary mb-0" style="color:black;">Objetivos Individuales</h4>
                            <p class="text-muted small mb-0">Vista agrupada por Objetivos Globales @DateTime.Now.Year</p>
                        </div>

                        <div>
                            <button class="btn btn-danger btn-custom me-2" @onclick="ImprimirReporte" title="Generar PDF">
                                <i class="bi bi-file-earmark-pdf-fill"></i>
                            </button>
                            <button class="btn btn-primary shadow-sm" @onclick="NewPriority">
                                <i class="bi bi-plus-lg me-1"></i> Crear Tarea
                            </button>
                        </div>
                    </div>

                    @if (!prioritiesList.Any())
                    {
                        <div class="text-center py-5 bg-white rounded border border-dashed text-muted shadow-sm">
                            <i class="bi bi-list-check display-4 opacity-25"></i>
                            <p class="mt-3 mb-0">El empleado no tiene objetivos registrados.</p>
                        </div>
                    }
                    else
                    {
                        var unassignedPriorities = prioritiesList.Where(p => p.Indicator == null || p.Indicator.GlobalGoalId == 0).ToList();

                        @for (int i = 0; i < globalGoalsList.Count; i++)
                        {
                            var goal = globalGoalsList[i];
                            var goalPriorities = prioritiesList.Where(p => p.Indicator != null && p.Indicator.GlobalGoalId == goal.Id).ToList();

                            if (goalPriorities.Any())
                            {
                                string colColor = colorPalette[i % colorPalette.Length];

                                <div class="mb-4 shadow-sm rounded border overflow-hidden bg-white">
                                    <div class="p-3 text-white d-flex justify-content-between align-items-center" style="background-color: @colColor;">
                                        <h6 class="mb-0 fw-bold"><i class="bi bi-bullseye me-2"></i>@goal.Title</h6>
                                        <span class="badge bg-white text-dark rounded-pill shadow-sm">@goalPriorities.Count tareas</span>
                                    </div>

                                    <div class="p-0 bg-white">
                                        @{
                                            var indicatorsGroup = goalPriorities.GroupBy(p => p.Indicator).ToList();
                                        }
                                        @foreach (var indGroup in indicatorsGroup)
                                        {
                                            int indicatorId = indGroup.Key?.Id ?? -1;
                                            bool isExpanded = expandedIndicators.Contains(indicatorId);

                                            <div class="border-bottom">
                                                <div class="p-3 bg-light d-flex justify-content-between align-items-center cursor-pointer indicator-header hover-bg-gray" @onclick="() => ToggleIndicator(indicatorId)">
                                                    <div class="d-flex align-items-center fw-bold text-dark w-100">
                                                        <button class="btn btn-sm btn-light border rounded-circle p-0 me-3 d-flex justify-content-center align-items-center" style="width: 24px; height: 24px; transition: all 0.2s ease;">
                                                            <i class="bi @(isExpanded ? "bi-chevron-up text-primary" : "bi-chevron-down text-secondary")" style="font-size: 0.8rem;"></i>
                                                        </button>
                                                        <span class="fs-6 text-dark">@(indGroup.Key?.Title ?? "Sin Indicador asignado")</span>
                                                        <span class="badge bg-white text-secondary border ms-auto fw-normal shadow-sm">@indGroup.Count() tareas</span>
                                                    </div>
                                                </div>

                                                @if (isExpanded)
                                                {
                                                    <div class="table-responsive p-3 bg-white">
                                                        <table class="table align-middle mb-0 border shadow-sm rounded">
                                                            <thead class="table-light">
                                                                <tr>
                                                                    <th style="width: 30%;" class="ps-3 border-end">Tarea / Prioridad</th>
                                                                    <th style="width: 15%;" class="border-end text-center">Meta</th>
                                                                    <th style="width: 15%;" class="border-end text-center">Actual</th>
                                                                    <th style="width: 15%;" class="border-end text-center">Progreso</th>
                                                                    <th style="width: 10%; text-align:center;" class="border-end">Resultado</th>
                                                                    <th style="width: 15%;" class="text-center pe-3">Acción Admin</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                @foreach (var p in indGroup)
                                                                {
                                                                    <tr class="@(p == indGroup.Last() ? "border-bottom border-2" : "")">
                                                                        <td class="ps-3 border-end">
                                                                            <div class="fw-bold text-dark">@p.Title</div>
                                                                            <span class="badge bg-light text-secondary border mt-1">@p.Category</span>
                                                                        </td>
                                                                        <td class="text-center border-end">
                                                                            <span class="fw-bold">@p.TargetValue</span>
                                                                            <small class="text-muted d-block">@p.UnitOfMeasure</small>
                                                                            <i class="bi @(p.TrackingType == "MHB" ? "bi-graph-up-arrow text-success" : "bi-graph-down-arrow text-danger") ms-1" title="@(p.TrackingType == "MHB" ? "Más es Mejor" : "Menos es Mejor")"></i>
                                                                        </td>
                                                                        <td class="text-center border-end">
                                                                            <span class="text-primary fw-bold">@p.ActualValue</span>
                                                                        </td>
                                                                        <td class="border-end">
                                                                            @{
                                                                                int porcentaje = p.ProgressPercentage;
                                                                                string colorBarra = porcentaje >= 100 ? "bg-success" : (p.TrackingType == "MAB" ? "bg-danger" : (porcentaje >= 50 ? "bg-info" : "bg-warning"));
                                                                            }
                                                                            <div class="d-flex flex-column align-items-center w-100 px-2">
                                                                                <div class="progress w-100" style="height: 6px;">
                                                                                    <div class="progress-bar @colorBarra" role="progressbar" style="width: @Math.Min(porcentaje, 100)%"></div>
                                                                                </div>
                                                                                <small class="text-muted mt-1" style="font-size: 0.7rem;">@porcentaje%</small>
                                                                            </div>
                                                                        </td>
                                                                        <td class="text-center border-end">
                                                                            @if (p.FinalStatus == "Cumplió")
                                                                            {
                                                                                <span class="badge bg-success"><i class="bi bi-check-circle"></i> Cumplió</span>
                                                                            }
                                                                            else if (p.FinalStatus == "No Cumplió")
                                                                            {

                                                                                <span class="badge bg-danger"><i class="bi bi-x-circle"></i> No Cumplió</span>
                                                                            }
                                                                            else
                                                                            {

                                                                                <span class="badge bg-light text-muted border">Pendiente</span>
                                                                            }
                                                                        </td>
                                                                        <td class="text-center pe-3">
                                                                            <div class="d-flex justify-content-center align-items-center gap-2">
                                                                                

                                                                                <button class="btn btn-sm btn-link text-primary p-0 ms-2" @onclick="() => EditPriority(p)" title="Editar (Admin)">
                                                                                    <i class="bi bi-pencil-square fs-5"></i>
                                                                                </button>
                                                                                <button class="btn btn-sm btn-link text-danger p-0 ms-2" @onclick="() => ConfirmarEliminarPrioridad(p.Id)" title="Eliminar Permanentemente">
                                                                                    <i class="bi bi-trash fs-5"></i>
                                                                                </button>
                                                                            </div>
                                                                        </td>
                                                                    </tr>
                                                                }
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        }

                        @if (unassignedPriorities.Any())
                        {
                            <div class="mb-4 shadow-sm rounded border overflow-hidden bg-white">
                                <div class="p-3 text-white d-flex justify-content-between align-items-center bg-secondary">
                                    <h6 class="mb-0 fw-bold"><i class="bi bi-question-circle me-2"></i>Sin Objetivo Asignado</h6>
                                    <span class="badge bg-white text-dark rounded-pill shadow-sm">@unassignedPriorities.Count tareas</span>
                                </div>
                                <div class="p-0 bg-white">
                                    @{
                                        var orphanIndicatorsGroup = unassignedPriorities.GroupBy(p => p.Indicator).ToList();
                                    }
                                    @foreach (var indGroup in orphanIndicatorsGroup)
                                    {
                                        int indicatorId = indGroup.Key?.Id ?? -2; // -2 para diferenciar de los huerfanos normales si los hubiera
                                        bool isExpanded = expandedIndicators.Contains(indicatorId);

                                        <div class="border-bottom">
                                            <div class="p-3 bg-light d-flex justify-content-between align-items-center cursor-pointer indicator-header hover-bg-gray" @onclick="() => ToggleIndicator(indicatorId)">
                                                <div class="d-flex align-items-center fw-bold text-dark w-100">
                                                    <button class="btn btn-sm btn-light border rounded-circle p-0 me-3 d-flex justify-content-center align-items-center" style="width: 24px; height: 24px; transition: all 0.2s ease;">
                                                        <i class="bi @(isExpanded ? "bi-chevron-up text-primary" : "bi-chevron-down text-secondary")" style="font-size: 0.8rem;"></i>
                                                    </button>
                                                    <span class="fs-6 text-dark">@(indGroup.Key?.Title ?? "Tareas Generales")</span>
                                                    <span class="badge bg-white text-secondary border ms-auto fw-normal shadow-sm">@indGroup.Count() tareas</span>
                                                </div>
                                            </div>

                                            @if (isExpanded)
                                            {
                                                <div class="table-responsive p-3 bg-white">
                                                    <table class="table align-middle mb-0 border shadow-sm rounded">
                                                        <thead class="table-light">
                                                            <tr>
                                                                <th style="width: 30%;" class="ps-3 border-end">Tarea / Prioridad</th>
                                                                <th style="width: 15%;" class="border-end text-center">Meta</th>
                                                                <th style="width: 15%;" class="border-end text-center">Actual</th>
                                                                <th style="width: 15%;" class="border-end text-center">Progreso</th>
                                                                <th style="width: 10%; text-align:center;" class="border-end">Resultado</th>
                                                                <th style="width: 15%;" class="text-center pe-3">Acción Admin</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            @foreach (var p in indGroup)
                                                            {
                                                                <tr class="@(p == indGroup.Last() ? "border-bottom border-2" : "")">
                                                                    <td class="ps-3 border-end">
                                                                        <div class="fw-bold text-dark">@p.Title</div>
                                                                        <span class="badge bg-light text-secondary border mt-1">@p.Category</span>
                                                                    </td>
                                                                    <td class="text-center border-end">
                                                                        <span class="fw-bold">@p.TargetValue</span>
                                                                        <small class="text-muted d-block">@p.UnitOfMeasure</small>
                                                                        <i class="bi @(p.TrackingType == "MHB" ? "bi-graph-up-arrow text-success" : "bi-graph-down-arrow text-danger") ms-1" title="@(p.TrackingType == "MHB" ? "Más es Mejor" : "Menos es Mejor")"></i>
                                                                    </td>
                                                                    <td class="text-center border-end">
                                                                        <span class="text-primary fw-bold">@p.ActualValue</span>
                                                                    </td>
                                                                    <td class="border-end">
                                                                        @{
                                                                            int porcentaje = p.ProgressPercentage;
                                                                            string colorBarra = porcentaje >= 100 ? "bg-success" : (p.TrackingType == "MAB" ? "bg-danger" : (porcentaje >= 50 ? "bg-info" : "bg-warning"));
                                                                        }
                                                                        <div class="d-flex flex-column align-items-center w-100 px-2">
                                                                            <div class="progress w-100" style="height: 6px;">
                                                                                <div class="progress-bar @colorBarra" role="progressbar" style="width: @Math.Min(porcentaje, 100)%"></div>
                                                                            </div>
                                                                            <small class="text-muted mt-1" style="font-size: 0.7rem;">@porcentaje%</small>
                                                                        </div>
                                                                    </td>
                                                                    <td class="text-center border-end">
                                                                        @if (p.FinalStatus == "Cumplió")
                                                                        {
                                                                            <span class="badge bg-success"><i class="bi bi-check-circle"></i> Cumplió</span>
                                                                        }
                                                                        else if (p.FinalStatus == "No Cumplió")
                                                                        {

                                                                            <span class="badge bg-danger"><i class="bi bi-x-circle"></i> No Cumplió</span>
                                                                        }
                                                                        else
                                                                        {

                                                                            <span class="badge bg-light text-muted border">Pendiente</span>
                                                                        }
                                                                    </td>
                                                                    <td class="text-center pe-3">
                                                                        <div class="d-flex justify-content-center align-items-center gap-2">
                                                                            

                                                                            <button class="btn btn-sm btn-link text-primary p-0 ms-2" @onclick="() => EditPriority(p)" title="Editar (Admin)">
                                                                                <i class="bi bi-pencil-square fs-5"></i>
                                                                            </button>
                                                                            <button class="btn btn-sm btn-link text-danger p-0 ms-2" @onclick="() => ConfirmarEliminarPrioridad(p.Id)" title="Eliminar Permanentemente">
                                                                                <i class="bi bi-trash fs-5"></i>
                                                                            </button>
                                                                        </div>
                                                                    </td>
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </table>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    }
                }
            </div>
        </div>
    </div>

    @* MODAL DE PRIORIDAD (Versión Admin) *@
    @if (showPriorityModal)
    {
        <div class="modal d-block" style="background: rgba(0,0,0,0.5); backdrop-filter: blur(2px);">
            <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
                <div class="modal-content border-0 shadow-lg">
                    <div class="modal-header bg-danger text-white">
                        <h5 class="modal-title">
                            <i class="bi bi-shield-lock-fill me-2"></i> Administración del Objetivo Individual
                        </h5>
                        <button class="btn-close btn-close-white" @onclick="() => showPriorityModal = false"></button>
                    </div>

                    <div class="modal-body p-4 bg-light">

                        <div class="alert alert-warning small border-warning">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            <strong>Modo RH:</strong> Tienes permisos totales para editar todos los campos, incluso si el objetivo ya fue aprobado.
                        </div>

                        @* SECCIÓN 1: ALINEACIÓN *@
                        <div class="card mb-4 border-0 shadow-sm">
                            <div class="card-header bg-white fw-bold text-primary border-bottom-0">
                                1. Alineación con la Empresa
                            </div>
                            <div class="card-body pt-0">
                                <div class="row g-3">
                                    <div class="card mb-3 border-0 shadow-sm">
                                        <div class="card-header bg-white fw-bold text-primary border-bottom-0">
                                            1. Objetivo Global (Alineación)
                                        </div>
                                        <div class="card-body pt-0">
                                            <select class="form-select border-start border-4 border-primary"
                                                    value="@selectedGoalIdModal"
                                                    @onchange="OnGoalChanged">
                                                <option value="">-- Selecciona un Objetivo --</option>
                                                @foreach (var goal in globalGoalsList)
                                                {
                                                    <option value="@goal.Id">@goal.Title</option>
                                                }
                                            </select>
                                            @if (selectedGoalIdModal > 0)
                                            {
                                                var selectedGoal = globalGoalsList.FirstOrDefault(g => g.Id == selectedGoalIdModal);
                                                if (selectedGoal != null && !string.IsNullOrWhiteSpace(selectedGoal.Description))
                                                {
                                                    <div class="mt-2 p-2 rounded shadow-sm border" style="background-color: #e0f2fe; border-color: #bae6fd;">
                                                        <div class="d-flex align-items-start">
                                                            <i class="bi bi-info-circle-fill text-primary fs-6 me-2 mt-1"></i>
                                                            <div><p class="mb-0 text-dark small">@selectedGoal.Description</p></div>
                                                        </div>
                                                    </div>
                                                }
                                            }
                                        </div>
                                    </div>

                                    <div class="card mb-3 border-0 shadow-sm">
                                        <div class="card-header bg-white fw-bold text-info border-bottom-0">
                                            2. Indicador (KPI)
                                        </div>
                                        <div class="card-body pt-0">
                                            <select class="form-select border-start border-4 border-info"
                                                    @bind="editingPriority.IndicatorId"
                                                    disabled="@(!availableIndicators.Any())">
                                                <option value="">-- Selecciona un Indicador --</option>
                                                @foreach (var ind in availableIndicators)
                                                {
                                                    <option value="@ind.Id">@ind.Title</option>
                                                }
                                            </select>
                                            @if (editingPriority.IndicatorId > 0)
                                            {
                                                var selectedInd = availableIndicators.FirstOrDefault(i => i.Id == editingPriority.IndicatorId);
                                                if (selectedInd != null && !string.IsNullOrWhiteSpace(selectedInd.Description))
                                                {
                                                    <div class="mt-2 p-2 rounded shadow-sm border" style="background-color: #f0fdf4; border-color: #bbf7d0;">
                                                        <div class="d-flex align-items-start">
                                                            <i class="bi bi-lightbulb-fill text-success fs-6 me-2 mt-1"></i>
                                                            <div><p class="mb-0 text-dark small">@selectedInd.Description</p></div>
                                                        </div>
                                                    </div>
                                                }
                                            }
                                        </div>
                                    </div>

                                    <div class="card mb-3 border-0 shadow-sm">
                                        <div class="card-header bg-white fw-bold text-dark border-bottom-0">
                                            3. Definición de la Tarea
                                        </div>
                                        <div class="card-body pt-0">
                                            <div class="row g-3">
                                                <div class="col-md-8">
                                                    <label class="form-label fw-bold small">Nombre de la Tarea</label>
                                                    <input class="form-control" @bind="editingPriority.Title" />
                                                </div>
                                                <div class="col-md-4">
                                                    <label class="form-label small">Categoría</label>
                                                    <select class="form-select" @bind="editingPriority.Category">
                                                        <option value="">-- Seleccionar --</option>
                                                        <option>QHSE</option>
                                                        <option>Ventas</option>
                                                        <option>RH</option>
                                                        <option>Manufactura</option>
                                                        <option>D&D</option>
                                                        <option>Operaciones</option>
                                                        <option>Administración y Finanzas</option>
                                                    </select>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="card mb-3 border-0 shadow-sm">
                                        <div class="card-header bg-white fw-bold text-success border-bottom-0">
                                            4. Métricas y Medición
                                        </div>
                                        <div class="card-body pt-0">
                                            <div class="mb-4 p-3 bg-light rounded border">
                                                <label class="form-label fw-bold small text-muted mb-2">Comportamiento de la Métrica</label>
                                                <div class="d-flex gap-4">
                                                    <div class="form-check">
                                                        <input class="form-check-input" type="radio" name="track_admin" id="mhb_adm" value="MHB" @onchange='() => editingPriority.TrackingType = "MHB"' checked="@(editingPriority.TrackingType == "MHB")">
                                                        <label class="form-check-label fw-bold text-dark" for="mhb_adm"><i class="bi bi-graph-up-arrow text-success me-1"></i> Más es Mejor</label>
                                                    </div>
                                                    <div class="form-check">
                                                        <input class="form-check-input" type="radio" name="track_admin" id="mab_adm" value="MAB" @onchange='() => editingPriority.TrackingType = "MAB"' checked="@(editingPriority.TrackingType == "MAB")">
                                                        <label class="form-check-label fw-bold text-dark" for="mab_adm"><i class="bi bi-graph-down-arrow text-danger me-1"></i> Menos es Mejor</label>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="row g-3 align-items-end">
                                                <div class="col-md-4">
                                                    <label class="form-label fw-bold text-success small">Meta (Target)</label>
                                                    <input type="number" class="form-control" @bind="editingPriority.TargetValue" disabled="@(editingPriority.UnitOfMeasure == "Cursos")" />
                                                </div>

                                                <div class="col-md-4">
                                                    <label class="form-label small">Unidad</label>
                                                    <select class="form-select" @bind="editingPriority.UnitOfMeasure">
                                                        <option value="">-- Seleccionar --</option>
                                                        <option value="Unidades">Unidades</option>
                                                        <option value="%">Porcentaje (%)</option>
                                                        <option value="Tarjetas">Tarjetas</option>
                                                        <option value="Cursos">Cursos</option>
                                                        <option value="Horas">Horas</option>
                                                        <option value="Días">Días</option>
                                                        <option value="MXN">Pesos (MXN)</option>
                                                        <option value="USD">Dólares (USD)</option>
                                                    </select>
                                                </div>

                                                <div class="col-md-4">
                                                    <label class="form-label fw-bold text-primary small">Logrado (Actual)</label>
                                                    <input type="number" class="form-control" @bind="editingPriority.ActualValue" disabled="@(editingPriority.UnitOfMeasure == "Cursos")" />
                                                </div>
                                            </div>

                                            <div class="mt-4">
                                                <label class="small text-muted mb-1">Progreso Calculado</label>
                                                <div class="progress" style="height: 25px;">
                                                    @{
                                                        int porcentajeModal = editingPriority.ProgressPercentage;
                                                        string colorModal = porcentajeModal >= 100 ? "bg-success" : (editingPriority.TrackingType == "MAB" ? "bg-danger" : (porcentajeModal >= 50 ? "bg-info" : "bg-warning"));
                                                    }
                                                    <div class="progress-bar @colorModal progress-bar-striped progress-bar-animated" role="progressbar" style="width: @(Math.Min(porcentajeModal, 100))%;">
                                                        @porcentajeModal%
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="mt-3">
                                                <label class="form-label small">Notas de Cierre</label>
                                                <input class="form-control" @bind="editingPriority.Notes" />
                                            </div>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer bg-white position-relative">
                        <button class="btn btn-light" @onclick="() => showPriorityModal = false">Cancelar</button>
                        <button class="btn btn-danger px-4 shadow-sm" @onclick="SavePriorityAsAdmin">
                            <i class="bi bi-save me-2"></i> Guardar Cambios (Forzar)
                        </button>

                        @* NOTIFICACIÓN DE ERROR DENTRO DEL MODAL *@
                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="position-fixed top-0 end-0 p-4" style="z-index: 2060;">
                                <div class="toast show align-items-center text-white bg-danger border-0 shadow-lg" role="alert">
                                    <div class="d-flex p-2">
                                        <div class="toast-body fs-6">
                                            <i class="bi bi-exclamation-triangle-fill me-2"></i> @errorMessage
                                        </div>
                                        <button type="button" class="btn-close btn-close-white me-2 m-auto" @onclick='() => errorMessage = ""'></button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
}
else
{
    string[] pastelPaletteReport = new[]
    {
        "#e3f2fd", // Azul pastel suave
        "#e8f5e9", // Verde pastel suave
        "#fffde7", // Amarillo pastel suave
        "#fff3e0", // Naranja pastel suave
        "#f3e5f5", // Morado pastel suave
        "#ffebee"  // Rojo pastel suave
    };

    int pastelIdx = 0;

    <div id="ReporteEquipo-pdf">
        <PlantillaReporte Titulo="@($"Informe de Desempeño - {empleadoActual?.Nombre} {empleadoActual?.ApellidoPaterno}")"
                          EsHorizontal="true"
                          Usuario="@nombreDeLogin">
            <CabecerasTabla>
                <th style="width: 20%; border: 1px solid #dee2e6;">Objetivo Global</th>
                <th style="width: 20%; border: 1px solid #dee2e6;">Indicador</th>
                <th style="width: 35%; border: 1px solid #dee2e6;">Tarea / Prioridad</th>
                <th style="width: 10%; text-align:center; border: 1px solid #dee2e6;">Meta</th>
                <th style="width: 7%; text-align:center; border: 1px solid #dee2e6;">Actual</th>
                <th style="width: 8%; text-align:center; border: 1px solid #dee2e6;">Avance</th>
            </CabecerasTabla>

            <CuerpoTabla>
                @if (globalGoalsList != null && prioritiesList != null)
                {
                    @foreach (var goal in globalGoalsList)
                    {
                        var goalPriorities = prioritiesList.Where(p => p.Indicator != null && p.Indicator.GlobalGoalId == goal.Id && !p.IsArchived).ToList();
                        if (!goalPriorities.Any()) continue;

                        string pastelColor = pastelPaletteReport[pastelIdx % pastelPaletteReport.Length];
                        pastelIdx++;

                        var indicatorsGroup = goalPriorities.GroupBy(p => p.Indicator).ToList();
                        bool firstGoalRow = true;

                        @foreach (var indGroup in indicatorsGroup)
                        {
                            var indPriorities = indGroup.ToList();
                            bool firstIndRow = true;

                            @foreach (var p in indPriorities)
                            {
                                bool isLastInGroup = (p == indPriorities.Last());
                                bool isLastInGoal = (indGroup.Key == indicatorsGroup.Last().Key && isLastInGroup);

                                <tr style="background-color: @pastelColor; page-break-inside: avoid; break-inside: avoid;">

                                    <td class="align-middle" style="background-color: @pastelColor; border-left: 1px solid #dee2e6; border-right: 1px solid #dee2e6; border-top: @(firstGoalRow ? "1px solid #dee2e6" : "none"); border-bottom: @(isLastInGoal ? "1px solid #dee2e6" : "none"); padding: 10px;">
                                        @if (firstGoalRow)
                                        {
                                            <div class="fw-bold text-dark">@goal.Title</div>
                                            <div class="small text-muted mt-1">@goal.Description</div>
                                        }
                                    </td>

                                    <td class="align-middle fw-semibold text-primary" style="background-color: @pastelColor; border-left: 1px solid #dee2e6; border-right: 1px solid #dee2e6; border-top: @(firstIndRow ? "1px solid #dee2e6" : "none"); border-bottom: @(isLastInGroup ? "1px solid #dee2e6" : "none"); padding: 10px;">
                                        @if (firstIndRow)
                                        {
                                            @(indGroup.Key?.Title ?? "Sin Indicador")
                                        }
                                    </td>

                                    <td class="align-middle fw-bold" style="border: 1px solid #dee2e6;">@p.Title</td>
                                    <td class="align-middle text-center" style="border: 1px solid #dee2e6;">
                                        <span class="fw-bold">@p.TargetValue</span><br>
                                        <small class="text-muted">@p.UnitOfMeasure</small>
                                    </td>
                                    <td class="align-middle text-center" style="border: 1px solid #dee2e6;">
                                        <span class="text-primary fw-bold">@p.ActualValue</span>
                                    </td>
                                    <td class="align-middle text-center" style="border: 1px solid #dee2e6;">
                                        <div class="progress mt-1" style="height: 10px; background-color: rgba(255,255,255,0.5);">
                                            <div class="progress-bar @(p.ProgressPercentage >= 100 ? "bg-success" : "bg-primary")" style="width: @Math.Min(p.ProgressPercentage, 100)%"></div>
                                        </div>
                                        <small class="text-muted mt-1 d-block" style="font-size: 10px;">@p.ProgressPercentage%</small>
                                    </td>
                                </tr>
                                firstGoalRow = false;
                                firstIndRow = false;
                            }
                        }
                    }

                    var orphanPriorities = prioritiesList.Where(p => (p.Indicator == null || p.Indicator.GlobalGoalId == 0) && !p.IsArchived).ToList();

                    if (orphanPriorities.Any())
                    {
                        bool firstOrphanRow = true;
                        string orphanColor = "#f1f3f5";

                        @foreach (var p in orphanPriorities)
                        {
                            bool isLastOrphan = (p == orphanPriorities.Last());
                            <tr style="background-color: @orphanColor; page-break-inside: avoid; break-inside: avoid;">

                                <td colspan="2" class="align-middle fw-bold text-muted text-center" style="background-color: @orphanColor; border-left: 1px solid #dee2e6; border-right: 1px solid #dee2e6; border-top: @(firstOrphanRow ? "1px solid #dee2e6" : "none"); border-bottom: @(isLastOrphan ? "1px solid #dee2e6" : "none");">
                                    @if (firstOrphanRow)
                                    {
                                        <span>Tareas sin Objetivo Asignado</span>
                                    }
                                </td>

                                <td class="align-middle fw-bold" style="border: 1px solid #dee2e6;">@p.Title</td>
                                <td class="align-middle text-center" style="border: 1px solid #dee2e6;">
                                    <span class="fw-bold">@p.TargetValue</span><br>
                                    <small class="text-muted">@p.UnitOfMeasure</small>
                                </td>
                                <td class="align-middle text-center" style="border: 1px solid #dee2e6;">
                                    <span class="text-primary fw-bold">@p.ActualValue</span>
                                </td>
                                <td class="align-middle text-center" style="border: 1px solid #dee2e6;">
                                    <div class="progress mt-1" style="height: 10px; background-color: rgba(255,255,255,0.5);">
                                        <div class="progress-bar @(p.ProgressPercentage >= 100 ? "bg-success" : "bg-primary")" style="width: @Math.Min(p.ProgressPercentage, 100)%"></div>
                                    </div>
                                    <small class="text-muted mt-1 d-block" style="font-size: 10px;">@p.ProgressPercentage%</small>
                                </td>
                            </tr>
                            firstOrphanRow = false;
                        }
                    }
                }
            </CuerpoTabla>
        </PlantillaReporte>
    </div>
}

@code {
    // --- PALETA DE COLORES ---
    private readonly string[] colorPalette = new[]
    {
        "#024A86", // Azul
        "#02AC66", // Verde
        "#23BAC4", // Turquesa
        "#E36B2C", // Naranja
        "#C82A54", // Guinda/Rosa oscuro
        "#8C4966"  // Morado tenue/Marrón
    };

    // --- ESTADO COLAPSABLES (Indicadores) ---
    private HashSet<int> expandedIndicators = new();

    private void ToggleIndicator(int indicatorId)
    {
        if (expandedIndicators.Contains(indicatorId))
        {
            expandedIndicators.Remove(indicatorId);
        }
        else
        {
            expandedIndicators.Add(indicatorId);
        }
    }

    private string searchTerm = "";
    private bool isLoadingList = true;
    private List<EmpleadoViewModel> allEmpleados = new();
    private List<EmpleadoViewModel> filteredEmpleados = new();
    private int selectedEmpId = 0;
    private List<PdPriority> prioritiesList = new();

    // Variables Modal
    private bool showPriorityModal = false;
    private string errorMessage = "";
    private PdPriority editingPriority = new();
    private List<PdGlobalGoal> globalGoalsList = new();
    private int selectedGoalIdModal = 0;
    private List<PdIndicator> availableIndicators = new();
    private bool showSuccessMessage = false;

    private bool isPrinting = false;
    private EmpleadoViewModel? empleadoActual;
    private string nombreDeLogin = "Administrador";

    private async Task OnGoalChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int goalId))
        {
            selectedGoalIdModal = goalId;
            availableIndicators = await PdService.GetIndicatorsByGoalAsync(goalId);
            editingPriority.IndicatorId = null;
        }
        else
        {
            availableIndicators.Clear();
            editingPriority.IndicatorId = null;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity != null && authState.User.Identity.IsAuthenticated)
        {
            nombreDeLogin = authState.User.Identity.Name ?? "Administrador";
        }

        // Cargar empleados
        allEmpleados = await EmpleadoService.GetAllEmpleadosAsync();
        filteredEmpleados = allEmpleados.Take(20).ToList();

        // Cargar los objetivos globales para el dropdown del modal
var rawGoals = await PdService.GetAllGlobalGoalsAsync(DateTime.Now.Year);
globalGoalsList = rawGoals.OrderBy(g => g.Id).ToList();

        isLoadingList = false;
    }

    private void FilterEmpleados()
    {
        if (string.IsNullOrWhiteSpace(searchTerm))
            filteredEmpleados = allEmpleados.Take(20).ToList();
        else
            filteredEmpleados = allEmpleados
                .Where(e => e.Nombre.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)
                         || e.ApellidoPaterno.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
                .ToList();
    }

    private async Task SelectEmpleado(int id)
    {
        selectedEmpId = id;
        empleadoActual = await EmpleadoService.GetEmpleadoByIdAsync(id);

        expandedIndicators.Clear();

        await ReloadPriorities();
    }

    private async Task ReloadPriorities()
    {
        prioritiesList = await PdService.GetPrioritiesAsync(selectedEmpId, DateTime.Now.Year, true);
    }

    private async Task UnlockPriority(PdPriority p)
    {
        await PdService.UnlockPriorityAsync(p.Id);
        await ReloadPriorities();
    }

    private async Task ImprimirReporte()
    {
        isPrinting = true;
        StateHasChanged();

        await Task.Delay(300);

        await JS.InvokeVoidAsync("descargarPDF", "ReporteEquipo-pdf", $"KPIs_{empleadoActual?.Nombre}.pdf", "landscape");

        isPrinting = false;
        StateHasChanged();
    }

    private void NewPriority()
    {
        errorMessage = ""; // Limpiamos error al abrir nuevo
        editingPriority = new PdPriority
        {
            EmpId = selectedEmpId,
            Year = DateTime.Now.Year,
            UnitOfMeasure = "",
            TargetValue = 0,
            ActualValue = 0,
            Category = "",
            IsSubmitted = true,
            IsApproved = true,
            StartDate = new DateTime(DateTime.Now.Year, 1, 1),
            EndDate = new DateTime(DateTime.Now.Year, 12, 31)
        };
        showPriorityModal = true;
    }

    private async Task EditPriority(PdPriority p)
    {
        errorMessage = "";
        editingPriority = new PdPriority
        {
            Id = p.Id,
            EmpId = p.EmpId,
            Year = p.Year,
            Title = p.Title,
            Description = p.Description,
            Category = p.Category,
            IndicatorId = p.IndicatorId,
            TrackingType = p.TrackingType ?? "MHB",
            StartDate = p.StartDate,
            EndDate = p.EndDate,
            TargetValue = p.TargetValue,
            ActualValue = p.ActualValue,
            UnitOfMeasure = p.UnitOfMeasure,
            Notes = p.Notes,
            IsSubmitted = p.IsSubmitted,
            IsApproved = p.IsApproved,
            IsArchived = p.IsArchived,
            ReadyForReview = p.ReadyForReview,
            CreatedAt = p.CreatedAt
        };

        if (p.Indicator != null)
        {
            selectedGoalIdModal = p.Indicator.GlobalGoalId;
            availableIndicators = await PdService.GetIndicatorsByGoalAsync(selectedGoalIdModal);
        }
        else
        {
            selectedGoalIdModal = 0;
            availableIndicators.Clear();
        }

        showPriorityModal = true;
    }

    private async Task SavePriorityAsAdmin()
    {
        errorMessage = "";

        if (selectedGoalIdModal == 0)
        {
            errorMessage = "El Objetivo Global es obligatorio. Por favor selecciona uno.";
            return;
        }
        if (editingPriority.IndicatorId == null || editingPriority.IndicatorId == 0)
        {
            errorMessage = "El Indicador es obligatorio. Por favor selecciona uno.";
            return;
        }
        if (string.IsNullOrWhiteSpace(editingPriority.Title))
        {
            errorMessage = "El Nombre de la Prioridad no puede estar vacío.";
            return;
        }
        if (string.IsNullOrWhiteSpace(editingPriority.Category) || editingPriority.Category == "----------")
        {
            errorMessage = "Debe seleccionar una Categoría válida.";
            return;
        }
        if (string.IsNullOrWhiteSpace(editingPriority.UnitOfMeasure))
        {
            errorMessage = "Debe seleccionar una Unidad de medida.";
            return;
        }

        if (editingPriority.UnitOfMeasure != "Cursos")
        {
            if (editingPriority.TrackingType == "MHB" && editingPriority.TargetValue <= 0)
            {
                errorMessage = "Para métricas de 'Más es Mejor', la Meta (Target) debe ser mayor a 0.";
                return;
            }
            else if (editingPriority.TrackingType == "MAB" && editingPriority.TargetValue < 0)
            {
                errorMessage = "Para métricas de 'Menos es Mejor', la Meta no puede ser negativa.";
                return;
            }
        }

        await PdService.SavePriorityAsync(editingPriority);
        showPriorityModal = false;
        await ReloadPriorities();
    }

    private async Task ConfirmarEliminarPrioridad(int id)
    {
        bool confirmado = await JS.InvokeAsync<bool>("confirm", "¿Estás seguro de que deseas eliminar permanentemente esta tarea/prioridad? Esta acción no se puede deshacer.");

        if (confirmado)
        {
            await PdService.DeletePriorityAsync(id);

            errorMessage = "";
            showSuccessMessage = true;

            await ReloadPriorities();
            StateHasChanged();

            await Task.Delay(3000);
            showSuccessMessage = false;
            StateHasChanged();
        }
    }
}

<style>
    .btn-custom {
        padding: 0.5rem 1rem;
        font-size: 0.8rem;
    }

    .cursor-pointer {
        cursor: pointer;
    }

    .hover-bg-gray:hover {
        background-color: #f1f3f5 !important;
    }

    /* REGLAS ESTRICTAS PARA GENERACIÓN DEL PDF / IMPRESIÓN */
    @@media print {
        /* Evita que una fila se corte a la mitad entre dos páginas */
        tr, td, th {
            page-break-inside: avoid !important;
            break-inside: avoid !important;
        }
        /* Fuerza a que el encabezado de la tabla se repita en páginas nuevas */
        thead {
            display: table-header-group !important;
        }
        /* Evita problemas de solapamiento en las tablas */
        table {
            page-break-inside: auto !important;
            border-collapse: collapse !important;
        }

        #ReporteEquipo-pdf {
            width: 100% !important;
            display: block !important;
        }
    }
</style>