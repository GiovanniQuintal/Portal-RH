    }

    private void CambiarZoom(double delta) { Escala += delta; if (Escala < 0.1) Escala = 0.1; if (Escala > 3.0) Escala = 3.0; }
    private void ResetZoom() { Escala = 1.0; }
    private void ForzarRefresco() { Diagram.Refresh(); StateHasChanged(); }

