@page "/organigrama"
@using Blazor.Diagrams
@using Blazor.Diagrams.Core.Geometry
@using Blazor.Diagrams.Models
@using Blazor.Diagrams.Core.Models
@using Blazor.Diagrams.Components
@using RRHH_ARG.Data
@using RRHH_ARG.Models
@using Microsoft.EntityFrameworkCore
@using System.Globalization

@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject ApplicationDbContext Context

<style>
    /* CONTENEDOR PRINCIPAL */
    .contenedor-scroll {
        width: 100%;
        height: 85vh;
        overflow: auto;
        background-color: #e9ecef;
        border: 1px solid #ccc;
        position: relative;
        display: block;
        /* Habilita el "scroll con inercia" suave en iPhones y celulares */
        -webkit-overflow-scrolling: touch;
    }

    /* LIENZO DINÁMICO */
    .lienzo-dinamico {
        position: relative;
        background-color: #f9f9f9;
        background-image: linear-gradient(#e5e5e5 1px, transparent 1px), linear-gradient(90deg, #e5e5e5 1px, transparent 1px);
        background-size: 20px 20px;
        display: block;
        transform-origin: 0 0;
        transition: transform 0.2s ease-out;
    }

    /* BARRA DE HERRAMIENTAS - DISEÑO PC */
    .toolbar-zoom {
        position: fixed;
        bottom: 35px;
        right: 50px;
        background: rgba(255, 255, 255, 0.95);
        padding: 5px 10px;
        border-radius: 8px;
        box-shadow: 0 4px 8px rgba(0,0,0,0.2);
        z-index: 1000;
        display: flex;
        gap: 5px;
        border: 1px solid #ccc;
        align-items: center;
        font-size: 0.8rem;
    }

    /* LIMPIEZA LIBRERÍA */
    ::deep .diagram-canvas {
        width: 100% !important;
        height: 100% !important;
        overflow: visible !important;
        outline: none;
        pointer-events: none !important;
        touch-action: pan-x pan-y !important;
    }

    ::deep .diagram-link, ::deep .link-vertex, ::deep g.link, ::deep .diagram-link-marker, ::deep .port, ::deep .link-label {
        display: none !important;
    }

    ::deep .card-node {
        pointer-events: none !important;
    }

    /* LÍNEAS */
    .lineas-organigrama {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        z-index: 1;
    }

        .lineas-organigrama path {
            stroke: #666;
            stroke-width: 1px;
            fill: none;
        }

    ::deep svg.diagram {
        z-index: 2;
        position: relative;
        overflow: visible !important;
    }

    /* ========================================= */
    /*  REGLAS RESPONSIVE PARA CELULARES     */
    /* ========================================= */
    @@media (max-width: 768px) {
        /* 1. Ajustar el encabezado para que no se aplaste */
        .header-organigrama {
            flex-direction: column;
            align-items: flex-start !important;
            gap: 10px;
            padding: 10px !important;
        }
            /* 2. El botón recargar ocupa el 100% del ancho en móvil */
            .header-organigrama button {
                width: 100%;
            }
        /* 3. Ajustar altura del contenedor para dar espacio */
        .contenedor-scroll {
            height: 75vh;
        }
        /* 4. Mover la barra de zoom al centro y hacerla táctil */
        .toolbar-zoom {
            position: fixed; /*  También fixed en celulares  */
            left: 50%;
            transform: translateX(-50%);
            bottom: 25px;
            padding: 8px 5px;
            gap: 10px;
            border-radius: 10px;
        }
            /* 5. Botones de zoom más grandes para "dedos gordos" */
            .toolbar-zoom button {
                padding: 8px 15px !important;
                font-size: 1.1rem;
            }
    }
</style>

<div class="container-fluid p-0 d-flex flex-column h-100">
    <div class="header-organigrama p-3 bg-white border-bottom shadow-sm d-flex justify-content-between align-items-center">
        <div>
            <h4 class="m-0 text-dark" style="font-size: 1.1rem;"><i class="bi bi-diagram-3"></i> Organigrama</h4>
            <small class="text-muted" style="font-size: 0.75rem;">Zoom: @(Math.Round(Escala * 100))%</small>
        </div>
        <button class="btn btn-outline-secondary btn-sm" @onclick="ForzarRefresco" style="font-size: 0.8rem;">
            <i class="bi bi-arrow-clockwise"></i> Recargar
        </button>
    </div>

    <div class="contenedor-scroll">
        <div class="lienzo-dinamico"
             style="width: @((int)anchoTotal)px; height: @((int)altoTotal)px; transform: scale(@Escala);">
            <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 9999;"></div>
             <svg class="lineas-organigrama">
                @foreach (var linea in lineas)
                {
                    <path d="@linea" />
                }
            </svg>
            <CascadingValue Value="Diagram">
                <DiagramCanvas></DiagramCanvas>
            </CascadingValue>
        </div>
        <div class="toolbar-zoom">
            <button class="btn btn-sm btn-light border py-0 px-2" @onclick="() => CambiarZoom(-0.1)">-</button>
            <span style="min-width: 35px; text-align: center; font-weight: bold;">@((int)(Escala * 100))%</span>
            <button class="btn btn-sm btn-light border py-0 px-2" @onclick="() => CambiarZoom(0.1)">+</button>
            <div class="vr mx-1"></div>
            <button class="btn btn-sm btn-light border py-0 px-2 text-danger" @onclick="ResetZoom">100%</button>
        </div>
    </div>
</div>

@code {
