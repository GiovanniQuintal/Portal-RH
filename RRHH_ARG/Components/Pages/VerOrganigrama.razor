    private async Task CargarYConstruir()
    {
        try
        {
            var raw = await Context.Empleados.AsNoTracking().Include(e => e.Per).ThenInclude(p => p.Pep).Where(e => e.StaId == 1).ToListAsync();
            datosBD = raw.Select(e => new NodoDatos
            {
                Id = e.EmpId,
                JefeId = (e.SupId == 0) ? null : e.SupId,
                Nombre = e.Per != null ? $"{e.Per.PerNombre} {e.Per.PerApellidoPaterno}" : "Vacante",
                Puesto = e.Per?.Pep?.PepNombre ?? "S/P"
            }).ToList();

            // ==========================================================
            // NUEVO: FILTRO PARA ELIMINAR NODOS AISLADOS (SIN ASCENDIENTES NI DESCENDIENTES)
            // ==========================================================

            // 1. Obtenemos todos los IDs válidos que trajimos de la BD
            var todosLosIds = datosBD.Select(x => x.Id).ToHashSet();

            // 2. Obtenemos los IDs de los empleados que son jefes de alguien (relación descendiente)
            var idsJefes = datosBD.Where(x => x.JefeId.HasValue && todosLosIds.Contains(x.JefeId.Value))
                                  .Select(x => x.JefeId.Value)
                                  .ToHashSet();

            // 3. Filtramos la lista: te quedas si tienes jefe válido O si eres jefe de alguien
            datosBD = datosBD.Where(e =>
                (e.JefeId.HasValue && todosLosIds.Contains(e.JefeId.Value)) || // Tiene un jefe válido
                idsJefes.Contains(e.Id)                                        // Es jefe de alguien
            ).ToList();

            // ==========================================================

            Diagram.Nodes.Clear(); nodosMap.Clear(); lineas.Clear(); anchoTotal = 0; altoTotal = 0;

            // Al actualizar datosBD, volvemos a sacar la lista de IDs actualizada
            var ids = datosBD.Select(x => x.Id).ToHashSet();

            // Y de aquí en adelante, tu código original sigue igual...
            var jefesRaiz = datosBD.Where(x => x.JefeId == null || !ids.Contains(x.JefeId.Value)).ToList();
            var gruposRaiz = jefesRaiz.GroupBy(x => x.Puesto).ToList();

            double cursorX = MARGEN_IZQUIERDO_INICIAL;
            foreach (var grupo in gruposRaiz)
            {
                var lista = grupo.ToList();
                int columnas = CalcularAnchoColumnasGrupo(lista);
                double anchoPx = columnas * (ANCHO_NODO + GAP_X);
                double centro = cursorX + (anchoPx / 2) - (ANCHO_NODO / 2);

                CrearRamaAgrupada(lista, centro, 50);
                cursorX += anchoPx + GAP_X;
            }

            CrearLineasSVG();
            anchoTotal += 100; altoTotal += 100;
        }
        catch (Exception ex) { Console.WriteLine($"Error: {ex.Message}"); }
    }

    private CardNode CrearRamaAgrupada(List<NodoDatos> grupo, double x, double y)
    {
        string puesto = grupo.First().Puesto;
        List<string> nombres = grupo.Select(e => e.Nombre).ToList();

        // --- CÁLCULO DE ALTURA SINCRONIZADO CON CARDWIDGET ---
        // 1. Estimar líneas del título (Misma lógica que el widget)
        int len = puesto.Length;
        int lineasTitulo = 1;
        if (len > 14) lineasTitulo = 2;
        if (len > 28) lineasTitulo = 3;
        double hHeader = (lineasTitulo * 10) + 6;

        // 2. Altura Total
        double altura = hHeader + (nombres.Count * 9) + 5;
        if (altura < 32) altura = 32;
        // -----------------------------------------------------

        if ((x + ANCHO_NODO) > anchoTotal) anchoTotal = x + ANCHO_NODO;
        if ((y + altura) > altoTotal) altoTotal = y + altura;

        var nodo = new CardNode(puesto, nombres, new Point(x, y));
        nodo.Size = new Size(ANCHO_NODO, altura);
        nodo.Locked = true;
        Diagram.Nodes.Add(nodo);

        foreach (var emp in grupo) { if (!nodosMap.ContainsKey(emp.Id)) nodosMap[emp.Id] = nodo; }

        var idsGrupo = grupo.Select(e => e.Id).ToHashSet();
        var hijos = datosBD.Where(e => e.JefeId.HasValue && idsGrupo.Contains(e.JefeId.Value)).ToList();

        if (hijos.Any())
        {
            var gruposHijos = hijos.GroupBy(h => h.Puesto).ToList();
            double anchoTotalHijos = gruposHijos.Sum(g => CalcularAnchoColumnasGrupo(g.ToList())) * (ANCHO_NODO + GAP_X);
            double inicioX = x - (anchoTotalHijos / 2) + (ANCHO_NODO / 2) + (GAP_X / 2);
            if (gruposHijos.Count == 1) inicioX = x;

            // La siguiente fila empieza debajo de ESTE nodo calculado
            double nextY = y + altura + GAP_Y;
            double currentX = inicioX;

            foreach (var gHijo in gruposHijos)
            {
                var listaHijo = gHijo.ToList();
                double anchoHijo = CalcularAnchoColumnasGrupo(listaHijo) * (ANCHO_NODO + GAP_X);
                double centroHijo = (gruposHijos.Count == 1) ? x : (currentX + (anchoHijo / 2) - (ANCHO_NODO / 2) - (GAP_X / 2));

                CrearRamaAgrupada(listaHijo, centroHijo, nextY);
                currentX += anchoHijo;
            }
        }
        return nodo;
    }

    private void CrearLineasSVG()
    {
        HashSet<string> lineasDibujadas = new();
        foreach (var dato in datosBD)
        {
            if (dato.JefeId.HasValue && nodosMap.ContainsKey(dato.JefeId.Value) && nodosMap.ContainsKey(dato.Id))
            {
                var padre = nodosMap[dato.JefeId.Value];
                var hijo = nodosMap[dato.Id];
                if (padre == hijo) continue;

                string key = $"{padre.Id}-{hijo.Id}";
                if (lineasDibujadas.Contains(key)) continue;
                lineasDibujadas.Add(key);

                double px = padre.Position.X + (ANCHO_NODO / 2);
                double py = padre.Position.Y + padre.Size.Height;
                double hx = hijo.Position.X + (ANCHO_NODO / 2);
                double hy = hijo.Position.Y;
                double my = py + ((hy - py) / 2);

                string d = string.Format(CultureInfo.InvariantCulture, "M {0},{1} L {0},{2} L {3},{2} L {3},{4}", px, py, my, hx, hy);
                lineas.Add(d);
            }
        }
    }

    private int CalcularAnchoColumnasGrupo(List<NodoDatos> grupo)
    {
        var ids = grupo.Select(e => e.Id).ToHashSet();
        var hijos = datosBD.Where(e => e.JefeId.HasValue && ids.Contains(e.JefeId.Value)).ToList();
        if (!hijos.Any()) return 1;
        var gruposHijos = hijos.GroupBy(h => h.Puesto).ToList();
        return gruposHijos.Sum(g => CalcularAnchoColumnasGrupo(g.ToList()));
    }
}