@using RRHH_ARG.Models
@using Microsoft.AspNetCore.Components.Forms
@using System.IO
@using RRHH_ARG.Data

@inject EmpleadoService EmpleadoService
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "RH")]

@if (ShowModal)
{
    <div class="modal d-block" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        @(IsEditing ? "Editando Incidencia" : "Detalles de la Incidencia")
                    </h5>
                    <button type="button" class="btn-close" @onclick="Close"></button>
                </div>

                <div class="modal-body">
                    <fieldset disabled="@(!IsEditing)">
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Empleado:</label>
                                <input type="text" class="form-control" value="@Model.NombreEmpleado" disabled />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Área:</label>
                                <input type="text" class="form-control" value="@Model.AreaEmpleado" disabled />
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label class="form-label">Tipo:</label>
                                <select class="form-select" @bind="Model.TipoId">
                                    <option value="0">--Selecciona--</option>
                                    @foreach (var tipo in catalogoTipos)
                                    {
                                        <option value="@tipo.TinId">@tipo.TinNombre</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Cantidad:</label>
                                <input type="number" step="0.5" class="form-control" @bind="Model.Cantidad" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Fecha:</label>
                                <input type="date" class="form-control" @bind="Model.FechaIncidencia" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Descripción:</label>
                            <textarea class="form-control" rows="4" @bind="Model.Descripcion"></textarea>
                        </div>
                    </fieldset>

                    <div class="mt-3">
                        <label class="form-label fw-bold">Archivo de Evidencia:</label>

                        @if (!string.IsNullOrEmpty(Model.NombreArchivo))
                        {
                            <div class="alert alert-secondary d-flex justify-content-between align-items-center mb-2">
                                <span><i class="bi bi-paperclip"></i> Actual: <strong>@Model.NombreArchivo</strong></span>
                                <a href="api/Archivo/Incidencia/@Model.IncidenciaId" target="_blank" class="btn btn-sm btn-primary">
                                    <i class="bi bi-download"></i> Descargar
                                </a>
                            </div>
                        }

                        @if (IsEditing)//MODIFICADO 17 DIC TODO EL IF
                        {
                            <div class="mb-3 border p-3 rounded bg-light">
                                <label class="form-label text-primary"><i class="bi bi-upload"></i> Sustituir archivo (opcional):</label>

                                <InputFile OnChange="HandleFileSelection" class="form-control" accept=".pdf" />

                                <small class="text-muted">Seleccione un archivo solo si desea reemplazar el actual (Solo PDF).</small>

                                @if (!string.IsNullOrEmpty(ErrorMessage))
                                {
                                    <div class="text-danger mt-1 small">
                                        <i class="bi bi-exclamation-circle"></i> @ErrorMessage
                                    </div>
                                }
                            </div>
                        }
                    </div>

                </div>

                <div class="modal-footer">
                    @if (!IsEditing)
                    {
                        <button class="btn btn-secondary" @onclick="Close">Cerrar</button>
                        <button class="btn btn-primary" @onclick="EnableEdit">
                            <i class="bi bi-pencil"></i> Editar
                        </button>
                    }
                    else
                    {
                        <button class="btn btn-secondary" @onclick="CancelEdit">Cancelar</button>
                        <button class="btn btn-success" @onclick="SaveChanges">
                            <i class="bi bi-save"></i> Guardar Cambios
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public EventCallback<IncidenciaDTO> OnSave { get; set; }

    private bool ShowModal = false;
    private bool IsEditing = false;
    private IncidenciaDTO Model = new();
    private string ErrorMessage = string.Empty;//MODIFICADO 17 DIC
    private List<TipoIncidencia> catalogoTipos = new();

    protected override async Task OnInitializedAsync()
    {
        catalogoTipos = await EmpleadoService.GetTiposIncidenciaActivosAsync();
    }

    // MODIFICADO: Agregamos el parámetro opcional startEditing
    public void Open(IncidenciaDTO incidencia, bool startEditing = false)
    {
        Model = new IncidenciaDTO
        {
            IncidenciaId = incidencia.IncidenciaId,
            EmpleadoId = incidencia.EmpleadoId,
            NombreEmpleado = incidencia.NombreEmpleado,
            AreaEmpleado = incidencia.AreaEmpleado,
            TipoId = incidencia.TipoId, // <--- Usamos el ID
            Cantidad = incidencia.Cantidad, // <--- MAPEAR AQUÍ
            Descripcion = incidencia.Descripcion,
            FechaIncidencia = incidencia.FechaIncidencia,
            NombreArchivo = incidencia.NombreArchivo
        };

        IsEditing = startEditing; // Ahora podemos forzar el modo edición
        ShowModal = true;
        StateHasChanged();
    }

    private void Close() => ShowModal = false;
    private void EnableEdit() => IsEditing = true;
    private void CancelEdit() => IsEditing = false; // Podrías recargar el objeto original aquí si quisieras

    // NUEVO: Manejo de archivo en edición
    private async Task HandleFileSelection(InputFileChangeEventArgs e)//MODIFICADO 17 DIC
    {
        var file = e.File;
        if (file != null)
        {
            if (!file.Name.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase) &&
                file.ContentType != "application/pdf")
            {
                ErrorMessage = "El archivo debe ser formato PDF.";
                return; // Salimos sin procesar el archivo
            }
            // Límite seguro (ej. 5MB)
            long maxFileSize = 1024 * 1024 * 5;
            try
            {
                using var stream = file.OpenReadStream(maxFileSize);
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms);

                Model.ArchivoBytes = ms.ToArray();
                Model.NombreArchivo = file.Name;
            }
            catch (Exception ex)
            {
                ErrorMessage = "Error al leer el archivo: " + ex.Message;
            }
        }
    }

    private async Task SaveChanges()
    {
        if (OnSave.HasDelegate)
        {
            await OnSave.InvokeAsync(Model);
        }
        ShowModal = false;
    }
}
