</style>

@code {
    private int selectedAnio;
    private string filtroPeriodo = "";
    private string filtroNombre = "";
    private string filtroSubsidiaria = "";
    private bool isBusy = false;

    // Estado del pivot dinámico (arregla el bug visual)
    private bool vistaActualEsPorEmpleado = false;

    private List<Subsidiarium> subsidiarias = new();
    private List<VisorNominaDTO> registrosTodos = new();
    private List<string> nombresEmpleados = new();

    // Lista agrupada que la vista consume
    private IEnumerable<IGrouping<string, VisorNominaDTO>> registrosAgrupados = new List<IGrouping<string, VisorNominaDTO>>();

    private VisorNominaDTO nominaEnTooltip;
    private enum PestañaTooltip { Percepciones, Deducciones }
    private PestañaTooltip pestañaActiva;

    // Variables para el Reporte
    private bool showReportModal = false;
    private string formatoReporte = "EXCEL";
    private string reportePeriodo = "";
    private string reporteEmpleado = "";

    // Clase auxiliar para el combo de periodos
    public class ComboPeriodo
    {
        public string IdCombo { get; set; }
        public string Nombre { get; set; }
        public bool EsGenerada { get; set; }
    }
    private List<ComboPeriodo> opcionesPeriodos = new();

    protected override async Task OnInitializedAsync()
    {
        selectedAnio = DateTime.Now.Year;
        subsidiarias = await PayrollService.GetSubsidiariasAsync();

        await ActualizarEstadoPeriodosAsync();
        await BuscarNominas();
        nombresEmpleados = registrosTodos.Select(r => r.Empleado).Distinct().OrderBy(n => n).ToList();
    }

    private async Task ActualizarEstadoPeriodosAsync()
    {
        opcionesPeriodos.Clear();
        var periodosExistentes = await PayrollService.GetPeriodosGeneradosAsync(selectedAnio);

        for (int i = 1; i <= 12; i++)
        {
            string nombreMes = new DateTime(2000, i, 1).ToString("MMMM", new CultureInfo("es-MX")).ToUpper();
            int p1 = ((i - 1) * 2) + 1;
            int p2 = ((i - 1) * 2) + 2;

            opcionesPeriodos.Add(new ComboPeriodo { IdCombo = $"P{p1}", Nombre = $"{nombreMes} (P{p1})", EsGenerada = periodosExistentes.Contains($"P{p1}") });
            opcionesPeriodos.Add(new ComboPeriodo { IdCombo = $"P{p2}", Nombre = $"{nombreMes} (P{p2})", EsGenerada = periodosExistentes.Contains($"P{p2}") });
        }
    }

    private async Task OnAnioChanged()
    {
        await ActualizarEstadoPeriodosAsync();
        await BuscarNominas();
    }

    private async Task VerificarEnter(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await BuscarNominas();
    }

    private async Task BuscarNominas()
    {
        isBusy = true;
        try
        {
            registrosTodos = await PayrollService.GetHistorialVisorAsync(filtroNombre, filtroSubsidiaria, selectedAnio, filtroPeriodo);

            // LA MAGIA DEL PIVOT:
            // Solo cambiamos la variable de estado cuando presionamos "Consultar"
            if (!string.IsNullOrWhiteSpace(filtroNombre))
            {
                vistaActualEsPorEmpleado = true;
                registrosAgrupados = registrosTodos.OrderByDescending(r => r.FechaInicio).GroupBy(x => x.Empleado);
            }
            else
            {
                vistaActualEsPorEmpleado = false;
                registrosAgrupados = registrosTodos.OrderByDescending(r => r.FechaInicio).ThenBy(r => r.Empleado).GroupBy(x => x.TituloAgrupador);
            }
        }
        finally { isBusy = false; }
    }

    private async Task LimpiarFiltros()
    {
        filtroNombre = "";
        filtroSubsidiaria = "";
        filtroPeriodo = "";
        await BuscarNominas();
    }
    private void AbrirModalReporte()
    {
        // Hereda mágicamente las preferencias que el usuario ya tenía filtradas en la tabla
        reportePeriodo = filtroPeriodo;
        reporteEmpleado = filtroNombre;
        formatoReporte = "EXCEL";
        showReportModal = true;
    }

    private void CerrarModalReporte() => showReportModal = false;

    private async Task EjecutarReporte()
    {
        isBusy = true;
        try
        {
            if (formatoReporte == "EXCEL")
            {
                var fileBytes = await PayrollService.GenerarReporteExcelAsync(selectedAnio, reportePeriodo, reporteEmpleado);

                // Volvemos a cambiar la extensión a .xlsx de forma nativa
                var fileName = $"ReporteNomina_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx";

                // Le enviamos el Content-Type oficial de las hojas de cálculo modernas de Microsoft
                await JS.InvokeVoidAsync("descargarArchivoBase64", fileName, Convert.ToBase64String(fileBytes), "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
            }
            else if (formatoReporte == "PDF")
            {
                await JS.InvokeVoidAsync("alert", "Módulo en desarrollo.");
            }

            showReportModal = false;
        }
        finally { isBusy = false; }
    }


    private void AbrirTooltip(VisorNominaDTO fila, PestañaTooltip tab) { nominaEnTooltip = fila; pestañaActiva = tab; }
    private void CerrarTooltip() => nominaEnTooltip = null;
}