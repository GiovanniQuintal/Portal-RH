        padding: 3px 12px;
        font-size: 10px;
        font-weight: bold;
        cursor: pointer;
        border-radius: 3px;
    }

    .erp-btn-secondary {
        background: #ffffff;
        border: 1px solid #9ca3af;
        color: #4b5563;
        padding: 3px 12px;
        font-size: 10px;
        font-weight: bold;
        cursor: pointer;
        border-radius: 3px;
    }

    .periodo-header {
        background-color: #4b5563;
        color: white;
        font-size: 11px;
        border: 1px solid #333;
    }

    .erp-table {
        border-collapse: collapse;
        background: white;
        border: 1px solid #9ca3af;
        font-size: 11px;
    }

        .erp-table th {
            background-color: #e5e7eb;
            border: 1px solid #bbb;
            padding: 5px 8px;
            color: #333;
        }

