@page "/mis-objetivos"
@using RRHH_ARG.Models
@using RRHH_ARG.Services
@using RRHH_ARG.Data
@inject EmpleadoService EmpleadoService
@inject PdService PdService
@inject AuthenticationStateProvider AuthStateProvider
@rendermode InteractiveServer

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-primary mb-0"><i class="bi bi-trophy me-2"></i> Mis Objetivos @DateTime.Now.Year</h3>
            <small class="text-muted">Define tus prioridades y envíalas a revisión con tu supervisor.</small>
        </div>
        @*-<button class="btn btn-success shadow-sm" @onclick="NewPriority">
            <i class="bi bi-plus-lg me-1"></i> Nueva Prioridad
        </button>-*@
    </div>

    @if (!myPriorities.Any())
    {
        <div class="text-center py-5 bg-white rounded border border-dashed text-muted shadow-sm mb-4">
            <i class="bi bi-trophy display-4 opacity-25"></i>
            <p class="mt-3 mb-0">No tienes objetivos registrados aún.</p>
        </div>
    }
    else
    {
        var unassignedPriorities = myPriorities.Where(p => p.Indicator == null || p.Indicator.GlobalGoalId == 0).ToList();

        @for (int i = 0; i < globalGoalsList.Count; i++)
        {
            var goal = globalGoalsList[i];
            var goalPriorities = myPriorities.Where(p => p.Indicator != null && p.Indicator.GlobalGoalId == goal.Id).ToList();

            if (goalPriorities.Any())
            {
                string colColor = colorPalette[i % colorPalette.Length];

                <div class="mb-4 shadow-sm rounded border overflow-hidden bg-white">
                    <div class="p-3 text-white d-flex justify-content-between align-items-center" style="background-color: @colColor;">
                        <h6 class="mb-0 fw-bold"><i class="bi bi-bullseye me-2"></i>@goal.Title</h6>
                        <span class="badge bg-white text-dark rounded-pill shadow-sm">@goalPriorities.Count tareas</span>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 25%;" class="ps-4">Indicador / Tarea</th>
                                    <th style="width: 15%;">Meta</th>
                                    <th style="width: 15%;">Real</th>
                                    <th style="width: 15%;">Avance</th>
                                    <th style="width: 15%;" class="text-center">Estado</th>
                                    <th style="width: 15%;" class="text-end pe-4">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in goalPriorities)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <div class="fw-bold text-dark">@(p.Indicator?.Title ?? "Sin Indicador asignado")</div>
                                            <small class="text-muted d-block text-truncate" style="max-width: 250px;">
                                                <i class="bi bi-arrow-return-right text-secondary me-1"></i> @p.Title
                                            </small>
                                            <span class="badge bg-light text-secondary border mt-1">@p.Category</span>
                                        </td>
                                        <td>
                                            <span class="fw-bold">@p.TargetValue</span> <small class="text-muted">@p.UnitOfMeasure</small>
                                            <i class="bi @(p.TrackingType == "MHB" ? "bi-graph-up-arrow text-success" : "bi-graph-down-arrow text-danger") ms-1" title="@(p.TrackingType == "MHB" ? "Más es Mejor" : "Menos es Mejor")"></i>
                                        </td>
                                        <td><span class="text-primary fw-bold">@p.ActualValue</span></td>
                                        <td>
                                            @{
                                                int porcentaje = p.ProgressPercentage;
                                                string colorBarra = porcentaje >= 100 ? "bg-success" : (p.TrackingType == "MAB" ? "bg-danger" : (porcentaje >= 50 ? "bg-info" : "bg-warning"));
                                            }
                                            <div class="progress" style="height: 6px;">
                                                <div class="progress-bar @colorBarra" role="progressbar" style="width: @Math.Min(porcentaje, 100)%"></div>
                                            </div>
                                            <small class="text-muted" style="font-size: 0.7rem;">@porcentaje%</small>
                                        </td>
                                        <td class="text-center">
                                            @if (p.IsApproved)
                                            {
                                                <span class="badge bg-success"><i class="bi bi-check-circle-fill"></i> Aprobado</span>
                                            }
                                            else if (p.IsSubmitted)
                                            {
                                                <span class="badge bg-warning text-dark"><i class="bi bi-clock-history"></i> En Revisión</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Borrador</span>
                                            }
                                        </td>
                                        <td class="text-end pe-3">
                                            @if (!p.IsApproved)
                                            {
                                                <button class="btn btn-sm btn-link text-primary" @onclick="() => EditPriority(p)" title="Editar">
                                                    <i class="bi bi-pencil-square fs-5"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="btn btn-sm btn-link text-muted" @onclick="() => EditPriority(p)" title="Ver Detalle">
                                                    <i class="bi bi-eye fs-5"></i>
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        }

        @if (unassignedPriorities.Any())
        {
            <div class="mb-4 shadow-sm rounded border overflow-hidden bg-white">
                <div class="p-3 text-white d-flex justify-content-between align-items-center bg-secondary">
                    <h6 class="mb-0 fw-bold"><i class="bi bi-question-circle me-2"></i>Sin Objetivo Asignado</h6>
                    <span class="badge bg-white text-dark rounded-pill shadow-sm">@unassignedPriorities.Count tareas</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 25%;" class="ps-4">Indicador / Tarea</th>
                                <th style="width: 15%;">Meta</th>
                                <th style="width: 15%;">Real</th>
                                <th style="width: 15%;">Avance</th>
                                <th style="width: 15%;" class="text-center">Estado</th>
                                <th style="width: 15%;" class="text-end pe-4">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in unassignedPriorities)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="fw-bold text-dark">@(p.Indicator?.Title ?? "Sin Indicador asignado")</div>
                                        <small class="text-muted d-block text-truncate" style="max-width: 250px;">
                                            <i class="bi bi-arrow-return-right text-secondary me-1"></i> @p.Title
                                        </small>
                                        <span class="badge bg-light text-secondary border mt-1">@p.Category</span>
                                    </td>
                                    <td>
                                        <span class="fw-bold">@p.TargetValue</span> <small class="text-muted">@p.UnitOfMeasure</small>
                                        <i class="bi @(p.TrackingType == "MHB" ? "bi-graph-up-arrow text-success" : "bi-graph-down-arrow text-danger") ms-1" title="@(p.TrackingType == "MHB" ? "Más es Mejor" : "Menos es Mejor")"></i>
                                    </td>
                                    <td><span class="text-primary fw-bold">@p.ActualValue</span></td>
                                    <td>
                                        @{
                                            int porcentaje = p.ProgressPercentage;
                                            string colorBarra = porcentaje >= 100 ? "bg-success" : (p.TrackingType == "MAB" ? "bg-danger" : (porcentaje >= 50 ? "bg-info" : "bg-warning"));
                                        }
                                        <div class="progress" style="height: 6px;">
                                            <div class="progress-bar @colorBarra" role="progressbar" style="width: @Math.Min(porcentaje, 100)%"></div>
                                        </div>
                                        <small class="text-muted" style="font-size: 0.7rem;">@porcentaje%</small>
                                    </td>
                                    <td class="text-center">
                                        @if (p.IsApproved)
                                        {
                                            <span class="badge bg-success"><i class="bi bi-check-circle-fill"></i> Aprobado</span>
                                        }
                                        else if (p.IsSubmitted)
                                        {
                                            <span class="badge bg-warning text-dark"><i class="bi bi-clock-history"></i> En Revisión</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Borrador</span>
                                        }
                                    </td>
                                    <td class="text-end pe-3">
                                        @if (!p.IsApproved)
                                        {
                                            <button class="btn btn-sm btn-link text-primary" @onclick="() => EditPriority(p)" title="Editar">
                                                <i class="bi bi-pencil-square fs-5"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-link text-muted" @onclick="() => EditPriority(p)" title="Ver Detalle">
                                                <i class="bi bi-eye fs-5"></i>
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
</div>

@* MODAL DE EDICIÓN *@
@if (showModal)
{
    <div class="modal d-block" style="background: rgba(0,0,0,0.6); backdrop-filter: blur(2px);">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content shadow-lg border-0">

                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">
                        <i class="bi bi-speedometer2 me-2"></i>
                        @(editingPriority.Id == 0 ? "Definir Nuevo Objetivo" : "Detalle del Objetivo")
                    </h5>
                    <button class="btn-close btn-close-white" @onclick="() => showModal = false"></button>
                </div>

                <div class="modal-body p-4 bg-light">

                    @if (editingPriority.IsApproved)
                    {
                        <div class="alert alert-info mb-3 shadow-sm border-info">
                            <i class="bi bi-lock-fill me-2"></i>
                            <strong>Objetivo Aprobado.</strong> La definición está bloqueada, solo puedes ver la información de tu objetivo.
                        </div>
                    }

                    @* SECCIÓN 1: ALINEACIÓN *@
                    <div class="card mb-3 border-0 shadow-sm">
                        <div class="card-header bg-white fw-bold text-primary border-bottom-0">
                            1. Objetivo Global (Alineación)
                        </div>
                        <div class="card-body pt-0">
                            <select class="form-select border-start border-4 border-primary"
                                    value="@selectedGoalIdModal"
                                    @onchange="OnGoalChanged"
                                    disabled="@editingPriority.IsApproved">
                                <option value="">-- Selecciona un Objetivo --</option>
                                @foreach (var goal in globalGoalsList)
                                {
                                    <option value="@goal.Id">@goal.Title</option>
                                }
                            </select>
                            @if (selectedGoalIdModal > 0)
                            {
                                var selectedGoal = globalGoalsList.FirstOrDefault(g => g.Id == selectedGoalIdModal);
                                if (selectedGoal != null && !string.IsNullOrWhiteSpace(selectedGoal.Description))
                                {
                                    <div class="mt-2 p-2 rounded shadow-sm border" style="background-color: #e0f2fe; border-color: #bae6fd;">
                                        <div class="d-flex align-items-start">
                                            <i class="bi bi-info-circle-fill text-primary fs-6 me-2 mt-1"></i>
                                            <div><p class="mb-0 text-dark small">@selectedGoal.Description</p></div>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </div>

                    <div class="card mb-3 border-0 shadow-sm">
                        <div class="card-header bg-white fw-bold text-info border-bottom-0">
                            2. Indicador (KPI)
                        </div>
                        <div class="card-body pt-0">
                            <select class="form-select border-start border-4 border-info"
                                    @bind="editingPriority.IndicatorId"
                                    disabled="@(editingPriority.IsApproved || !availableIndicators.Any())">
                                <option value="">-- Selecciona un Indicador --</option>
                                @foreach (var ind in availableIndicators)
                                {
                                    <option value="@ind.Id">@ind.Title</option>
                                }
                            </select>
                            @if (editingPriority.IndicatorId > 0)
                            {
                                var selectedInd = availableIndicators.FirstOrDefault(i => i.Id == editingPriority.IndicatorId);
                                if (selectedInd != null && !string.IsNullOrWhiteSpace(selectedInd.Description))
                                {
                                    <div class="mt-2 p-2 rounded shadow-sm border" style="background-color: #f0fdf4; border-color: #bbf7d0;">
                                        <div class="d-flex align-items-start">
                                            <i class="bi bi-lightbulb-fill text-success fs-6 me-2 mt-1"></i>
                                            <div><p class="mb-0 text-dark small">@selectedInd.Description</p></div>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </div>

                    <div class="card mb-3 border-0 shadow-sm">
                        <div class="card-header bg-white fw-bold text-dark border-bottom-0">
                            3. Definición de la Tarea
                        </div>
                        <div class="card-body pt-0">
                            <div class="row g-3">
                                <div class="col-md-8">
                                    <label class="form-label fw-bold small">Nombre de la Tarea</label>
                                    <input class="form-control" @bind="editingPriority.Title" disabled="@editingPriority.IsApproved" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small">Categoría</label>
                                    <select class="form-select" @bind="editingPriority.Category" disabled="@editingPriority.IsApproved">
                                        <option value="">-- Seleccionar --</option>
                                        <option>QHSE</option>
                                        <option>Ventas</option>
                                        <option>RH</option>
                                        <option>Manufactura</option>
                                        <option>D&D</option>
                                        <option>Operaciones</option>
                                        <option>Administración y Finanzas</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card mb-3 border-0 shadow-sm">
                        <div class="card-header bg-white fw-bold text-success border-bottom-0">
                            4. Métricas y Medición
                        </div>
                        <div class="card-body pt-0">
                            <div class="mb-4 p-3 bg-light rounded border">
                                <label class="form-label fw-bold small text-muted mb-2">Comportamiento de la Métrica</label>
                                <div class="d-flex gap-4">
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="track_emp" id="thmb" value="MHB" @onchange='() => editingPriority.TrackingType = "MHB"' checked="@(editingPriority.TrackingType == "MHB")" disabled="@editingPriority.IsApproved">
                                        <label class="form-check-label fw-bold text-dark" for="thmb"><i class="bi bi-graph-up-arrow text-success me-1"></i> Más es Mejor</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="track_emp" id="tmab" value="MAB" @onchange='() => editingPriority.TrackingType = "MAB"' checked="@(editingPriority.TrackingType == "MAB")" disabled="@editingPriority.IsApproved">
                                        <label class="form-check-label fw-bold text-dark" for="tmab"><i class="bi bi-graph-down-arrow text-danger me-1"></i> Menos es Mejor</label>
                                    </div>
                                </div>
                            </div>

                            <div class="row g-3 align-items-end">
                                <div class="col-md-4">
                                    <label class="form-label fw-bold text-success small">Meta (Target)</label>
                                    <input type="number" class="form-control" @bind="editingPriority.TargetValue" disabled="@editingPriority.IsApproved" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small">Unidad</label>
                                    <select class="form-select" @bind="editingPriority.UnitOfMeasure" disabled="@editingPriority.IsApproved">
                                        <option value="">-- Seleccionar --</option>
                                        <option value="Unidades">Unidades</option>
                                        <option value="%">Porcentaje (%)</option>
                                        <option value="Tarjetas">Tarjetas</option>
                                        <option value="Horas">Horas</option>
                                        <option value="Días">Días</option>
                                        <option value="MXN">Pesos (MXN)</option>
                                        <option value="USD">Dólares (USD)</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-bold text-primary small">Logrado (Actual)</label>
                                    <input type="number" class="form-control" @bind="editingPriority.ActualValue" />
                                </div>
                            </div>

                            <div class="mt-4">
                                <label class="small text-muted mb-1">Progreso Calculado</label>
                                <div class="progress" style="height: 25px;">
                                    @{
                                        int porcentajeModal = editingPriority.ProgressPercentage;
                                        string colorModal = porcentajeModal >= 100 ? "bg-success" : (editingPriority.TrackingType == "MAB" ? "bg-danger" : (porcentajeModal >= 50 ? "bg-info" : "bg-warning"));
                                    }
                                    <div class="progress-bar @colorModal progress-bar-striped progress-bar-animated" role="progressbar" style="width: @(Math.Min(porcentajeModal, 100))%;">
                                        @porcentajeModal%
                                    </div>
                                </div>
                            </div>

                            <div class="mt-3">
                                <label class="form-label small">Notas / Comentarios</label>
                                <input class="form-control" @bind="editingPriority.Notes" />
                            </div>
                        </div>
                    </div>

                </div>

                <div class="modal-footer bg-white position-relative">
                    @if (!editingPriority.IsApproved)
                    {
                        <div class="me-auto">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" @bind="editingPriority.IsSubmitted" id="chkSubmit">
                                <label class="form-check-label fw-bold" for="chkSubmit">
                                    @(editingPriority.IsSubmitted ? "Listo para Revisión" : "Borrador Privado")
                                </label>
                            </div>
                        </div>
                    }

                    <button class="btn btn-light border" @onclick="() => showModal = false">Cancelar</button>

                    @if (editingPriority.IsApproved)
                    {
                        <button class="btn btn-primary px-4 shadow-sm" @onclick="SaveProgressOnly">
                            <i class="bi bi-save me-2"></i> Actualizar Progreso
                        </button>
                    }
                    else
                    {
                        <button class="btn btn-primary px-4 shadow-sm" @onclick="RequestSave">
                            <i class="bi bi-save me-2"></i> Guardar
                        </button>
                    }

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="position-fixed top-0 end-0 p-4" style="z-index: 2060;">
                            <div class="toast show align-items-center text-white bg-danger border-0 shadow-lg" role="alert">
                                <div class="d-flex p-2">
                                    <div class="toast-body fs-6">
                                        <i class="bi bi-exclamation-triangle-fill me-2"></i> @errorMessage
                                    </div>
                                    <button type="button" class="btn-close btn-close-white me-2 m-auto" @onclick='() => errorMessage = ""'></button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@if (showConfirmModal)
{
    <div class="modal d-block" style="background: rgba(0,0,0,0.7); z-index: 2000;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold">Confirma la información</h5>
                    <button class="btn-close" @onclick="() => showConfirmModal = false"></button>
                </div>
                <div class="modal-body text-center p-4">
                    <div class="mb-3">
                        @if (editingPriority.IsSubmitted)
                        {
                            <div class="text-warning display-1 mb-2"><i class="bi bi-envelope-paper"></i></div>
                            <h5 class="fw-bold">¿Enviar a Revisión?</h5>
                            <p class="text-muted">
                                Estás a punto de enviar el objetivo <strong>"@editingPriority.Title"</strong> a tu supervisor.
                                <br />Una vez aprobado, no podrás cambiar la Meta.
                            </p>
                        }
                        else
                        {
                            <div class="text-secondary display-1 mb-2"><i class="bi bi-save"></i></div>
                            <h5 class="fw-bold">Guardar Borrador</h5>
                            <p class="text-muted">
                                El objetivo <strong>"@editingPriority.Title"</strong> se guardará en tu bandeja personal.
                                <br />No será visible para aprobación hasta que actives "Enviar a Revisión".
                            </p>
                        }
                    </div>

                    <div class="bg-light p-3 rounded text-start small">
                        <div><strong>Meta:</strong> @editingPriority.TargetValue @editingPriority.UnitOfMeasure</div>
                        <div><strong>Categoría:</strong> @editingPriority.Category</div>
                    </div>
                </div>
                <div class="modal-footer justify-content-center border-0 pt-0 pb-4">
                    <button class="btn btn-light px-4" @onclick="() => showConfirmModal = false">Corregir</button>
                    <button class="btn btn-dark px-5" @onclick="ConfirmSave">Confirmar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    // --- PALETA DE COLORES ---
    private readonly string[] colorPalette = new[]
    {
        "#024A86", // Azul
        "#02AC66", // Verde
        "#23BAC4", // Turquesa
        "#E36B2C", // Naranja
        "#C82A54", // Guinda/Rosa oscuro
        "#8C4966"  // Morado tenue/Marrón
    };

    private bool isLoading = true;
    private int myEmpId;
    private List<PdPriority> myPriorities = new();
    private List<PdGlobalGoal> globalGoalsList = new();

    // UI Control
    private bool showModal = false;
    private bool showConfirmModal = false;
    private string errorMessage = "";
    private PdPriority editingPriority = new();

    private bool IsSubmitted = true;

    private int selectedGoalIdModal = 0;
    private List<PdIndicator> availableIndicators = new();

    private async Task OnGoalChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int goalId))
        {
            selectedGoalIdModal = goalId;
            availableIndicators = await PdService.GetIndicatorsByGoalAsync(goalId);
            editingPriority.IndicatorId = null;
        }
        else
        {
            availableIndicators.Clear();
            editingPriority.IndicatorId = null;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(c => c.Type.Contains("nameidentifier"))?.Value;

        if (!string.IsNullOrEmpty(userId))
        {
            myEmpId = await EmpleadoService.GetEmpleadoIdByUserIdAsync(userId);
            if (myEmpId > 0) await LoadData();
        }
        isLoading = false;
    }

    private async Task LoadData()
    {
        globalGoalsList = await PdService.GetGlobalGoalsAsync(DateTime.Now.Year);
        myPriorities = await PdService.GetPrioritiesAsync(myEmpId, DateTime.Now.Year, showArchived: false);
    }

    private void NewPriority()
    {
        errorMessage = "";
        editingPriority = new PdPriority
        {
            EmpId = myEmpId,
            Year = DateTime.Now.Year,
            UnitOfMeasure = "",
            TargetValue = 0,
            ActualValue = 0,
            Title = "",
            Description = "",
            Category = "",
            Notes = "",
            IsSubmitted = true,
            IsApproved = false,
            IsArchived = false,
            ReadyForReview = false,
            StartDate = new DateTime(DateTime.Now.Year, 1, 1),
            EndDate = new DateTime(DateTime.Now.Year, 12, 31)
        };
        showModal = true;
    }

    private async Task EditPriority(PdPriority p)
    {
        errorMessage = "";
        editingPriority = new PdPriority
        {
            Id = p.Id,
            EmpId = p.EmpId,
            Year = p.Year,
            Title = p.Title,
            Description = p.Description,
            Category = p.Category,
            IndicatorId = p.IndicatorId,
            TrackingType = p.TrackingType ?? "MHB",
            StartDate = p.StartDate,
            EndDate = p.EndDate,
            TargetValue = p.TargetValue,
            ActualValue = p.ActualValue,
            UnitOfMeasure = p.UnitOfMeasure,
            Notes = p.Notes,
            IsSubmitted = p.IsSubmitted,
            IsApproved = p.IsApproved,
            IsArchived = p.IsArchived,
            ReadyForReview = p.ReadyForReview,
            CreatedAt = p.CreatedAt
        };

        if (p.Indicator != null)
        {
            selectedGoalIdModal = p.Indicator.GlobalGoalId;
            availableIndicators = await PdService.GetIndicatorsByGoalAsync(selectedGoalIdModal);
        }
        else
        {
            selectedGoalIdModal = 0;
            availableIndicators.Clear();
        }

        showModal = true;
    }

    private void RequestSave()
    {
        errorMessage = "";

        if (editingPriority.IndicatorId == null || editingPriority.IndicatorId == 0)
        {
            errorMessage = "El Indicador es obligatorio. Por favor selecciona uno.";
            return;
        }
        if (string.IsNullOrWhiteSpace(editingPriority.Title))
        {
            errorMessage = "El Nombre del tarea no puede estar vacío.";
            return;
        }
        if (string.IsNullOrWhiteSpace(editingPriority.Category) || editingPriority.Category == "----------")
        {
            errorMessage = "Debe seleccionar una Categoría válida.";
            return;
        }

        if (editingPriority.TrackingType == "MHB" && editingPriority.TargetValue <= 0)
        {
            errorMessage = "Para métricas de 'Más es Mejor', la Meta (Target) debe ser mayor a 0.";
            return;
        }
        else if (editingPriority.TrackingType == "MAB" && editingPriority.TargetValue < 0)
        {
            errorMessage = "Para métricas de 'Menos es Mejor', la Meta no puede ser negativa (pero sí puede ser 0).";
            return;
        }
        if (string.IsNullOrWhiteSpace(editingPriority.UnitOfMeasure))
        {
            errorMessage = "Debe seleccionar una Unidad de medida.";
            return;
        }

        showConfirmModal = true;
    }

    private async Task ConfirmSave()
    {
        await PdService.SavePriorityAsync(editingPriority);
        showConfirmModal = false;
        showModal = false;
        await LoadData();
    }

    private async Task SaveProgressOnly()
    {
        errorMessage = "";

        if (editingPriority.TargetValue <= 0)
        {
            errorMessage = "La Meta (Target) debe ser un valor válido y mayor a 0 para actualizar el progreso.";
            return;
        }

        await PdService.SavePriorityAsync(editingPriority);
        showModal = false;
        await LoadData();
    }
}