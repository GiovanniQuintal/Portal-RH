@using RRHH_ARG.Models
@using RRHH_ARG.Data
@using Microsoft.AspNetCore.Components.Forms
@inject EmpleadoService EmpleadoService
@inject IWebHostEnvironment Environment
@inject ILogger<RegistroAplicantes> Logger
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "RH")]

@if (showModal)
{
    <div class="modal d-block" tabindex="-1" style="background-color: rgba(0, 0, 0, 0.5);">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">

                @if (isBusy)
                {
                    <div style="position: fixed;top: 0;left: 0;width: 100vw;height: 100vh;background-color: rgba(0, 0, 0, 0.5);z-index: 9999;backdrop-filter: blur(2px);display: flex;justify-content: center;align-items: center;">

                        <div class="text-center p-4 rounded bg-white shadow">
                            <!-- Spinner CSS puro -->
                            <div class="spinner-border text-primary" role="status" style="width: 4rem; height: 4rem;">
                                <span class="visually-hidden">Cargando...</span>
                            </div>
                            <h5 class="mt-3 text-dark fw-bold">Procesando...</h5>
                        </div>
                    </div>
                }
                <div class="modal-header">
                    <h5 class="modal-title">@pageTitle</h5>
                    <button type="button" class="btn-close" @onclick="Close"></button>
                </div>

                <div class="modal-body">


                    @*//MODIFICADO 17 DIC*@
                    <ul class="nav nav-tabs mb-3">
                        <li class="nav-item">
                            <button class="nav-link @(activeTab == "datos" ? "active" : "")" @onclick='() => activeTab = "datos"'>
                                <i class="bi bi-person-vcard me-1"></i> Datos Personales
                            </button>
                        </li>

                        <li class="nav-item">
                            <button class="nav-link @(activeTab == "emergencia" ? "active" : "")" @onclick='() => activeTab = "emergencia"'>
                                <i class="bi bi-heart-pulse me-1"></i> Salud y Emergencia
                            </button>
                        </li>

                        @if (empleadoViewModel.Id > 0)
                        {
                            <li class="nav-item">
                                <button class="nav-link @(activeTab == "expedientes" ? "active" : "")"
                                        @onclick='() => activeTab = "expedientes"'>
                                    <i class="bi bi-folder2-open me-1"></i> Expediente Digital
                                </button>
                            </li>
                        }

                        <li class="nav-item">
                            <button class="nav-link @(activeTab == "epp" ? "active" : "")" @onclick='() => activeTab = "epp"'>
                                <i class="bi bi-shield-check me-1"></i> Historial EPP
                            </button>
                        </li>
                    

                    <li class="nav-item">
                        <button class="nav-link @(activeTab == "nomina" ? "active" : "")" @onclick='() => activeTab = "nomina"'>
                            <i class="bi bi-currency-dollar me-1"></i> Finanzas / Nómina
                        </button>
                        </li>
                    </ul>

                    <div class="tab-content">
                        <div class="tab-pane fade @(activeTab == "datos" ? "show active" : "")">
                            <div class="row g-3">

                                @* --- INICIO: NUEVA SECCIÓN DE FOTO DE PERFIL --- *@
                                <div class="col-12 d-flex justify-content-center mb-4">
                                    <div class="position-relative" style="width: 150px; height: 150px;">
                                        @if (!string.IsNullOrEmpty(UrlFotoPerfil))
                                        {
                                            @* Muestra la foto real si existe *@
                                            <img src="@UrlFotoPerfil"
                                                 alt="Foto Perfil"
                                                 class="rounded-circle img-thumbnail shadow-sm border-2 border-primary"
                                                 style="width: 150px; height: 150px; object-fit: cover;" />
                                        }
                                        else
                                        {
                                            @* Placeholder (Icono gris) si no hay foto *@
                                            <div class="rounded-circle bg-light d-flex align-items-center justify-content-center text-secondary border shadow-sm"
                                                 style="width: 150px; height: 150px;">
                                                <i class="bi bi-person-fill" style="font-size: 5rem; opacity: 0.5;"></i>
                                            </div>
                                        }

                                        @* Botón flotante para ir rápido a la pestaña de expedientes a subir la foto *@
                                        @if (isEditable && empleadoViewModel.Id > 0)
                                        {
                                            <button class="btn btn-sm btn-primary position-absolute bottom-0 end-0 rounded-circle shadow"
                                                    style="width: 40px; height: 40px;"
                                                    @onclick='() => activeTab = "expedientes"'
                                                    title="Ir a Expedientes para subir/cambiar foto">
                                                <i class="bi bi-camera-fill"></i>
                                            </button>
                                        }
                                    </div>
                                </div>
                                @* --- FIN: NUEVA SECCIÓN DE FOTO DE PERFIL --- *@

                                <div class="col-md-6">
                                    @*MODIFICADO DIC 18*@
                                    <label class="form-label fw-bold">No. Empleado / Código</label>
                                    <input @bind="empleadoViewModel.CodigoEmpleado" class="form-control" placeholder="Ej. AC021" disabled="@(!isEditable)" />
                                </div>
                                <div class="col-md-6"><label class="form-label">Nombres</label><input @bind="empleadoViewModel.Nombre" class="form-control" disabled="@(!isEditable)" /></div>
                                <div class="col-md-6"><label class="form-label">Apellido Paterno</label><input @bind="empleadoViewModel.ApellidoPaterno" class="form-control" disabled="@(!isEditable)" /></div>
                                <div class="col-md-6"><label class="form-label">Apellido Materno</label><input @bind="empleadoViewModel.ApellidoMaterno" class="form-control" disabled="@(!isEditable)" /></div>
                                <div class="col-md-6"><label class="form-label">Email</label><input @bind="empleadoViewModel.Email" class="form-control" disabled="@(!isEditable)" /></div>
                                <div class="col-md-6"><label class="form-label">Teléfono</label><input @bind="empleadoViewModel.Telefono" class="form-control" disabled="@(!isEditable)" /></div>
                                <div class="col-md-6"><label class="form-label">Fecha Nacimiento</label><input @bind="empleadoViewModel.FechaNacimiento" type="date" class="form-control" disabled="@(!isEditable)" /></div>
                                <div class="col-md-6">
                                    <label class="form-label">Género</label>
                                    <select @bind="empleadoViewModel.Genero" class="form-select" disabled="@(!isEditable)">
                                        <option value="">Seleccionar...</option>
                                        <option>Masculino</option>
                                        <option>Femenino</option>
                                    </select>
                                </div>

                                <div class="col-md-12"><hr /></div>
                                <h6 class="text-primary fw-bold"><i class="bi bi-briefcase"></i> Puesto Principal</h6>

                                <div class="col-md-6">
                                    <label class="form-label">Área</label>
                                    <select @bind="SelectedArea" class="form-select" disabled="@(!isEditable)">
                                        <option value="">Seleccione un área...</option>
                                        @foreach (var area in areasList)
                                        {
                                            <option value="@area.AreNombre">@area.AreNombre</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Cargo Principal</label>
                                    <select @bind="empleadoViewModel.Empleo" class="form-select" disabled="@(!isEditable || string.IsNullOrEmpty(SelectedArea))">
                                        <option value="">Seleccione un cargo...</option>
                                        @foreach (var cargo in cargosDisponiblesPrincipal)
                                        {
                                            <option value="@cargo.PepNombre">@cargo.PepNombre</option>
                                        }
                                    </select>
                                </div>

                                @*<div class="col-md-12"><hr /></div>*@
                                <small class="text-muted" style="font-size: 0.75rem;">El segundo cargo es opcional</small>

                                <div class="col-md-6">
                                    <label class="form-label">Área Secundaria</label>
                                    <select @bind="SelectedAreaSecundaria" class="form-select" disabled="@(!isEditable)">
                                        <option value="">Seleccionar...</option>
                                        @foreach (var area in areasList)
                                        {
                                            <option value="@area.AreNombre">@area.AreNombre</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Segundo Cargo</label>
                                    <select @bind="empleadoViewModel.Empleo2" class="form-select" disabled="@(!isEditable || string.IsNullOrEmpty(SelectedAreaSecundaria))">
                                        <option value="">Seleccionar...</option>
                                        @foreach (var cargo in cargosDisponiblesSecundario)
                                        {
                                            <option value="@cargo.PepNombre">@cargo.PepNombre</option>
                                        }
                                    </select>
                                </div>



                                <div class="col-md-6">
                                    <label class="form-label fw-bold text-primary">Supervisor Inmediato</label>
                                    <select @bind="empleadoViewModel.SupId" class="form-select border-primary" disabled="@(!isEditable)">
                                        <option value="">-- Sin Supervisor --</option>
                                        @foreach (var sup in supervisoresList)
                                        {
                                            // Evitar que un empleado sea su propio jefe
                                            if (sup.Id != empleadoViewModel.Id)
                                            {
                                                <option value="@sup.Id">@sup.Nombre @sup.Apellidos (@sup.Empleo)</option>
                                            }
                                        }
                                    </select>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label">Subsidiaria</label>
                                    <select @bind="empleadoViewModel.Subsidiaria" class="form-select" disabled="@(!isEditable)">
                                        <option value="">Seleccionar...</option>
                                        @foreach (var sub in subsidiariasList)
                                        {
                                            <option value="@sub.SubNombre">@sub.SubNombre</option>
                                        }
                                    </select>
                                </div>
                                @*//MODIFICADO 17 DIC*@
                                <div class="col-md-6">
                                    <label class="form-label">Fecha Contratación</label>
                                    <input @bind="empleadoViewModel.FechaContratacion" type="date" class="form-control" disabled="@(!isEditable)" />
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label text-danger">Fecha de Baja (Finiquito)</label>
                                    <input @bind="empleadoViewModel.FechaBaja" type="date" class="form-control border-danger" disabled="@(!isEditable)" />
                                    <small class="text-muted" style="font-size: 0.7rem;">Solo llenar si el empleado será dado de baja.</small>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label">Tipo de Colaborador</label>
                                    <select @bind="empleadoViewModel.TipId" class="form-select" disabled="@(!isEditable)">
                                        <option value="0">Seleccionar...</option>
                                        @foreach (var tipo in tiposList)
                                        {
                                            <option value="@tipo.TipId">@tipo.TipNombre</option>
                                        }
                                    </select>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-bold text-dark">Rol de Sistema (Permisos)</label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="bi bi-shield-lock"></i></span>
                                        <select @bind="empleadoViewModel.RolSeleccionado" class="form-select" disabled="@(!isEditable)">
                                            <option value="">Seleccione un Rol...</option>

                                            @* --- CAMBIO AQUÍ: Filtramos la lista para ignorar 'SUPERVISOR' --- *@
                                            @foreach (var rol in rolesList.Where(r => !string.Equals(r, "SUPERVISOR", StringComparison.OrdinalIgnoreCase)))
                                            {
                                                <option value="@rol">@rol</option>
                                            }

                                        </select>
                                    </div>
                                    <small class="text-muted" style="font-size: 0.75rem;">Define el acceso al sistema (Admin, Empleado, etc.)</small>
                                </div>

                                @* 2. EL NUEVO COMBO: ROL ADICIONAL MODIFICADO 30 ENE*@
                                
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold text-primary">Función de Mando</label>

                                    @* CAMBIO CLAVE: Añadimos empleadoViewModel.TieneSubordinados a la condición de disabled *@
                                    <InputSelect @bind-Value="empleadoViewModel.AsignarRolSupervisor" class="form-select" disabled="@(!isEditable || empleadoViewModel.TieneSubordinados)">
                                        <option value="false">Solo Rol Principal</option>
                                        <option value="true">Rol Principal + SUPERVISOR</option>
                                    </InputSelect>

                                    @* MENSAJE DINÁMICO DE ADVERTENCIA *@
                                    @if (empleadoViewModel.TieneSubordinados)
                                    {
                                        <small class="text-danger mt-1 d-block fw-bold">
                                            <i class="bi bi-exclamation-triangle-fill me-1"></i>
                                            No puedes quitar este rol porque el empleado tiene personal a su cargo. Reasigna a sus subordinados primero.
                                        </small>
                                    }
                                    else
                                    {
                                        <div class="form-text">
                                            Al seleccionar la segunda opción, el usuario tendrá DOBLE ROL.
                                        </div>
                                    }
                                </div>

                                <div class="col-md-12">
                                    <div class="card bg-light border-0">
                                        <div class="card-body">
                                            <label class="form-label fw-bold">Estatus del Empleado</label>
                                            <div class="input-group">
                                                <select @bind="empleadoViewModel.StaId" class="form-select" disabled="@(!isEditable)">
                                                    @foreach (var st in statusList)
                                                    {
                                                        <option value="@st.StaId">@st.StaTipoStatus</option>
                                                    }
                                                </select>
                                            </div>
                                            <small class="text-muted"><i class="bi bi-info-circle"></i> Si seleccionas <strong>Inactivo</strong>, se mostrará como tal en la tabla.</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="tab-content">

                            <div class="tab-pane fade @(activeTab == "datos" ? "show active" : "")">
                            </div>

                            <div class="tab-pane fade @(activeTab == "emergencia" ? "show active" : "")">
                                <div class="row g-3">

                                    <div class="col-12 d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
                                        <h6 class="text-primary mb-0"><i class="bi bi-telephone-plus"></i> Contactos de Emergencia</h6>
                                        @if (isEditable)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="AgregarContacto">
                                                <i class="bi bi-plus-circle"></i> Agregar Otro
                                            </button>
                                        }
                                    </div>

                                    @foreach (var contacto in empleadoViewModel.ContactosEmergencia)
                                    {
                                        <div class="col-12 bg-light p-3 rounded mb-3 position-relative">

                                            @if (isEditable)
                                            {
                                                <button type="button" class="btn-close position-absolute top-0 end-0 m-2 small"
                                                        @onclick="() => EliminarContactoDeLista(contacto)" title="Quitar este contacto"></button>
                                            }

                                            <div class="row g-2">
                                                <div class="col-md-6">
                                                    <label class="form-label small fw-bold">Nombre Completo</label>
                                                    <input @bind="contacto.CemNombreCompleto" class="form-control form-control-sm" placeholder="Nombre" disabled="@(!isEditable)" />
                                                </div>
                                                <div class="col-md-6">
                                                    <label class="form-label small">Parentesco</label>
                                                    <input @bind="contacto.CemParentesco" class="form-control form-control-sm" placeholder="Ej: Padre, Hermano" disabled="@(!isEditable)" />
                                                </div>
                                                <div class="col-md-6">
                                                    <label class="form-label small">Teléfono Principal</label>
                                                    <input @bind="contacto.CemTelefono1" class="form-control form-control-sm" placeholder="Móvil" disabled="@(!isEditable)" />
                                                </div>
                                                <div class="col-md-6">
                                                    <label class="form-label small">Teléfono 2 (Opcional)</label>
                                                    <input @bind="contacto.CemTelefono2" class="form-control form-control-sm" placeholder="Casa/Trabajo" disabled="@(!isEditable)" />
                                                </div>
                                            </div>
                                        </div>
                                    }

                                    <div class="col-12 mt-4">
                                        <h6 class="text-danger border-bottom pb-2 mb-3"><i class="bi bi-activity"></i> Información Médica</h6>
                                    </div>

                                    <div class="col-md-4">
                                        <label class="form-label">Tipo de Sangre</label>
                                        <select @bind="empleadoViewModel.ImeTipoSangre" class="form-select" disabled="@(!isEditable)">
                                            <option value="">Seleccionar...</option>
                                            <option>O+</option>
                                            <option>O-</option>
                                            <option>A+</option>
                                            <option>A-</option>
                                            <option>B+</option>
                                            <option>B-</option>
                                            <option>AB+</option>
                                            <option>AB-</option>
                                        </select>
                                    </div>

                                    <div class="col-md-8">
                                    </div>

                                    <div class="col-md-12">
                                        <label class="form-label">Alergias</label>
                                        <textarea @bind="empleadoViewModel.ImeAlergias" class="form-control" rows="2" placeholder="Describa alergias a medicamentos o alimentos..." disabled="@(!isEditable)"></textarea>
                                    </div>

                                    <div class="col-md-12">
                                        <label class="form-label">Padecimientos Crónicos</label>
                                        <textarea @bind="empleadoViewModel.ImePadecimientos" class="form-control" rows="2" placeholder="Diabetes, Hipertensión, etc..." disabled="@(!isEditable)"></textarea>
                                    </div>

                                    <div class="col-md-12">
                                        <label class="form-label">Otras Observaciones Médicas</label>
                                        <textarea @bind="empleadoViewModel.ImeObservaciones" class="form-control" rows="2" disabled="@(!isEditable)"></textarea>
                                    </div>

                                </div>
                            </div>
                            <div class="tab-pane fade @(activeTab == "expedientes" ? "show active" : "")">
                            </div>

                        </div>

                        <div class="tab-pane fade @(activeTab == "expedientes" ? "show active" : "")">
                            @if (empleadoViewModel.Id == 0)
                            {
                                <div class="alert alert-warning text-center mt-4 p-4">
                                    <h4><i class="bi bi-lock"></i> Sección Bloqueada</h4>
                                    <p>Primero guarda los datos personales para habilitar el expediente.</p>
                                </div>
                            }
                            else
                            {
                                <div class="d-flex justify-content-between align-items-center mt-3 mb-2">
                                    <h6 class="text-primary mb-0"><i class="bi bi-folder"></i> Documentos del Empleado</h6>

                                    @if (isEditable)
                                    {
                                        <button type="button" class="btn btn-sm btn-success shadow-sm" @onclick="AbrirModalUnico">
                                            <i class="bi bi-plus-lg"></i> Agregar Doc. Específico
                                        </button>
                                    }
                                </div>

                                @* --- 2. FORMULARIO MINI PARA CREAR NUEVO (ESTO FALTABA) --- *@
                                @if (showModalUnico)
                                {
                                    <div class="card border-success mb-3 shadow-sm bg-light">
                                        <div class="card-body p-3">
                                            <h6 class="card-title text-success mb-3"><i class="bi bi-file-earmark-plus"></i> Nuevo Requisito Específico</h6>
                                            <div class="row g-2 align-items-end">
                                                <div class="col-md-5">
                                                    <label class="form-label small fw-bold">Nombre del Documento</label>
                                                    <input @bind="nuevoDocNombre" class="form-control form-control-sm" placeholder="Ej. Diploma Curso Alturas" />
                                                </div>
                                                <div class="col-md-4">
                                                    <label class="form-label small fw-bold">Nomenclatura (Corto)</label>
                                                    <input @bind="nuevoDocNomenclatura" class="form-control form-control-sm" placeholder="Ej. DIP_ALTURAS" />
                                                </div>
                                                <div class="col-md-3 text-end">
                                                    <button class="btn btn-sm btn-secondary me-1" @onclick="() => showModalUnico = false">Cancelar</button>
                                                    <button class="btn btn-sm btn-success" @onclick="GuardarExpedienteUnico" disabled="@isBusy">Crear</button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }

                                <div class="table-responsive mt-3">
                                    <table class="table table-hover align-middle">
                                        <thead class="table-light">
                                            <tr>
                                                <th style="width: 40%">Documento</th>
                                                <th style="width: 15%">Estado</th>
                                                <th style="width: 20%">Vencimiento</th>
                                                <th style="width: 25%">Acciones</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var exp in expedientes)
                                            {
                                                @* CONDICIÓN: Si exp.DeuId tiene valor mayor a 0, es un documento único (Naranja) *@

                                                <tr class="@(expedienteParaSubir?.DexId == exp.DexId && expedienteParaSubir?.DeuId == exp.DeuId ? "table-active border-bottom-0" : "")">
                                                    <td>
                                                        <div class="d-flex align-items-center">

                                                            @* Ícono naranja para docs únicos *@
                                                            @if (exp.DeuId > 0)
                                                            {
                                                                <div class="me-2 text-warning" title="Documento Específico (Adicional)">
                                                                    <i class="bi bi-bookmark-plus-fill fs-5"></i>
                                                                </div>
                                                            }

                                                            @* BOTÓN OJO: Solo para docs del catálogo estándar *@
                                                            @if (isEditable && exp.DexId > 0 && exp.DeuId == null)
                                                            {
                                                                <button class="btn btn-sm btn-link p-0 me-2"
                                                                        title="@(string.IsNullOrEmpty(exp.NombreArchivo) ? "Ocultar documento" : "No se puede ocultar, tiene archivo")"
                                                                        disabled="@(!string.IsNullOrEmpty(exp.NombreArchivo))"
                                                                        @onclick="() => OcultarDocumento(exp)">
                                                                    <i class="bi bi-eye fs-5 text-secondary"></i>
                                                                </button>
                                                            }

                                                            <div>
                                                                <div class="fw-bold @(exp.DeuId > 0 ? "text-warning-emphasis" : "")">
                                                                    @exp.Nombre
                                                                </div>
                                                                <small class="text-muted">@exp.Nomenclatura</small>
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <td>
                                                        @if (!string.IsNullOrEmpty(exp.NombreArchivo))
                                                        {
                                                            <span class="badge bg-success"><i class="bi bi-check"></i> Cargado</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-secondary">Pendiente</span>
                                                        }
                                                    </td>
                                                    <td>@(exp.FechaCaducidad?.ToShortDateString() ?? "-")</td>
                                                    <td>
                                                        <div class="btn-group">
                                                            <button class="btn btn-sm btn-outline-primary" @onclick="() => PrepararSubida(exp)" disabled="@(!isEditable)" title="Subir archivo">
                                                                <i class="bi bi-upload"></i> Subir
                                                            </button>

                                                            @if (!string.IsNullOrEmpty(exp.NombreArchivo) && exp.ExpId > 0)
                                                            {
                                                                <a href="/api/Archivo/@exp.ExpId" target="_blank" class="btn btn-sm btn-outline-info" title="Ver/Descargar">
                                                                    <i class="bi bi-eye"></i> Ver
                                                                </a>
                                                                @if (isEditable)
                                                                {
                                                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => EliminarArchivo(exp)" title="Eliminar archivo">
                                                                        <i class="bi bi-trash"></i> Borrar
                                                                    </button>
                                                                }
                                                            }

                                                            

                                                            @* Botón borrar: Solo docs únicos sin archivo *@
                                                            @if (exp.DeuId.HasValue && exp.DeuId.Value > 0 && string.IsNullOrEmpty(exp.NombreArchivo) && isEditable)
                                                            {
                                                                <button class="btn btn-sm btn-outline-secondary ms-1"
                                                                        title="Eliminar este requisito de la lista"
                                                                        @onclick="() => BorrarRequisitoUnico(exp)">
                                                                    <i class="bi bi-x-lg"></i>
                                                                </button>
                                                            }
                                                        </div>
                                                    </td>
                                                </tr>

                                                @* FORMULARIO DE SUBIDA DESPLEGABLE *@
                                                @if (expedienteParaSubir != null &&
                                                                                    ((exp.DexId > 0 && expedienteParaSubir.DexId == exp.DexId) ||
                                                                                    (exp.DeuId > 0 && expedienteParaSubir.DeuId == exp.DeuId)))
