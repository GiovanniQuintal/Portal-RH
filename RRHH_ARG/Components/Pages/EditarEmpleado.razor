                try
                {
                    empleadoViewModel = await EmpleadoService.GetEmpleadoByIdAsync(id);
                    pageTitle = $"Ficha de: {empleadoViewModel.Nombre} {empleadoViewModel.ApellidoPaterno}";
                    expedientes = await EmpleadoService.GetExpedientesByEmpleadoIdAsync(id);
                    await CargarExpedientesOcultos(); // <--- AGREGAR AQUÍ
                    historialEpp = await EmpleadoService.GetHistorialEppByEmpleadoIdAsync(id);

                    RecargarListasDeCargos();
