        return exp.DexId == 13;



        // OPCIÓN B: Por nombre (Más flexible pero cuidado con mayúsculas/tildes)

        return exp.Nombre.Contains("Foto", StringComparison.OrdinalIgnoreCase) ||

               exp.Nombre.Contains("Perfil", StringComparison.OrdinalIgnoreCase);

    }

    public async Task Open(int id, bool editable, string initialTab = "datos", bool allowEditSwitch = true)
