        if (string.IsNullOrEmpty(empleadoViewModel.Genero))
        {
            errorMessage = "Debes seleccionar un Género.";
            return false;
        }

        if (string.IsNullOrEmpty(empleadoViewModel.Empleo))
        {
            errorMessage = "Debes seleccionar un Cargo Principal.";
            return false;
        }

        // --- NUEVO: Validar coherencia del segundo puesto ---
        if (!string.IsNullOrEmpty(empleadoViewModel.Area2) && string.IsNullOrEmpty(empleadoViewModel.Empleo2))
        {
            errorMessage = "Si seleccionas un Área Secundaria, debes asignar también el Segundo Cargo.";
            return false;
        }

        if (string.IsNullOrEmpty(empleadoViewModel.Subsidiaria))
        {
            errorMessage = "Debes seleccionar una Subsidiaria.";
            return false;
        }
        if (string.IsNullOrEmpty(empleadoViewModel.RolSeleccionado))
        {
            errorMessage = "Debes asignar un Rol de Sistema.";
            return false;
        }

        if (empleadoViewModel.FechaContratacion == null ||
        empleadoViewModel.FechaContratacion == DateTime.MinValue)
        {
            errorMessage = "La Fecha de Contratación es obligatoria.";
            return false;
        }

        // Validar Combos (IDs numéricos)
        if (empleadoViewModel.TipId == 0)
        {
            errorMessage = "Debes seleccionar el Tipo de Colaborador.";
            return false;
        }

        // Validar Fecha (Evitar fecha por defecto 0001-01-01)
        if (empleadoViewModel.FechaNacimiento == DateTime.MinValue ||
            empleadoViewModel.FechaNacimiento == default)
        {
            errorMessage = "La Fecha de Nacimiento no es válida.";
            return false;
        }

        return true;
    }

    // 2. MODIFICA EL MÉTODO GUARDARCAMBIOS ASÍ:
    private async Task GuardarCambios()
    {
        errorMessage = ""; // Limpiar errores previos

        // Llamamos a la validación antes de guardar
        if (!ValidarDatosPersonales())
        {
            // Si falla, el errorMessage ya se llenó en la función, así que solo salimos.
            // Forzamos el salto a la pestaña de datos para que el usuario vea el error
            activeTab = "datos";
            StateHasChanged();
            return;
        }

        isBusy = true;
        StateHasChanged();

        try
        {
            await EmpleadoService.SaveEmpleadoAsync(empleadoViewModel);

            showModal = false;
            showSuccessPopup = true;
            StateHasChanged();
            await Task.Delay(1500);
            showSuccessPopup = false;
            await OnClose.InvokeAsync();

            if (empleadoViewModel.Id > 0)
            {
                empleadoViewModel = await EmpleadoService.GetEmpleadoByIdAsync(empleadoViewModel.Id);
                pageTitle = $"Ficha de: {empleadoViewModel.Nombre} {empleadoViewModel.ApellidoPaterno}";

                // --- MODIFICADO ---
                RecargarListasDeCargos();

                // Recarga la lista de jefes por si este mismo empleado acaba de convertirse en uno
                supervisoresList = await EmpleadoService.GetSupervisoresAsync();

                imageCacheId = DateTime.Now.Ticks.ToString();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error guardando empleado");
            errorMessage = $"Ocurrió un error al guardar: {ex.Message}";
        }
        finally
        {
            // LIBERAR LA PANTALLA (Incluso si hay error)
            isBusy = false;
            StateHasChanged();
        }
    }

    private void PrepararSubida(ExpedienteViewModel exp)
    {
        expedienteParaSubir = exp;
        archivoSeleccionado = null;
        fileErrorMessage = "";
        tieneVencimiento = exp.FechaCaducidad.HasValue;
        fechaVencimientoInput = exp.FechaCaducidad ?? DateTime.Today;
    }

    private void CancelarSubida() { expedienteParaSubir = null; fileErrorMessage = ""; }

    private void HandleFileSelected(InputFileChangeEventArgs e)
    {
        fileErrorMessage = "";
        archivoSeleccionado = null;
        if (expedienteParaSubir == null) return;
        var file = e.File;
        long maxFileSize = 1024 * 1024 * 10;

        if (file.Size > maxFileSize)
        {
            fileErrorMessage = $"Archivo muy pesado (Límite 10MB)";
            return;
        }

        var ext = Path.GetExtension(file.Name).ToLower();
        string[] permitidas;
        string mensajeError;

        if (EsFoto(expedienteParaSubir))
        {
            // Si es la foto, permitimos imágenes
            permitidas = new[] { ".jpg", ".jpeg", ".png", ".webp", ".avif", ".heic", ".raw", ".tiff", ".bmp" };
            mensajeError = "Solo se aceptan imágenes (JPG, PNG).";
        }
        else
        {
            // Para todo lo demás, solo PDF
            permitidas = new[] { ".pdf" };
            mensajeError = "Para este documento solo se acepta PDF.";
        }
        // ----------------------------

        if (!permitidas.Contains(ext))
        {
            fileErrorMessage = $"Formato no permitido ({ext}). {mensajeError}";
            return;
        }

        archivoSeleccionado = file;
    }

    private async Task ConfirmarSubida()

    {

        if (expedienteParaSubir == null || archivoSeleccionado == null) return;



        // 2. ACTIVAR EL BLOQUEO

        isBusy = true;

        // Forzamos renderizado para que aparezca el spinner inmediatamente

        StateHasChanged();



        // Pequeña pausa para asegurar que la UI se actualice antes de empezar el proceso pesado

        await Task.Delay(500);



        try

        {

            using var stream = archivoSeleccionado.OpenReadStream(1024 * 1024 * 10);

            expedienteParaSubir.NombreArchivo = archivoSeleccionado.Name;

            expedienteParaSubir.FechaCaducidad = tieneVencimiento ? fechaVencimientoInput : null;



            await EmpleadoService.UpdateExpedienteConArchivoAsync(expedienteParaSubir, stream);

            CancelarSubida();

            expedientes = await EmpleadoService.GetExpedientesByEmpleadoIdAsync(empleadoViewModel.Id);

            CancelarSubida();



            expedientes = await EmpleadoService.GetExpedientesByEmpleadoIdAsync(empleadoViewModel.Id);



            // Agregamos esto para refrescar la imagen visualmente

            imageCacheId = DateTime.Now.Ticks.ToString();



            CancelarSubida();

        }

        catch (Exception ex)

        {

            Logger.LogError(ex, "Error subiendo archivo");

            fileErrorMessage = "Error al subir el archivo a la BD.";

        }

        finally

        {

            // 3. DESACTIVAR EL BLOQUEO (Siempre, aunque falle)

            isBusy = false;

            StateHasChanged();

        }

    }

    private async Task EliminarArchivo(ExpedienteViewModel exp)
    {
        if (exp.ExpId > 0)
        {
            await EmpleadoService.DeleteArchivoAsync(exp.ExpId);
            expedientes = await EmpleadoService.GetExpedientesByEmpleadoIdAsync(empleadoViewModel.Id);
        }
    }

    // Variable para forzar la recarga de la imagen si se actualiza
    private string imageCacheId = "";

    // Propiedad para obtener la URL de la foto
    private string UrlFotoPerfil
    {
        get
        {
            // Buscamos el expediente con DexId 13 (Foto) y que tenga un ID válido (ya subido)
            var foto = expedientes.FirstOrDefault(x => x.DexId == 13 && x.ExpId > 0);

            if (foto != null)
            {
                // Retornamos la ruta a tu API + un timestamp para evitar caché antiguo
                return $"/api/Archivo/{foto.ExpId}?t={imageCacheId}";
            }

            // Si no hay foto, retornamos null (o podrías retornar una ruta a una imagen default)
            return null;
        }
    }

    private void CalcularSalarios()
    {
        if (empleadoViewModel.SaeMensual.HasValue)
        {
            // Se divide el mensual entre 2 para la quincena
            empleadoViewModel.SaeQuincenal = Math.Round(empleadoViewModel.SaeMensual.Value / 2, 2);

            // Según tu regla de negocio: se divide el mensual entre 30 para el SDI
            empleadoViewModel.SaeSdi = Math.Round(empleadoViewModel.SaeMensual.Value / 30, 2);
        }
        else
        {
            empleadoViewModel.SaeQuincenal = null;
            empleadoViewModel.SaeSdi = null;
        }
    }



    private async Task CargarExpedientesOcultos()
    {
        expedientesOcultos = await EmpleadoService.GetExpedientesOcultosAsync(empleadoViewModel.Id);
    }

    private async Task OcultarDocumento(ExpedienteViewModel exp)
    {
        if (exp.DexId > 0)
        {
            isBusy = true;
            try
            {
                await EmpleadoService.OcultarDocumentoEstandarAsync(empleadoViewModel.Id, exp.DexId);
                expedientes = await EmpleadoService.GetExpedientesByEmpleadoIdAsync(empleadoViewModel.Id);
                await CargarExpedientesOcultos();
            }
            catch (Exception ex)
            {
                errorMessage = $"Error al ocultar documento: {ex.Message}";
            }
            finally
            {
                isBusy = false;
                StateHasChanged();
            }
        }
    }

    private async Task RestaurarDocumento(int dexId)
    {
        isBusy = true;
        try
        {
            await EmpleadoService.MostrarDocumentoEstandarAsync(empleadoViewModel.Id, dexId);
            expedientes = await EmpleadoService.GetExpedientesByEmpleadoIdAsync(empleadoViewModel.Id);
            await CargarExpedientesOcultos();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al restaurar documento: {ex.Message}";
        }
        finally
        {
            isBusy = false;
            StateHasChanged();
        }
    }
