    private void ToggleEditMode() => isEditable = true;

    // --- MODIFICADO: Propiedad para el Área Principal ---
    private string SelectedArea
    {
        get => empleadoViewModel.Area ?? string.Empty;
        set
        {
            if (empleadoViewModel.Area == value) return;

            empleadoViewModel.Area = value;
