@* 22Dic All class *@
@page "/Account/ForceChangePassword"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using RRHH_ARG.Data
@using RRHH_ARG.Components.Layout
@using RRHH_ARG.Components.Account

@layout LoginLayout

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityUserAccessor UserAccessor
@inject IdentityRedirectManager RedirectManager
@inject ILogger<ForceChangePassword> Logger

@* 1. INYECTAMOS TU SERVICIO DE MOODLE *@
@inject RRHH_ARG.Services.MoodleSyncService MoodleService

<PageTitle>Cambiar Contraseña</PageTitle>

<div class="d-flex justify-content-center align-items-center vh-100" style="background-color: #f4f6f9;">
    <div class="card shadow border-0" style="width: 100%; max-width: 350px; border-radius: 10px;">
        <div class="card-body p-4">
            <h4 class="text-center mb-2 fw-bold" style="color: #333;">Seguridad</h4>
            <p class="text-center text-muted mb-3" style="font-size: 0.8rem;">
                Es tu primer ingreso. Configura tu nueva contraseña personal.
            </p>

            @if (!string.IsNullOrEmpty(message))
            {
                <div class="alert alert-danger p-2 mb-3" role="alert" style="font-size: 0.8rem;">
                    @message
                </div>
            }

            <EditForm Model="Input" FormName="force-change-password" OnValidSubmit="OnValidSubmitAsync" method="post">
                <DataAnnotationsValidator />

                @* ... (TUS CAMPOS DE INPUT SIGUEN IGUAL AQUÍ) ... *@
                <div class="mb-3">
                    <label class="form-label small fw-bold text-secondary">Contraseña Actual</label>
                    <InputText type="password" id="oldPass" @bind-Value="Input.OldPassword" class="form-control form-control-sm" placeholder="Genérica actual" required />
                </div>
                <div class="mb-3">
                    <label class="form-label small fw-bold text-secondary">Nueva Contraseña</label>
                    <InputText type="password" id="newPass" @bind-Value="Input.NewPassword" class="form-control form-control-sm" placeholder="Mínimo 6 caracteres" required minlength="6" />
                </div>
                <div class="mb-1">
                    <label class="form-label small fw-bold text-secondary">Confirmar Nueva</label>
                    <InputText type="password" id="confirmPass" @bind-Value="Input.ConfirmPassword" class="form-control form-control-sm" placeholder="Repite la nueva" required minlength="6" />
                    <ValidationMessage For="() => Input.ConfirmPassword" class="text-danger small" style="font-size: 0.75rem;" />
                </div>

                <div class="form-check mb-4">
                    <input class="form-check-input" type="checkbox" id="showPassCheck" onclick="togglePasswords()">
                    <label class="form-check-label text-muted" for="showPassCheck" style="font-size: 0.8rem; cursor: pointer;">
                        Ver contraseñas
                    </label>
                </div>

                <div class="d-grid">
                    @* AGREGAMOS FEEDBACK VISUAL DE CARGA *@
                    <button type="submit" class="btn btn-primary btn-sm fw-bold py-2" disabled="@_isProcesando">
                        @if (_isProcesando)
                        {
                            <span>Sincronizando...</span>
                        }
                        else
                        {
                            <span>Guardar y Entrar</span>
                        }
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

<script>
    function togglePasswords() {
        var ids = ["oldPass", "newPass", "confirmPass"];
        var checkbox = document.getElementById("showPassCheck");
        ids.forEach(function(id) {
            var input = document.getElementById(id);
            if (input) { input.type = checkbox.checked ? "text" : "password"; }
        });
    }
</script>

@code {
    private string? message;
    private bool _isProcesando = false; // Para evitar doble clic
    private ApplicationUser user = default!;

    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    [SupplyParameterFromForm] private InputModel Input { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        user = await UserAccessor.GetRequiredUserAsync(HttpContext);
    }

    private async Task OnValidSubmitAsync()
    {
        _isProcesando = true;
        message = null;

        // 1. CAMBIAR EN .NET (IDENTITY)
        var changePasswordResult = await UserManager.ChangePasswordAsync(user, Input.OldPassword, Input.NewPassword);

        if (!changePasswordResult.Succeeded)
        {
            message = string.Join(" ", changePasswordResult.Errors.Select(error => error.Description));
            _isProcesando = false;
            return;
        }

        // 2. SI FUE EXITOSO EN .NET -> CAMBIAR EN MOODLE
        try
        {
            // Usamos el email del usuario para buscarlo en Moodle
            await MoodleService.UpdatePasswordMoodleAsync(user.Email, Input.NewPassword);
            Logger.LogInformation("Contraseña sincronizada con Moodle correctamente.");
        }
        catch (Exception ex)
        {
            // OJO: Si falla Moodle, ¿Qué hacemos?
            // Opción A: No dejarlo pasar (Estricto) -> Pero ya cambiamos la local, se desincroniza.
            // Opción B (Recomendada): Loguear error, dejarlo pasar, y avisar a soporte.
            Logger.LogError($"Error sincronizando password en Moodle: {ex.Message}");
            // No mostramos error al usuario para no bloquear su acceso al sistema principal
        }

        // 3. ACTUALIZAR ESTADO DE PRIMER INGRESO
        user.EsPrimerIngreso = false;
        var updateResult = await UserManager.UpdateAsync(user);

        if (!updateResult.Succeeded)
        {
            message = "Error al actualizar estado del usuario.";
            _isProcesando = false;
            return;
        }

        // 4. REFRESCA SESIÓN
        await SignInManager.RefreshSignInAsync(user);
        RedirectManager.RedirectTo("/Inicio");
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Falta contraseña actual")]
        [DataType(DataType.Password)]
        public string OldPassword { get; set; } = "";

        [Required(ErrorMessage = "Falta nueva contraseña")]
        [StringLength(100, ErrorMessage = "Mínimo {2} caracteres", MinimumLength = 6)]
        [DataType(DataType.Password)]
        public string NewPassword { get; set; } = "";

        [DataType(DataType.Password)]
        [Compare("NewPassword", ErrorMessage = "Las contraseñas no coinciden")]
        public string ConfirmPassword { get; set; } = "";
    }
}