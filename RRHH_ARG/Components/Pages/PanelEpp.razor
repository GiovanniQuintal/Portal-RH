@page "/panel-epp"
@using RRHH_ARG.Models
@using RRHH_ARG.Data
@inject EmpleadoService Service
@inject IJSRuntime JS
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "RH, HSE")]

<div class="container-fluid">
    <h3>Administración de Entrega de EPP</h3>
    
    <div class="d-flex justify-content-end mb-3">
        <button class="btn btn-primary" @onclick="AbrirModalCrear">
            <i class="bi bi-plus-circle"></i> Nueva Entrega
        </button>
    </div>

    @if (isLoading)
    {
        <div class="text-center">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
        </div>
    }
    else
    {
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Fecha Entrega</th>
                    <th>Empleado</th>
                    <th>EPPs Entregados</th>
                    <th>Cantidades</th>
                    <th>Evidencia</th>
                    <th style="width: 200px;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (listaEntregas == null || !listaEntregas.Any())
                {
                    <tr><td colspan="6" class="text-center">No hay registros.</td></tr>
                }
                else
                {
                    @foreach (var item in listaEntregas)
                    {
                        <tr>
                            <td>@item.Fecha.ToString("dd/MM/yyyy")</td>
                            <td>@item.NombreEmpleado</td>
                            <td>
                                @foreach (var epp in item.ListaEpps.Split(',', StringSplitOptions.RemoveEmptyEntries))
                                {
                                    <span class="badge bg-warning text-dark me-1">@epp.Trim()</span>//MODIFICADO DIC 18
                                }
                            </td>
                            <td>@item.ListaCantidades</td>
                            <td>
                                @if (item.TieneEvidencia)
                                {
                                    <a href="api/Archivo/EntregaEpp/@item.EntId" target="_blank" 
                                       class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-file-earmark-pdf"></i> Ver PDF
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">Sin archivo</span>
                                }
                            </td>
                            <td>
                                <button class="btn btn-sm btn-info me-1" 
                                        @onclick="() => AbrirModalVer(item.EntId)"
                                        title="Ver detalles">
                                    <i class="bi bi-eye"></i>
                                </button>
                                <button class="btn btn-sm btn-warning me-1" 
                                        @onclick="() => AbrirModalEditar(item.EntId)"
                                        title="Editar">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button class="btn btn-sm btn-danger" 
                                        @onclick="() => ConfirmarEliminar(item.EntId)"
                                        title="Eliminar">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    }
</div>

<!-- MODAL CREAR/EDITAR -->
@if (mostrarModal)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">
                        @(modoEdicion ? "Editar Entrega de EPP" : "Registrar Entrega de EPP")
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CerrarModal"></button>
                </div>
                <div class="modal-body">
                    @if (isProcessing)
                    {
                        <div class="text-center p-5">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Guardando...</span>
                            </div>
                            <p class="mt-3">Guardando entrega, por favor espere...</p>
                        </div>
                    }
                    else
                    {
                        <EditForm Model="nuevoModel" OnValidSubmit="GuardarEntrega">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">Fecha de Entrega</label>
                                    <InputDate @bind-Value="nuevoModel.Fecha" class="form-control" />
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">Área</label>
                                    <select class="form-select" value="@nuevoModel.AreaSeleccionadaId"
                                            @onchange="CargarEmpleadosPorArea">

                                        <option value="0">-- Seleccione Área --</option>
                                        @foreach (var area in listaAreas)
                                        {
                                            <option value="@area.AreId">@area.AreNombre</option>
                                        }
                                    </select>
                                </div>
                                
                                <div class="col-md-12 mb-3">
                                    <label class="form-label fw-bold">Empleado</label>
                                    <select class="form-select" @bind="nuevoModel.EmpleadoId" 
                                            disabled="@(!empleadosDelArea.Any())">
                                        <option value="0">-- Seleccione Empleado --</option>
                                        @foreach (var emp in empleadosDelArea)
                                        {
                                            <option value="@emp.Id">@emp.Nombre @emp.ApellidoPaterno @(emp.ApellidoMaterno ?? "")</option> //MODIFICADO DIC 17
                                        }
                                    </select>
                                </div>
                                
                                <div class="col-md-12 mb-3">@*MODIFICADO DIC 19*@
                                    <label class="form-label fw-bold">Seleccione los EPPs entregados:</label>
                                    <div class="card p-3" style="max-height: 250px; overflow-y: auto;">
                                        @foreach (var epp in nuevoModel.EppsSeleccionados)
                                        {
                                            <div class="card mb-2 border-light shadow-sm">
                                                <div class="card-body p-2">
                                                    <div class="form-check mb-2">
                                                        <input class="form-check-input" type="checkbox" 
                                                               @bind="epp.IsSelected" 
                                                               id="epp_@epp.TepId">
                                                        <label class="form-check-label fw-bold" for="epp_@epp.TepId">
                                                            @epp.Nombre
                                                        </label>
                                                    </div>

                                                    @if (epp.IsSelected)
                                                    {
                                                        <div class="row g-2 bg-light p-2 rounded border">
                                                            <div class="col-3">
                                                                <label class="form-label small text-muted mb-0">Cant.</label>
                                                                <input type="number" class="form-control form-control-sm" 
                                                                       @bind="epp.Cantidad" min="1" max="99" />
                                                            </div>

                                                            <div class="col-5">
                                                                <label class="form-label small text-muted mb-0">Talla/Modelo</label>
                                                                <input type="text" class="form-control form-control-sm" 
                                                                       placeholder="Ej. M / 3M"
                                                                       @bind="epp.TallaModelo" />
                                                            </div>

                                                            <div class="col-4">
                                                                <label class="form-label small text-muted mb-0">Estado</label>
                                                                <select class="form-select form-select-sm" 
                                                                        value="@(epp.EsNuevo.ToString().ToLower())"
                                                                        @onchange="@(e => epp.EsNuevo = bool.Parse(e.Value.ToString()))">
                                                                    <option value="true">Nuevo</option>
                                                                    <option value="false">Usado</option>
                                                                </select>
                                                            </div>

                                                            <div class="col-12 pt-1">
                                                                <div class="form-check form-switch">
                                                                    <input class="form-check-input" type="checkbox" id="dev_@epp.TepId" 
                                                                           @bind="epp.DevolvioAnterior">
                                                                    <label class="form-check-label small" for="dev_@epp.TepId">
                                                                        ¿Devolvió el EPP anterior?
                                                                    </label>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                                
                                <div class="col-md-12 mb-3">
                                    <label class="form-label fw-bold">
                                        Evidencia Firmada (PDF) 
                                        @if (modoEdicion && nuevoModel.TieneEvidencia)
                                        {
                                            <span class="text-muted small">- Actual: 
                                                <a href="api/Archivo/EntregaEpp/@nuevoModel.EntId" target="_blank">
                                                    Ver archivo actual
                                                </a>
                                            </span>
                                        }
                                    </label>
                                    <InputFile OnChange="HandleFileSelected" 
                                               class="form-control" 
                                               accept=".pdf" />
                                    @if (!string.IsNullOrEmpty(archivoSeleccionado))
                                    {
                                        <small class="text-success">
                                            <i class="bi bi-check-circle"></i> @archivoSeleccionado
                                        </small>
                                    }
                                    @if (modoEdicion)
                                    {
                                        <small class="text-muted d-block mt-1">
                                            <i class="bi bi-info-circle"></i> Deja vacío si no deseas cambiar el archivo
                                        </small>
                                    }
                                </div>
                            </div>
                            
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" 
                                        @onclick="CerrarModal">Cancelar</button>
                                <button type="submit" class="btn btn-success">
                                    <i class="bi bi-save"></i> @(modoEdicion ? "Actualizar" : "Guardar") Entrega
                                </button>
                            </div>
                        </EditForm>
                    }
                </div>
            </div>
        </div>
    </div>
}

<!-- MODAL VER (SOLO LECTURA) -->
@if (mostrarModalVer)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-info text-white">
                    <h5 class="modal-title">
                        <i class="bi bi-eye"></i> Detalle de Entrega de EPP
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CerrarModalVer"></button>
                </div>
                <div class="modal-body">
                    @if (modeloVer == null)
                    {
                        <div class="text-center p-3">
                            <div class="spinner-border" role="status">
                                <span class="visually-hidden">Cargando...</span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Fecha de Entrega:</label>
                                <p class="form-control-plaintext">@modeloVer.Fecha.ToString("dd/MM/yyyy")</p>
                            </div>
                            
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Empleado:</label>
                                <p class="form-control-plaintext">@modeloVer.NombreEmpleado</p>
                            </div>
                            
                            <div class="col-md-12 mb-3">
                                <label class="form-label fw-bold">EPPs Entregados:</label>
                                <div class="card p-3 bg-light">
                                    <table class="table table-sm table-borderless mb-0">
                                        <thead>
                                            <tr>
                                                <th>Equipo de Protección</th>
                                                <th class="text-end">Cantidad</th>
                                            </tr>
                                        </thead>
                                        <tbody>@*MODIFICADO DIC 19*@
                                            @foreach (var epp in modeloVer.EppsSeleccionados.Where(e => e.IsSelected))
                                            {
                                                <tr>
                                                    <td><i class="bi bi-shield-check text-success"></i> @epp.Nombre</td>
                                                    <td class="text-center">@epp.Cantidad</td>
                                                    <td>@(string.IsNullOrEmpty(epp.TallaModelo) ? "-" : epp.TallaModelo)</td>
                                                    <td class="text-center">
                                                        <span class="badge @(epp.EsNuevo ? "bg-success" : "bg-warning text-dark")">
                                                            @(epp.EsNuevo ? "Nuevo" : "Usado")
                                                        </span>
                                                    </td>
                                                    <td class="text-center">
                                                        @if (epp.DevolvioAnterior)
                                                        {
                                                            <i class="bi bi-check-circle-fill text-primary" title="Sí devolvió"></i>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted">-</span>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                            
                            <div class="col-md-12 mb-3">
                                <label class="form-label fw-bold">Evidencia Firmada:</label>
                                @if (modeloVer.TieneEvidencia)
                                {
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="bi bi-file-earmark-pdf text-danger fs-3"></i>
                                        <a href="api/Archivo/EntregaEpp/@modeloVer.EntId" 
                                           target="_blank" 
                                           class="btn btn-outline-danger">
                                            <i class="bi bi-download"></i> Descargar PDF
                                        </a>
                                    </div>
                                }
                                else
                                {
                                    <p class="text-muted">
                                        <i class="bi bi-x-circle"></i> No hay evidencia adjunta
                                    </p>
                                }
                            </div>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CerrarModalVer">
                        Cerrar
                    </button>
                    <button type="button" class="btn btn-warning" 
                            @onclick="() => ConvertirVerAEditar()">
                        <i class="bi bi-pencil"></i> Editar
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<EntregaEppViewModel> listaEntregas = new();
    private List<Area> listaAreas = new();
    private List<EmpleadoViewModel> empleadosDelArea = new();
    
    private bool mostrarModal = false;
    private bool mostrarModalVer = false;
    private bool isLoading = true;
    private bool isProcessing = false;
    private bool modoEdicion = false;
    
    private EntregaEppViewModel nuevoModel = new();
    private EntregaEppViewModel? modeloVer = null;
    private string? archivoSeleccionado;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await CargarDatos();
            listaAreas = await Service.GetAreasAsync();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Error al cargar datos: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task CargarDatos()
    {
        listaEntregas = await Service.GetEntregasEppAsync();
    }

    // ============================================
    // MODAL CREAR
    // ============================================
    private async Task AbrirModalCrear()
    {
        modoEdicion = false;
        nuevoModel = new EntregaEppViewModel();
        nuevoModel.EppsSeleccionados = await Service.GetCatalogoEppParaSeleccionAsync();
        empleadosDelArea.Clear();
        archivoSeleccionado = null;
        mostrarModal = true;
    }

    // ============================================
    // MODAL VER (SOLO LECTURA)
    // ============================================
    private async Task AbrirModalVer(int entId)
    {
        modeloVer = null;
        mostrarModalVer = true;
        
        try
        {
            modeloVer = await Service.GetEntregaEppByIdAsync(entId);
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Error al cargar: {ex.Message}");
            CerrarModalVer();
        }
    }

    private void CerrarModalVer()
    {
        mostrarModalVer = false;
        modeloVer = null;
    }

    // Convertir modal Ver en Editar (botón dentro del modal Ver)
    private async Task ConvertirVerAEditar()
    {
        if (modeloVer == null) return;

        // 1. Guardamos el ID antes de que modeloVer sea destruido
        int idParaEditar = modeloVer.EntId;

        // 2. Cerramos el modal (esto hace modeloVer = null)
        CerrarModalVer();

        // 3. Abrimos el editor usando la variable temporal
        await AbrirModalEditar(idParaEditar);
    }

    // ============================================
    // MODAL EDITAR
    // ============================================
    private async Task AbrirModalEditar(int entId)
    {
        modoEdicion = true;
        
        try
        {
            // Cargar el registro completo
            nuevoModel = await Service.GetEntregaEppByIdAsync(entId);
            
            // Cargar catálogos
            listaAreas = await Service.GetAreasAsync();
            
            // Si tenemos área, cargar empleados de esa área
            if (nuevoModel.AreaSeleccionadaId > 0)
            {
                empleadosDelArea = await Service.GetEmpleadosPorAreaIdAsync(nuevoModel.AreaSeleccionadaId);
            }
            
            archivoSeleccionado = null;
            mostrarModal = true;
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Error al cargar registro: {ex.Message}");
        }
    }

    private void CerrarModal()
    {
        mostrarModal = false;
        nuevoModel = new();
        archivoSeleccionado = null;
        modoEdicion = false;
    }

    // ============================================
    // FUNCIONES COMPARTIDAS
    // ============================================
    private async Task CargarEmpleadosPorArea(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int areaId) && areaId > 0)
        {
            nuevoModel.AreaSeleccionadaId = areaId;
            empleadosDelArea = await Service.GetEmpleadosPorAreaIdAsync(areaId);
        }
        else
        {
            empleadosDelArea.Clear();
        }
        
        nuevoModel.EmpleadoId = 0;
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        try
        {
            long maxFileSize = 1024 * 1024 * 20;
            
            if (file.Size > maxFileSize)
            {
                await JS.InvokeVoidAsync("alert", "El archivo es demasiado grande. Máximo 20 MB.");
                return;
            }

            using var stream = file.OpenReadStream(maxAllowedSize: maxFileSize);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            
            nuevoModel.EvidenciaBytes = ms.ToArray();
            nuevoModel.NombreArchivo = file.Name;
            archivoSeleccionado = file.Name;
            
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Error al cargar archivo: {ex.Message}");
            nuevoModel.EvidenciaBytes = null;
            archivoSeleccionado = null;
        }
    }

    private async Task GuardarEntrega()
    {
        // 1. Validar Empleado
        if (nuevoModel.EmpleadoId == 0)
        {
            await JS.InvokeVoidAsync("alert", "Debe seleccionar un empleado.");
            return;
        }

        // 2. Validar que haya EPPs seleccionados
        if (!nuevoModel.EppsSeleccionados.Any(x => x.IsSelected))
        {
            await JS.InvokeVoidAsync("alert", "Debe seleccionar al menos un EPP.");
            return;
        }

        // =========================================================
        // 3. NUEVA VALIDACIÓN: EL ARCHIVO ES OBLIGATORIO AL CREAR
        // =========================================================
        if (!modoEdicion && (nuevoModel.EvidenciaBytes == null || nuevoModel.EvidenciaBytes.Length == 0))
        {
            await JS.InvokeVoidAsync("alert", "Debe subir el archivo de Evidencia Firmada (PDF) para guardar.");
            return;
        }
        // =========================================================

        isProcessing = true;
        StateHasChanged();

        try
        {
            await Service.SaveEntregaEppAsync(nuevoModel);
            await CargarDatos();
            CerrarModal();

            string mensaje = modoEdicion ? "✓ Entrega actualizada correctamente." : "✓ Entrega registrada correctamente.";
            await JS.InvokeVoidAsync("alert", mensaje);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"ERROR COMPLETO: {ex}");
            // Muestra un mensaje más amigable si es el error de SQL específico
            if (ex.InnerException?.Message.Contains("Cannot insert the value NULL") == true)
            {
                await JS.InvokeVoidAsync("alert", "Error de Base de Datos: La evidencia es obligatoria y no se recibió.");
            }
            else
            {
                await JS.InvokeVoidAsync("alert", $"Error al guardar: {ex.Message}");
            }
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task ConfirmarEliminar(int id)
    {
        bool confirmado = await JS.InvokeAsync<bool>("confirm", 
            "¿Eliminar este registro? Se borrará la evidencia y los detalles.");
        
        if (!confirmado) return;

        try
        {
            await Service.DeleteEntregaEppAsync(id);
            await CargarDatos();
            await JS.InvokeVoidAsync("alert", "✓ Registro eliminado.");
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Error al eliminar: {ex.Message}");
        }
    }
}