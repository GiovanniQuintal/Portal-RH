        "#C82A54", // Guinda/Rosa oscuro

        "#8C4966"  // Morado tenue/Marrón

    };

    // --- ESTADO COLAPSABLES (Indicadores) ---
    private HashSet<int> expandedIndicators = new();

    private void ToggleIndicator(int indicatorId)
    {
        if (expandedIndicators.Contains(indicatorId))
        {
            expandedIndicators.Remove(indicatorId);
        }
        else
        {
            expandedIndicators.Add(indicatorId);
        }
    }


    // --- ESTADO GENERAL ---

    private List<EmpleadoViewModel> subordinados = new();

    private bool isLoadingList = true;

    private int selectedEmpId = 0;

    private EmpleadoViewModel? selectedEmpleado;

    private string activeTab = "priorities";



    // --- ESTADO PD (Priorities) ---

    private List<PdPriority> prioritiesList = new();

    private bool showArchivedPriorities = false;

    private bool showPriorityModal = false;

    private PdPriority editingPriority = new();



    // --- ESTADO PD (Touchpoints) ---

    private List<PdTouchpoint> touchpointsList = new();

    private bool showTouchpointModal = false;

    private PdTouchpoint editingTouchpoint = new();



    // URL Foto para la cabecera (Header)

    private string UrlFotoPerfil => $"/api/Archivo/{selectedEmpleado?.Id}/Foto";



    private int selectedGoalIdModal = 0;

    private List<PdIndicator> availableIndicators = new();



    private List<PdGlobalGoal> globalGoalsList = new();



    // Variable nueva para manejar los items temporales del modal

    private List<PdTouchpointItem> touchpointItemsList = new();



    private bool isRevisionExpired = false;

    private string errorMessage = "";

    private bool showSuccessPopup = false;

    private bool showSuccessMessage = false;



    private PdYearConfig? currentYearConfig;

    private bool showConfirmModal = false;



 private bool isPrinting = false;

 private EmpleadoViewModel? empleadoActual;

 private string nombreDeLogin = "Usuario";



    private async Task NewTouchpoint()

    {

        touchpointItemsList = new List<PdTouchpointItem>();

        editingTouchpoint = new PdTouchpoint();

        isRevisionExpired = false;



        var activeRevision = await PdService.GetActiveRevisionAsync();



        if (activeRevision == null)

        {

            errorMessage = "⛔ ACCESO DENEGADO: No existe una etapa de revisión activa en este momento (Según calendario RH).";

            showSuccessPopup = false;

            StateHasChanged();

            return;

        }



        int revNum = activeRevision.RevisionNumber;

        var existing = await PdService.GetTouchpointWithDetailsAsync(selectedEmpId, revNum);



        if (existing != null)

        {

            editingTouchpoint = existing;

            touchpointItemsList = existing.Items.ToList();

        }

        else

        {

            int supervisorIdReal = 0;

            var authState = await AuthStateProvider.GetAuthenticationStateAsync();

            var userId = authState.User.FindFirst(c => c.Type.Contains("nameidentifier"))?.Value;

            if (!string.IsNullOrEmpty(userId)) supervisorIdReal = await EmpleadoService.GetEmpleadoIdByUserIdAsync(userId);



            editingTouchpoint = new PdTouchpoint

            {

                EmpId = selectedEmpId,

                RevisionNumber = revNum,

                Date = DateTime.Now,

                SupervisorId = supervisorIdReal,

                IsApproved = false

            };



            foreach (var p in prioritiesList.Where(x => x.IsApproved && !x.IsArchived))

            {

                touchpointItemsList.Add(new PdTouchpointItem

                {

                    PriorityId = p.Id,

                    RegisteredValue = p.ActualValue,

                    Feedback = ""

                });

            }

        }



        showTouchpointModal = true;

    }



    private async Task EditTouchpoint(PdTouchpoint t)

    {

        var fullTouchpoint = await PdService.GetTouchpointWithDetailsAsync(t.EmpId, t.RevisionNumber);



        if (fullTouchpoint != null)

        {

            editingTouchpoint = fullTouchpoint;

            touchpointItemsList = fullTouchpoint.Items.ToList();



            var configYear = await PdService.GetCurrentYearConfigAsync(t.Date.Year);

            var revisionDate = configYear?.RevisionDates.FirstOrDefault(r => r.RevisionNumber == t.RevisionNumber);



            if (revisionDate != null)

            {

                isRevisionExpired = DateTime.Today > revisionDate.EndDate.Date || revisionDate.IsLockedByRH;

            }

            else

            {

                isRevisionExpired = false;

            }



            showTouchpointModal = true;

        }

    }



    private async Task SaveTouchpoint()

    {

        bool isFinal = currentYearConfig != null && editingTouchpoint.RevisionNumber == currentYearConfig.RevisionCount;

        await PdService.SaveTouchpointFullAsync(editingTouchpoint, touchpointItemsList, isFinal);



        showTouchpointModal = false;

        await ReloadPriorities();

        await ReloadTouchpoints();

    }



    private async Task ApprovePriority(int id)

    {

        await PdService.ApprovePriorityAsync(id, true);

        await ReloadPriorities();

    }



    protected override async Task OnInitializedAsync()

    {

        await CargarSubordinados();

    }



    private async Task CargarSubordinados()

    {

        isLoadingList = true;

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();

        var user = authState.User;



        if (user.Identity != null && user.Identity.IsAuthenticated)

        {

            nombreDeLogin = user.Identity.Name ?? "Usuario";

        }



        var userId = user.FindFirst(c => c.Type.Contains("nameidentifier"))?.Value;



        if (!string.IsNullOrEmpty(userId))

        {

            int miId = await EmpleadoService.GetEmpleadoIdByUserIdAsync(userId);

            if (miId > 0)

            {

                empleadoActual = await EmpleadoService.GetEmpleadoByIdAsync(miId);



                var listaRaw = await EmpleadoService.GetSubordinadosCompletosAsync(miId);

                subordinados = listaRaw

                                .OrderBy(e => e.ApellidoPaterno)

                                .ThenBy(e => e.Nombre)

                                .ToList();

            }

        }

        isLoadingList = false;

    }



    private async Task ImprimirReporte()

    {

        isPrinting = true;

        StateHasChanged();



        await Task.Delay(300);



        await JS.InvokeVoidAsync("descargarPDF", "ReporteEquipo-pdf", $"KPIs_{selectedEmpleado?.Nombre}.pdf", "landscape");



        isPrinting = false;

        StateHasChanged();

    }



    private async Task SelectEmpleado(int empId)

    {

        selectedEmpId = empId;

        

        // 1. Ejecutamos las consultas una por una en lugar de lanzarlas todas juntas

        selectedEmpleado = await EmpleadoService.GetEmpleadoByIdAsync(empId);

        currentYearConfig = await PdService.GetCurrentYearConfigAsync(DateTime.Now.Year);

var rawGoals = await PdService.GetGlobalGoalsAsync(DateTime.Now.Year);
globalGoalsList = rawGoals.OrderBy(g => g.Id).ToList();


        activeTab = "priorities";

        
        // Reiniciamos el estado de los colapsables para el nuevo empleado
        expandedIndicators.Clear();

        // 2. Quitamos el Task.WhenAll y usamos await secuencial

        await ReloadPriorities();

        await ReloadTouchpoints();

    }



    private async Task OpenTouchpointByRevision(int revisionNumber, bool forceReadOnly)

    {

        touchpointItemsList = new List<PdTouchpointItem>();

        editingTouchpoint = new PdTouchpoint();



        var revisionConfig = currentYearConfig?.RevisionDates.FirstOrDefault(r => r.RevisionNumber == revisionNumber);



        bool isDateExpired = revisionConfig != null && DateTime.Today > revisionConfig.EndDate;

        bool isDateFuture = revisionConfig != null && DateTime.Today < revisionConfig.StartDate;



        var existing = await PdService.GetTouchpointWithDetailsAsync(selectedEmpId, revisionNumber);



        if (existing != null)

        {

            editingTouchpoint = existing;

            touchpointItemsList = existing.Items.ToList();

            isRevisionExpired = existing.IsApproved || isDateExpired;

        }

        else

        {

            if (isDateExpired)

            {

                isRevisionExpired = true;

                errorMessage = "El periodo para esta revisión ha finalizado. No es posible iniciarla.";

            }

            else if (isDateFuture)

            {

                errorMessage = "Esta revisión aún no está disponible.";

                showSuccessPopup = false;

                return;

            }

            else

            {

                isRevisionExpired = false;

            }



            int supervisorIdReal = 0;

            var authState = await AuthStateProvider.GetAuthenticationStateAsync();

            var userId = authState.User.FindFirst(c => c.Type.Contains("nameidentifier"))?.Value;

            if (!string.IsNullOrEmpty(userId)) supervisorIdReal = await EmpleadoService.GetEmpleadoIdByUserIdAsync(userId);



            editingTouchpoint = new PdTouchpoint

            {

                EmpId = selectedEmpId,

                RevisionNumber = revisionNumber,

                Date = DateTime.Now,

                SupervisorId = supervisorIdReal,

                IsApproved = false

            };



            foreach (var p in prioritiesList.Where(x => x.IsApproved && !x.IsArchived))

            {

                touchpointItemsList.Add(new PdTouchpointItem

                    {

                        PriorityId = p.Id,

                        RegisteredValue = p.ActualValue,

                        Feedback = ""

                    });

            }



        }

        if (forceReadOnly) isRevisionExpired = true;

        showTouchpointModal = true;

    }



    private async Task ReloadPriorities()

    {

        if (selectedEmpId == 0) return;

        prioritiesList = await PdService.GetPrioritiesAsync(selectedEmpId, DateTime.Now.Year, showArchivedPriorities);

    }



    private void NewPriority()

    {

        isRevisionExpired = false;

        editingPriority = new PdPriority { EmpId = selectedEmpId, Year = DateTime.Now.Year };

        showPriorityModal = true;

    }



    private async Task EditPriority(PdPriority p)

    {

        editingPriority = new PdPriority

        {

            Id = p.Id,

            EmpId = p.EmpId,

            Title = p.Title,

            Description = p.Description,

            Category = p.Category,

            IndicatorId = p.IndicatorId,

            TrackingType = p.TrackingType ?? "MHB",

            TargetValue = p.TargetValue,

            ActualValue = p.ActualValue,

            UnitOfMeasure = p.UnitOfMeasure,

            Notes = p.Notes,

            Year = p.Year,

            IsArchived = p.IsArchived,

            IsSubmitted = p.IsSubmitted,

            IsApproved = p.IsApproved,

            ReadyForReview = p.ReadyForReview

        };



        if (p.Indicator != null)

        {

            selectedGoalIdModal = p.Indicator.GlobalGoalId;

            availableIndicators = await PdService.GetIndicatorsByGoalAsync(selectedGoalIdModal);

        }

        else

        {

            selectedGoalIdModal = 0;

            availableIndicators.Clear();

        }



        showPriorityModal = true;

    }



    private async Task SavePriority()

    {

         if (!ValidatePriorityData()) return;



        await PdService.SavePriorityAsync(editingPriority);



        showPriorityModal = false;

        await ReloadPriorities();



        showSuccessMessage = true;

        StateHasChanged();

        await Task.Delay(3000);

        showSuccessMessage = false;

        StateHasChanged();

    }



    private async Task ArchivePriority(int id)

    {

        await PdService.ToggleArchivePriorityAsync(id);

        await ReloadPriorities();

    }



    private async Task ReloadTouchpoints()

    {

        if (selectedEmpId == 0) return;

        touchpointsList = await PdService.GetTouchpointsAsync(selectedEmpId);

    }



    private async Task ApproveTouchpoint()

    {

        if (editingTouchpoint.Id == 0) await PdService.SaveTouchpointAsync(editingTouchpoint);



        await PdService.ApproveTouchpointAsync(editingTouchpoint.Id);

        showTouchpointModal = false;

        await ReloadTouchpoints();

    }



    private async Task ToggleReady(int id, bool ready)

    {

        await PdService.TogglePriorityReadyAsync(id, ready);



        var p = prioritiesList.FirstOrDefault(x => x.Id == id);

        if (p != null) p.ReadyForReview = ready;

    }



    private async Task SaveTouchpointDataOnly()

    {

        bool isFinal = currentYearConfig != null && editingTouchpoint.RevisionNumber == currentYearConfig.RevisionCount;

        await PdService.SaveTouchpointFullAsync(editingTouchpoint, touchpointItemsList, isFinal);

        await ReloadPriorities();

    }



    private async Task FinalizeTouchpoint()

    {

        bool isFinal = currentYearConfig != null && editingTouchpoint.RevisionNumber == currentYearConfig.RevisionCount;



        await PdService.SaveTouchpointFullAsync(editingTouchpoint, touchpointItemsList, isFinal);

        await PdService.ApproveTouchpointAsync(editingTouchpoint.Id);



        showTouchpointModal = false;

