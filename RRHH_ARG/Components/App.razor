    <script>
        function downloadBase64File(fileName, mimeType, base64String) {
            const link = document.createElement('a');
            link.href = `data:${mimeType};base64,${base64String}`;
            link.download = fileName;
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }
    </script>

    <script>
        window.obtenerAnchoContenedor = (idElemento) => {
            var elemento = document.getElementById(idElemento);
            return elemento ? elemento.clientWidth : 0;
        };
    </script>

    <script>
    window.lanzarConfetiGlobal = function () {
        var canvas = document.createElement('canvas');
        canvas.style.position = 'fixed';
        canvas.style.top = '0';
        canvas.style.left = '0';
        canvas.style.width = '100vw';
        canvas.style.height = '100vh';
        canvas.style.pointerEvents = 'none';
        canvas.style.zIndex = '99999';
        document.body.appendChild(canvas);

        var myConfetti = confetti.create(canvas, {
            resize: true,
            useWorker: true // Usa un hilo separado para no trabar la app móvil
        });

        // La lluvia durará 3.5 segundos
        var duration = 1500;
        var end = Date.now() + duration;

        (function frame() {
            // Cae una cantidad moderada (10 partículas por frame) 
            // desde una posición X aleatoria (de izquierda a derecha)
            myConfetti({
                particleCount: 10,
                startVelocity: 30, // Velocidad de caída
                spread: 360,
                origin: {
                    x: Math.random(), // Repartido por todo el ancho
                    y: -0.1           // Cae desde un poquito más arriba del borde
                },
                colors: ['#253C60', '#0d6efd', '#FF9500', '#ffffff'] // Tus colores
            });

            // Continuar la animación hasta que se acabe el tiempo
            if (Date.now() < end) {
                requestAnimationFrame(frame);
            } else {
                // Borrar el canvas unos segundos después para que terminen de caer
                setTimeout(function() {
                    if(document.body.contains(canvas)) {
                        document.body.removeChild(canvas);
                    }
                }, 5000);
            }
        }());
    };
    </script>

    <script>
        window.descargarPDF = function (elementoId, nombreArchivo, orientacion = 'portrait') {
            var elemento = document.getElementById(elementoId);
            var opciones = {
                margin:       15,
                filename:     nombreArchivo,
                image:        { type: 'jpeg', quality: 0.98 },
                html2canvas:  { scale: 2 },
                jsPDF:        { unit: 'mm', format: 'a4', orientation: orientacion }
            };
            html2pdf().set(opciones).from(elemento).save();
        };
    </script>

    <script>
        window.descargarArchivoBase64 = function (filename, base64String, contentType) {
            var link = document.createElement('a');
            link.download = filename;
            link.href = 'data:' + contentType + ';base64,' + base64String;
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }
    </script>
